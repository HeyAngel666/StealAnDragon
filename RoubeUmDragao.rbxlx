      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">RarityStyle</string>
          <string name="Source"><![CDATA[-- Cores em degradê para os textos de raridade (placas e interface).
-- Gradientes marcados com a tag "SpinGradient" giram no cliente (Divino/Secreto).

local CollectionService = game:GetService("CollectionService")

local RarityStyle = {}

local function seq(...)
	local colors = { ... }
	local points = {}
	for i, c in ipairs(colors) do
		table.insert(points, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c))
	end
	return ColorSequence.new(points)
end

local rgb = Color3.fromRGB

RarityStyle.Gradients = {
	Comum = seq(rgb(255, 255, 255), rgb(180, 180, 190)),
	Incomum = seq(rgb(170, 255, 140), rgb(50, 200, 80)),
	Raro = seq(rgb(140, 220, 255), rgb(40, 110, 255)),
	Epico = seq(rgb(240, 150, 255), rgb(140, 50, 255)),
	Lendario = seq(rgb(255, 250, 150), rgb(255, 170, 20), rgb(255, 250, 150)),
	Mitico = seq(rgb(255, 140, 170), rgb(255, 30, 70), rgb(255, 140, 170)),
	Divino = seq(rgb(255, 255, 255), rgb(255, 230, 120), rgb(255, 255, 255), rgb(255, 230, 120)),
	Secreto = seq(rgb(255, 60, 60), rgb(255, 200, 40), rgb(60, 255, 120), rgb(60, 160, 255), rgb(200, 60, 255), rgb(255, 60, 60)),
}

RarityStyle.Spin = { Lendario = true, Mitico = true, Divino = true, Secreto = true }

-- Aplica o degradê da raridade num TextLabel
function RarityStyle.Apply(label: TextLabel, rarityId: string)
	local old = label:FindFirstChild("RarityGradient")
	if old then
		old:Destroy()
	end
	local gradient = Instance.new("UIGradient")
	gradient.Name = "RarityGradient"
	gradient.Color = RarityStyle.Gradients[rarityId] or RarityStyle.Gradients.Comum
	gradient.Rotation = 90
	gradient.Parent = label
	label.TextColor3 = Color3.new(1, 1, 1)
	if RarityStyle.Spin[rarityId] then
		CollectionService:AddTag(gradient, "SpinGradient")
	end
	return gradient
end

return RarityStyle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Rebirths</string>
          <string name="Source"><![CDATA[-- Rebirths: zera dinheiro e dragões em troca de bônus permanentes.
-- Cash = dinheiro necessário | NeedRarity = precisa ter ao menos 1 dragão dessa raridade (ou melhor)
-- Multiplier = multiplicador TOTAL de renda depois desse rebirth | Unlocks = equipamento liberado

local Rebirths = {}

Rebirths.List = {
	{ Cash = 1e6, NeedRarity = "Epico", Multiplier = 1.5, Unlocks = "TapaFerro" },
	{ Cash = 5e6, NeedRarity = "Epico", Multiplier = 2, Unlocks = "BobinaGravidade" },
	{ Cash = 2e7, NeedRarity = "Lendario", Multiplier = 2.5, Unlocks = "Teia" },
	{ Cash = 7.5e7, NeedRarity = "Lendario", Multiplier = 3, Unlocks = "Capa" },
	{ Cash = 2.5e8, NeedRarity = "Lendario", Multiplier = 4 },
	{ Cash = 1e9, NeedRarity = "Mitico", Multiplier = 5, Unlocks = "RaioCongelante" },
	{ Cash = 4e9, NeedRarity = "Mitico", Multiplier = 6.5 },
	{ Cash = 1.5e10, NeedRarity = "Mitico", Multiplier = 8, Unlocks = "TapaEsmeralda" },
	{ Cash = 6e10, NeedRarity = "Divino", Multiplier = 10 },
	{ Cash = 2.5e11, NeedRarity = "Divino", Multiplier = 13 },
}

Rebirths.Max = #Rebirths.List

-- Multiplicador de renda para quem já tem X rebirths
function Rebirths.MultiplierFor(count: number): number
	if count <= 0 then
		return 1
	end
	local entry = Rebirths.List[math.min(count, Rebirths.Max)]
	return entry.Multiplier
end

return Rebirths
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Cria (servidor) ou encontra (cliente) os RemoteEvents usados no jogo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = {
	"State", -- servidor -> cliente: dados do jogador para a interface
	"Notify", -- servidor -> cliente: mensagem pequena
	"Alert", -- servidor -> cliente: mensagem grande no meio da tela
	"Effect", -- servidor -> cliente: efeitos visuais/sonoros
	"Action", -- cliente -> servidor: pedidos (comprar, rebirth, códigos...)
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(NAMES) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in ipairs(NAMES) do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
