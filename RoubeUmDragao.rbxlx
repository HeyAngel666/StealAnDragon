      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DragonBuilder</string>
          <string name="Source"><![CDATA[-- Monta os modelos 3D dos dragões usando peças (sem precisar de malhas externas).
-- O dragão olha para -Z (LookVector), com os pés em Y = 0.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Dragons = require(script.Parent.Dragons)
local Rarities = require(script.Parent.Rarities)
local Mutations = require(script.Parent.Mutations)

local DragonBuilder = {}

local BASE_SCALE = 0.8

local function ellipsoid(size: Vector3, cf: CFrame, color: Color3, role: string, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	p:SetAttribute("Role", role)
	return p
end

local function block(size: Vector3, cf: CFrame, color: Color3, role: string, material: Enum.Material?, className: string?)
	local p = Instance.new(className or "Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p:SetAttribute("Role", role)
	return p
end

local function ball(diameter: number, cf: CFrame, color: Color3, role: string, material: Enum.Material?)
	local p = block(Vector3.new(diameter, diameter, diameter), cf, color, role, material)
	p.Shape = Enum.PartType.Ball
	return p
end

local function addParticles(parent: Instance, color: Color3, props)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = props.LightEmission or 1
	e.Rate = props.Rate or 8
	e.Lifetime = props.Lifetime or NumberRange.new(0.8, 1.4)
	e.Speed = props.Speed or NumberRange.new(1, 3)
	e.SpreadAngle = props.SpreadAngle or Vector2.new(180, 180)
	e.Size = props.Size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = props.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	if props.Acceleration then
		e.Acceleration = props.Acceleration
	end
	e.Parent = parent
	return e
end

-- ===================== Modelos importados do Blender =====================
-- Se existir ReplicatedStorage.DragonModels com os modelos importados
-- (Dragon_Basic, Dragon_Chunky, Dragon_Serpent, Dragon_Spiky, Dragon_Hydra),
-- eles são usados no lugar dos dragões feitos de peças.

local STYLE_TEMPLATE = {
	Basic = "Basic",
	Chunky = "Chunky",
	Serpent = "Serpent",
	Spiky = "Spiky",
	Hydra = "Hydra",
	Crystal = "Spiky",
	Skeleton = "Basic",
}

local ROLE_BY_NAME = { "Belly", "Wings", "Horns", "Pupils", "Eyes", "Body" }
local prepared = {} -- [estilo] = { Model, Height } (protótipo normalizado)

local function roleOf(name: string): string?
	local lower = string.lower(name)
	for _, role in ipairs(ROLE_BY_NAME) do
		if string.find(lower, string.lower(role), 1, true) then
			return role
		end
	end
	return nil
end

local function findTemplate(style: string)
	local folder = ReplicatedStorage:FindFirstChild("DragonModels")
	if not folder then
		return nil
	end
	local key = STYLE_TEMPLATE[style] or "Basic"
	return folder:FindFirstChild("Dragon_" .. key) or folder:FindFirstChild(key) or folder:FindFirstChild("Dragon_Basic")
end

-- Prepara o modelo importado uma vez: raiz nos pés, olhando para -Z, altura 1
local function prepareTemplate(style: string)
	local key = STYLE_TEMPLATE[style] or "Basic"
	if prepared[key] ~= nil then
		return prepared[key] or nil
	end
	local template = findTemplate(style)
	if not template then
		prepared[key] = false
		return nil
	end
	local model = template:Clone()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Humanoid") or d:IsA("AnimationController") or d:IsA("SurfaceAppearance") then
			d:Destroy()
		end
	end
	local meshes = {}
	local bones = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(meshes, d)
		elseif d:IsA("Bone") then
			bones[d.Name] = d
		end
	end
	if #meshes == 0 then
		prepared[key] = false
		return nil
	end
	-- direção para frente: da cauda para a cabeça
	local headBone = bones.Head or bones.Neck2
	local tailBone = bones.Tail1 or bones.Spine
	local forward = Vector3.new(0, 0, -1)
	if headBone and tailBone then
		local d = (headBone.WorldPosition - tailBone.WorldPosition) * Vector3.new(1, 0, 1)
		if d.Magnitude > 0.01 then
			forward = d.Unit
		end
	end
	local bboxCF, size = model:GetBoundingBox()
	local feet = Vector3.new(bboxCF.Position.X, bboxCF.Position.Y - size.Y / 2, bboxCF.Position.Z)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CFrame = CFrame.lookAt(feet, feet + forward)
	root.Parent = model
	model.PrimaryPart = root
	model:PivotTo(CFrame.new())
	model:ScaleTo(1 / math.max(size.Y, 0.01))
	prepared[key] = { Model = model }
	return prepared[key]
end

-- Monta as partes a partir do modelo importado
local function buildFromTemplate(model: Model, info, def, height: number, material: Enum.Material, add)
	local proto = info.Model:Clone()
	proto:ScaleTo(proto:GetScale() * height)
	local root = proto.PrimaryPart
	local hornColor = def.Horn or def.Belly:Lerp(Color3.new(1, 1, 1), 0.4)
	local body, eyesPart
	local tailBone, tailIndex = nil, -1
	for _, d in ipairs(proto:GetDescendants()) do
		if d:IsA("Bone") then
			local n = tonumber(string.match(d.Name, "^Tail(%d+)$"))
			if n and n > tailIndex then
				tailBone, tailIndex = d, n
			end
		end
	end
	for _, d in ipairs(proto:GetChildren()) do
		d.Parent = model
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local role = roleOf(d.Name)
			if role then
				d:SetAttribute("Role", role == "Wings" and "Wing" or role)
				if d:IsA("MeshPart") then
					d.TextureID = ""
				end
			end
			if role == "Body" then
				d.Color = def.Body
				d.Material = material
				body = body or d
			elseif role == "Belly" then
				d.Color = def.Belly
				d.Material = material
			elseif role == "Wings" then
				d.Color = def.Wing
				d.Material = material == Enum.Material.Neon and Enum.Material.SmoothPlastic or material
			elseif role == "Horns" then
				d.Color = hornColor
				d.Material = Enum.Material.SmoothPlastic
			elseif role == "Eyes" then
				d.Color = def.Eye
				d.Material = Enum.Material.Neon
				eyesPart = d
			elseif role == "Pupils" then
				d.Color = Color3.fromRGB(15, 15, 20)
				d.Material = Enum.Material.SmoothPlastic
			end
			add(d)
		end
	end
	root.Parent = model
	add(root)
	body = body or root
	-- âncoras invisíveis para efeitos (coroa, auréola, fogo)
	local function anchorPart(name: string, cf: CFrame)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(0.2, 0.2, 0.2)
		p.Transparency = 1
		p.CFrame = cf
		add(p)
		return p
	end
	local up = root.CFrame.UpVector
	local fwd = root.CFrame.LookVector
	local headPos = eyesPart and (eyesPart.Position - fwd * 0.06 * height + up * 0.03 * height) or (root.Position + up * height * 0.75 + fwd * height * 0.35)
	local head = anchorPart("Head", root.CFrame.Rotation + headPos)
	local tipPos = tailBone and tailBone.WorldPosition or (root.Position - fwd * height * 0.9 + up * height * 0.2)
	local tip = anchorPart("TailTip", root.CFrame.Rotation + tipPos)
	return root, body, head, tip
end

--[[
	Build(dragonId, mutationId, options)
	options.Scale     multiplicador extra de tamanho
	options.Anchored  se a raiz fica ancorada (padrão true)
	options.NoEffects sem partículas/luzes (para miniaturas)
]]
function DragonBuilder.Build(dragonId: string, mutationId: string?, options)
	options = options or {}
	local def = Dragons.Get(dragonId)
	assert(def, "Dragão desconhecido: " .. tostring(dragonId))
	local rarity = Rarities.Get(def.Rarity)
	local mutation = Mutations.Get(mutationId)
	local s = BASE_SCALE * rarity.Scale * (options.Scale or 1)
	local style = def.Style or "Basic"

	local model = Instance.new("Model")
	model.Name = def.Name
	model:SetAttribute("DragonId", def.Id)
	model:SetAttribute("Mutation", mutation.Id)

	local parts = {}
	local function add(p)
		table.insert(parts, p)
		p.Parent = model
		return p
	end

	local material = def.Material and Enum.Material[def.Material] or Enum.Material.SmoothPlastic
	local bodyColor, bellyColor, wingColor = def.Body, def.Belly, def.Wing
	local hornColor = def.Horn or bellyColor:Lerp(Color3.new(1, 1, 1), 0.4)

	local function V(x, y, z)
		return Vector3.new(x, y, z) * s
	end
	local function C(x, y, z)
		return CFrame.new(x * s, y * s, z * s)
	end

	local root, body, head, tip
	local height = 6 * s
	local bodyHeight = 2.3 * s
	local templateInfo = not options.Procedural and prepareTemplate(style)
	if templateInfo then
		root, body, head, tip = buildFromTemplate(model, templateInfo, def, height, material, add)
	else
	-- Raiz invisível (pivô do modelo)
	root = block(Vector3.new(1, 1, 1), CFrame.new(), Color3.new(1, 1, 1), "Root")
	root.Name = "Root"
	root.Transparency = 1
	add(root)

	-- Proporções por estilo
	local bodySize = V(2.6, 2.4, 3.6)
	local legLen = 1.4
	local wingScale = 1
	local tailSegments = 4
	local neckLen = 1
	if style == "Chunky" then
		bodySize = V(3.3, 2.9, 3.9)
		legLen = 1.1
		wingScale = 0.75
	elseif style == "Serpent" then
		bodySize = V(2.1, 2.0, 4.2)
		tailSegments = 7
		neckLen = 1.4
		wingScale = 0.85
	elseif style == "Skeleton" then
		bodySize = V(2.2, 2.1, 3.6)
	end

	local bodyY = (legLen + 0.9)
	body = add(ellipsoid(bodySize, C(0, bodyY, 0), bodyColor, "Body", material))
	body.Name = "Body"
	if style == "Skeleton" then
		body.Transparency = 0.35
		-- costelas
		for i = -1, 1 do
			add(block(V(2.5, 0.25, 0.3), C(0, bodyY + 0.2, i * 0.9) * CFrame.Angles(0, 0, 0), bellyColor, "Belly", Enum.Material.SmoothPlastic))
			add(block(V(0.25, 2.2, 0.3), C(1.1, bodyY, i * 0.9), bellyColor, "Belly", Enum.Material.SmoothPlastic))
			add(block(V(0.25, 2.2, 0.3), C(-1.1, bodyY, i * 0.9), bellyColor, "Belly", Enum.Material.SmoothPlastic))
		end
	else
		add(ellipsoid(bodySize * Vector3.new(0.82, 0.8, 0.82), C(0, bodyY - 0.28, -0.3), bellyColor, "Belly", material))
	end

	-- Pescoço + cabeça (a Hidra tem três)
	local headOffsets = { 0 }
	if style == "Hydra" then
		headOffsets = { -0.45, 0, 0.45 }
	end
	local headParts = {}
	for _, yaw in ipairs(headOffsets) do
		local base = CFrame.new(0, bodyY * s, 0) * CFrame.Angles(0, yaw, 0)
		local neckCF = base * C(0, 1.1 * neckLen, -1.4) * CFrame.Angles(-0.55, 0, 0)
		add(ellipsoid(V(1.25, 2.0 * neckLen, 1.25), neckCF, bodyColor, "Body", material))
		local headCF = base * C(0, 2.2 * neckLen, -2.1 - 0.3 * neckLen)
		local headPart = add(ellipsoid(V(1.9, 1.6, 2.0), headCF, bodyColor, "Body", material))
		headPart.Name = "Head"
		table.insert(headParts, headPart)
		add(ellipsoid(V(1.35, 1.0, 1.5), headCF * C(0, -0.25, -0.95), bodyColor, "Body", material))
		add(ellipsoid(V(1.15, 0.45, 1.3), headCF * C(0, -0.6, -0.8), bellyColor, "Belly", material))
		-- olhos
		for _, side in ipairs({ -1, 1 }) do
			add(ball(0.5 * s, headCF * C(side * 0.55, 0.3, -0.7), def.Eye, "Eye", Enum.Material.Neon))
			add(ball(0.24 * s, headCF * C(side * 0.62, 0.32, -0.92), Color3.new(0.05, 0.05, 0.05), "Pupil"))
			-- chifres
			local horn = block(V(0.35, 1.2, 0.7), headCF * C(side * 0.5, 1.0, 0.4) * CFrame.Angles(0.6, 0, side * -0.2), hornColor, "Horn", Enum.Material.SmoothPlastic, "WedgePart")
			add(horn)
			if style == "Spiky" or style == "Crystal" then
				add(block(V(0.25, 0.8, 0.5), headCF * C(side * 0.85, 0.55, 0.6) * CFrame.Angles(0.8, 0, side * -0.6), hornColor, "Horn", Enum.Material.SmoothPlastic, "WedgePart"))
			end
		end
	end

	-- Pernas
	if style ~= "Serpent" then
		for _, side in ipairs({ -1, 1 }) do
			for _, z in ipairs({ -1.0, 1.1 }) do
				add(ellipsoid(V(0.8, legLen + 0.4, 0.85), C(side * 0.9, (legLen + 0.4) / 2 + 0.2, z), bodyColor, "Body", material))
				add(ellipsoid(V(0.95, 0.45, 1.2), C(side * 0.9, 0.22, z - 0.15), bellyColor, "Belly", material))
			end
		end
	else
		for _, side in ipairs({ -1, 1 }) do
			add(ellipsoid(V(0.6, 1.0, 0.7), C(side * 0.8, 0.6, -0.9), bodyColor, "Body", material))
			add(ellipsoid(V(0.6, 1.0, 0.7), C(side * 0.8, 0.6, 1.2), bodyColor, "Body", material))
		end
	end

	-- Cauda
	local tailSize = 1.2
	local z = bodySize.Z / s / 2 - 0.3
	local y = bodyY - 0.3
	local lastCF = C(0, y, z)
	for i = 1, tailSegments do
		local segLen = 1.5
		z += segLen * 0.75
		y += (style == "Serpent") and math.sin(i * 0.9) * 0.35 or -0.12
		lastCF = C(0, y, z)
		add(ellipsoid(V(tailSize, tailSize * 0.9, segLen), lastCF, bodyColor, "Body", material))
		tailSize *= 0.8
	end
	tip = add(block(V(0.2, 1.1, 1.1), lastCF * C(0, 0.1, 0.8) * CFrame.Angles(math.rad(45), 0, 0), hornColor, "Horn"))
	tip.Name = "TailTip"

	-- Espinhos nas costas
	if style == "Spiky" or style == "Crystal" or style == "Chunky" or style == "Hydra" then
		for i = 0, 3 do
			local spikeMat = style == "Crystal" and Enum.Material.Neon or Enum.Material.SmoothPlastic
			local spikeColor = style == "Crystal" and bellyColor or hornColor
			add(block(V(0.25, 0.9 - i * 0.1, 0.8), C(0, bodyY + bodySize.Y / s / 2 - 0.05, -0.9 + i * 0.75), spikeColor, "Horn", spikeMat, "WedgePart"))
		end
	end
	if style == "Crystal" then
		for _, side in ipairs({ -1, 1 }) do
			local crystal = block(V(0.5, 1.4, 0.5), C(side * 0.9, bodyY + 1.0, 0.4) * CFrame.Angles(0.3, 0.6, side * 0.5), bellyColor, "Belly", Enum.Material.Neon)
			crystal.Transparency = 0.2
			add(crystal)
		end
	end

	-- Asas (articuladas para bater)
	local wingWelds = {}
	for _, side in ipairs({ -1, 1 }) do
		local wingSize = V(2.6 * wingScale, 0.12, 2.0 * wingScale)
		local shoulder = C(side * bodySize.X / s * 0.38, bodyY + 0.75, -0.2) * CFrame.Angles(0, side * -0.25, side * math.rad(35))
		local half = wingSize.X / 2
		local wingCF = shoulder * CFrame.new(side * half, 0, 0)
		local wing = add(block(wingSize, wingCF, wingColor, "Wing", Enum.Material.SmoothPlastic))
		wing.Name = side < 0 and "WingL" or "WingR"
		local outer = add(block(V(1.9 * wingScale, 0.1, 1.5 * wingScale), wingCF * CFrame.new(side * (half + 0.85 * s * wingScale), 0.25 * s, 0.25 * s) * CFrame.Angles(0, 0, side * 0.35), wingColor, "Wing"))
		local bone = add(block(V(2.6 * wingScale, 0.22, 0.22), wingCF * C(0, 0.05, -1.0 * wingScale), bodyColor, "Body", material))
		local weld = Instance.new("Weld")
		weld.Name = "WingJoint"
		weld.Part0 = body
		weld.Part1 = wing
		weld.C0 = body.CFrame:ToObjectSpace(shoulder)
		weld.C1 = CFrame.new(-side * half, 0, 0)
		weld:SetAttribute("Side", side)
		weld.Parent = wing
		for _, extra in ipairs({ outer, bone }) do
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = wing
			wc.Part1 = extra
			wc.Parent = extra
		end
		table.insert(wingWelds, weld)
	end

	head = headParts[1]
	height = (bodyY + 2.2 * neckLen + 1.5) * s
	bodyHeight = bodyY * s
	end

	-- Efeitos
	local effects = {}
	for _, e in ipairs(def.Effects or {}) do
		effects[e] = true
	end
	if effects.Crown then
		local crownCF = head.CFrame * C(0, 0.95, 0.1)
		add(block(V(1.1, 0.35, 1.1), crownCF, Color3.fromRGB(255, 205, 40), "Crown", Enum.Material.Metal))
		for i = 0, 3 do
			local a = i * math.pi / 2
			add(block(V(0.2, 0.5, 0.4), crownCF * CFrame.Angles(0, a, 0) * C(0, 0.4, -0.45), Color3.fromRGB(255, 205, 40), "Crown", Enum.Material.Metal, "WedgePart"))
		end
	end
	if effects.Halo then
		local haloCF = head.CFrame * C(0, 1.7, 0.2)
		for i = 0, 9 do
			local a = i / 10 * math.pi * 2
			add(ball(0.32 * s, haloCF * C(math.cos(a) * 0.8, 0, math.sin(a) * 0.8), Color3.fromRGB(255, 240, 150), "Halo", Enum.Material.Neon))
		end
	end

	if not options.NoEffects then
		if effects.Fire then
			local fire = Instance.new("Fire")
			fire.Size = 3 * s
			fire.Heat = 6
			fire.Color = bellyColor
			fire.SecondaryColor = bodyColor
			fire.Parent = tip
			local fire2 = Instance.new("Fire")
			fire2.Size = 2 * s
			fire2.Heat = 3
			fire2.Parent = head
		end
		if effects.Sparkles then
			local sp = Instance.new("Sparkles")
			sp.SparkleColor = bellyColor
			sp.Parent = body
		end
		if effects.Smoke then
			local sm = Instance.new("Smoke")
			sm.Color = bodyColor
			sm.Opacity = 0.08
			sm.RiseVelocity = 1
			sm.Size = 1.5 * s
			sm.Parent = body
		end
		if effects.Lightning then
			addParticles(body, Color3.fromRGB(255, 250, 120), { Rate = 10, Lifetime = NumberRange.new(0.1, 0.25), Speed = NumberRange.new(6, 10) })
		end
		if effects.Aura then
			addParticles(body, rarity.Color, { Rate = 15, Speed = NumberRange.new(0.5, 1.5),
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2 * s), NumberSequenceKeypoint.new(1, 0) }) })
		end
		if effects.Stars then
			addParticles(body, Color3.new(1, 1, 1), { Rate = 12, Speed = NumberRange.new(0.5, 2),
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) }) })
		end
		if effects.Bubbles then
			addParticles(body, Color3.fromRGB(150, 230, 255), { Rate = 6, Speed = NumberRange.new(1, 2), Acceleration = Vector3.new(0, 4, 0), LightEmission = 0.3 })
		end
		if rarity.Order >= 5 then
			local light = Instance.new("PointLight")
			light.Color = rarity.Color
			light.Range = 10 * s
			light.Brightness = 1.5
			light.Parent = body
		end
	end
	if effects.Rainbow then
		CollectionService:AddTag(model, "Rainbow")
	end
	if effects.Glitch then
		CollectionService:AddTag(model, "Glitch")
	end

	-- Mutação
	if mutation.Id ~= "Normal" then
		for _, p in ipairs(parts) do
			local role = p:GetAttribute("Role")
			if role == "Body" or role == "Wing" or role == "Belly" then
				if mutation.Id == "Ouro" then
					p.Color = role == "Belly" and Color3.fromRGB(255, 230, 120) or Color3.fromRGB(255, 190, 30)
					p.Material = Enum.Material.Metal
					p.Reflectance = 0.15
				elseif mutation.Id == "Diamante" then
					p.Color = role == "Belly" and Color3.fromRGB(220, 255, 255) or Color3.fromRGB(110, 220, 255)
					p.Material = Enum.Material.Glass
					p.Reflectance = 0.25
				elseif mutation.Id == "Lava" then
					if role == "Belly" then
						p.Color = Color3.fromRGB(255, 100, 0)
						p.Material = Enum.Material.Neon
					else
						p.Color = Color3.fromRGB(40, 30, 30)
						p.Material = Enum.Material.Basalt
					end
				end
			end
		end
		if not options.NoEffects then
			if mutation.Id == "Ouro" or mutation.Id == "Diamante" then
				local sp = Instance.new("Sparkles")
				sp.SparkleColor = mutation.Color
				sp.Parent = body
			elseif mutation.Id == "Lava" then
				local fire = Instance.new("Fire")
				fire.Size = 4 * s
				fire.Color = Color3.fromRGB(255, 120, 0)
				fire.SecondaryColor = Color3.fromRGB(255, 40, 0)
				fire.Parent = body
			end
		end
		if mutation.Id == "ArcoIris" then
			CollectionService:AddTag(model, "Rainbow")
		end
	end

	-- Juntar tudo na raiz
	local anchored = options.Anchored ~= false
	for _, p in ipairs(parts) do
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = p == root or p == body
		p.Massless = true
		p.CastShadow = p ~= root
		if p == root then
			p.Anchored = anchored
		else
			p.Anchored = false
			if not p:FindFirstChildWhichIsA("Weld") and not p:FindFirstChildWhichIsA("WeldConstraint") then
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = root
				wc.Part1 = p
				wc.Parent = p
			end
		end
	end

	local promptAttachment = Instance.new("Attachment")
	promptAttachment.Name = "PromptAttachment"
	promptAttachment.Position = Vector3.new(0, bodyHeight + 1.5 * s, 0)
	promptAttachment.Parent = root

	local topAttachment = Instance.new("Attachment")
	topAttachment.Name = "TopAttachment"
	topAttachment.Position = Vector3.new(0, height + 0.7 * s, 0)
	topAttachment.Parent = root

	model.PrimaryPart = root
	model:SetAttribute("Height", height)
	CollectionService:AddTag(model, "Dragon")
	return model
end

return DragonBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Dragons</string>
          <string name="Source"><![CDATA[-- Catálogo de dragões.
-- Price = preço na esteira | Income = dinheiro por segundo
-- Visual: cores, estilo do corpo e efeitos usados pelo DragonBuilder.

local Rarities = require(script.Parent.Rarities)

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local Dragons = {}

Dragons.List = {
	-- COMUM
	{ Id = "Verdinho", Name = "Dragãozinho Verde", Rarity = "Comum", Price = 25, Income = 1,
		Body = rgb(90, 180, 70), Belly = rgb(220, 230, 140), Wing = rgb(60, 140, 50), Eye = rgb(255, 255, 255), Style = "Basic" },
	{ Id = "Lagartixa", Name = "Lagartixa de Fogo", Rarity = "Comum", Price = 60, Income = 2,
		Body = rgb(230, 110, 50), Belly = rgb(255, 210, 120), Wing = rgb(200, 70, 40), Eye = rgb(255, 255, 0), Style = "Basic" },
	{ Id = "Lama", Name = "Dragão de Lama", Rarity = "Comum", Price = 120, Income = 4,
		Body = rgb(120, 85, 55), Belly = rgb(170, 130, 90), Wing = rgb(95, 65, 40), Eye = rgb(255, 230, 150), Style = "Chunky" },
	{ Id = "Cinzento", Name = "Filhote Cinzento", Rarity = "Comum", Price = 200, Income = 6,
		Body = rgb(140, 140, 150), Belly = rgb(200, 200, 205), Wing = rgb(110, 110, 120), Eye = rgb(120, 220, 255), Style = "Basic" },

	-- INCOMUM
	{ Id = "Pedra", Name = "Dragão de Pedra", Rarity = "Incomum", Price = 500, Income = 12,
		Body = rgb(105, 100, 95), Belly = rgb(150, 145, 135), Wing = rgb(85, 80, 75), Eye = rgb(255, 140, 0), Style = "Chunky", Material = "Slate" },
	{ Id = "Serpente", Name = "Serpente do Rio", Rarity = "Incomum", Price = 900, Income = 20,
		Body = rgb(40, 140, 190), Belly = rgb(170, 230, 240), Wing = rgb(30, 100, 160), Eye = rgb(255, 255, 255), Style = "Serpent" },
	{ Id = "Abobora", Name = "Dragão Abóbora", Rarity = "Incomum", Price = 1500, Income = 30,
		Body = rgb(240, 130, 20), Belly = rgb(255, 200, 80), Wing = rgb(60, 120, 40), Eye = rgb(255, 255, 0), Style = "Chunky", Effects = { "Smoke" } },
	{ Id = "Morcego", Name = "Dragão Morcego", Rarity = "Incomum", Price = 2500, Income = 45,
		Body = rgb(60, 45, 70), Belly = rgb(110, 90, 120), Wing = rgb(40, 30, 50), Eye = rgb(255, 50, 50), Style = "Spiky" },

	-- RARO
	{ Id = "Gelo", Name = "Dragão de Gelo", Rarity = "Raro", Price = 6000, Income = 90,
		Body = rgb(170, 225, 255), Belly = rgb(240, 250, 255), Wing = rgb(120, 190, 240), Eye = rgb(0, 120, 255), Style = "Spiky", Material = "Ice", Effects = { "Sparkles" } },
	{ Id = "Trovao", Name = "Dragão do Trovão", Rarity = "Raro", Price = 10000, Income = 140,
		Body = rgb(250, 220, 40), Belly = rgb(255, 250, 180), Wing = rgb(60, 60, 90), Eye = rgb(120, 220, 255), Style = "Spiky", Effects = { "Lightning" } },
	{ Id = "Esmeralda", Name = "Dragão Esmeralda", Rarity = "Raro", Price = 16000, Income = 210,
		Body = rgb(20, 170, 100), Belly = rgb(150, 255, 190), Wing = rgb(10, 120, 70), Eye = rgb(255, 255, 255), Style = "Crystal", Material = "Glass" },
	{ Id = "Sombrio", Name = "Dragão Sombrio", Rarity = "Raro", Price = 25000, Income = 300,
		Body = rgb(30, 25, 40), Belly = rgb(70, 50, 90), Wing = rgb(20, 15, 30), Eye = rgb(170, 60, 255), Style = "Spiky", Effects = { "Smoke" } },

	-- ÉPICO
	{ Id = "Cristal", Name = "Dragão de Cristal", Rarity = "Epico", Price = 60000, Income = 650,
		Body = rgb(230, 140, 255), Belly = rgb(255, 220, 255), Wing = rgb(180, 100, 240), Eye = rgb(255, 255, 255), Style = "Crystal", Material = "Glass", Effects = { "Sparkles" } },
	{ Id = "Tempestade", Name = "Dragão Tempestade", Rarity = "Epico", Price = 100000, Income = 1000,
		Body = rgb(70, 90, 140), Belly = rgb(150, 170, 210), Wing = rgb(40, 50, 90), Eye = rgb(200, 240, 255), Style = "Serpent", Effects = { "Lightning", "Smoke" } },
	{ Id = "Esqueleto", Name = "Dragão Esqueleto", Rarity = "Epico", Price = 160000, Income = 1500,
		Body = rgb(235, 230, 210), Belly = rgb(200, 195, 175), Wing = rgb(80, 75, 70), Eye = rgb(60, 255, 120), Style = "Skeleton", Effects = { "Aura" } },
	{ Id = "Wyvern", Name = "Wyvern Real", Rarity = "Epico", Price = 250000, Income = 2200,
		Body = rgb(150, 20, 40), Belly = rgb(255, 210, 100), Wing = rgb(110, 10, 30), Eye = rgb(255, 220, 0), Style = "Spiky", Effects = { "Crown" } },

	-- LENDÁRIO
	{ Id = "Fenix", Name = "Dragão Fênix", Rarity = "Lendario", Price = 750000, Income = 6000,
		Body = rgb(255, 120, 20), Belly = rgb(255, 230, 80), Wing = rgb(255, 60, 20), Eye = rgb(255, 255, 255), Style = "Basic", Material = "Neon", Effects = { "Fire" } },
	{ Id = "Vulcanico", Name = "Dragão Vulcânico", Rarity = "Lendario", Price = 1200000, Income = 9000,
		Body = rgb(45, 30, 30), Belly = rgb(255, 80, 0), Wing = rgb(70, 20, 10), Eye = rgb(255, 160, 0), Style = "Chunky", Effects = { "Fire", "Smoke" } },
	{ Id = "Celestial", Name = "Dragão Celestial", Rarity = "Lendario", Price = 2000000, Income = 14000,
		Body = rgb(240, 245, 255), Belly = rgb(255, 230, 150), Wing = rgb(200, 220, 255), Eye = rgb(80, 180, 255), Style = "Serpent", Effects = { "Sparkles", "Halo" } },
	{ Id = "Hidra", Name = "Hidra Dourada", Rarity = "Lendario", Price = 3500000, Income = 22000,
		Body = rgb(230, 180, 40), Belly = rgb(255, 240, 160), Wing = rgb(200, 140, 20), Eye = rgb(255, 30, 30), Style = "Hydra", Material = "Metal", Effects = { "Sparkles" } },

	-- MÍTICO
	{ Id = "Vacuo", Name = "Dragão do Vácuo", Rarity = "Mitico", Price = 10000000, Income = 55000,
		Body = rgb(20, 0, 40), Belly = rgb(120, 0, 200), Wing = rgb(60, 0, 120), Eye = rgb(255, 0, 255), Style = "Spiky", Effects = { "Aura", "Stars" } },
	{ Id = "Leviata", Name = "Leviatã Abissal", Rarity = "Mitico", Price = 18000000, Income = 90000,
		Body = rgb(10, 60, 90), Belly = rgb(40, 200, 200), Wing = rgb(5, 40, 70), Eye = rgb(0, 255, 200), Style = "Serpent", Material = "Glass", Effects = { "Bubbles", "Aura" } },
	{ Id = "Solar", Name = "Dragão Solar", Rarity = "Mitico", Price = 30000000, Income = 140000,
		Body = rgb(255, 200, 0), Belly = rgb(255, 255, 200), Wing = rgb(255, 140, 0), Eye = rgb(255, 255, 255), Style = "Spiky", Material = "Neon", Effects = { "Fire", "Halo" } },
	{ Id = "Lunar", Name = "Dragão Lunar", Rarity = "Mitico", Price = 45000000, Income = 200000,
		Body = rgb(190, 200, 230), Belly = rgb(240, 245, 255), Wing = rgb(90, 100, 160), Eye = rgb(140, 200, 255), Style = "Basic", Material = "Glass", Effects = { "Stars", "Halo" } },

	-- DIVINO
	{ Id = "Arcanjo", Name = "Dragão Arcanjo", Rarity = "Divino", Price = 150000000, Income = 600000,
		Body = rgb(255, 255, 255), Belly = rgb(255, 230, 140), Wing = rgb(255, 250, 220), Eye = rgb(255, 200, 0), Style = "Basic", Material = "Neon", Effects = { "Halo", "Sparkles", "Aura" } },
	{ Id = "Tempo", Name = "Dragão do Tempo", Rarity = "Divino", Price = 300000000, Income = 1100000,
		Body = rgb(60, 200, 220), Belly = rgb(220, 255, 255), Wing = rgb(30, 120, 160), Eye = rgb(255, 255, 255), Style = "Crystal", Material = "Glass", Effects = { "Stars", "Aura" } },
	{ Id = "Galactico", Name = "Dragão Galáctico", Rarity = "Divino", Price = 600000000, Income = 2000000,
		Body = rgb(40, 20, 110), Belly = rgb(255, 120, 230), Wing = rgb(20, 10, 70), Eye = rgb(255, 255, 255), Style = "Serpent", Material = "Neon", Effects = { "Stars", "Aura", "Sparkles" } },
	{ Id = "Bahamut", Name = "Bahamut", Rarity = "Divino", Price = 1000000000, Income = 3200000,
		Body = rgb(40, 40, 50), Belly = rgb(255, 215, 0), Wing = rgb(255, 215, 0), Eye = rgb(255, 60, 0), Style = "Spiky", Material = "Metal", Effects = { "Fire", "Crown", "Aura" } },

	-- SECRETO
	{ Id = "Glitch", Name = "Dragão Glitch", Rarity = "Secreto", Price = 5000000000, Income = 12000000,
		Body = rgb(0, 255, 120), Belly = rgb(255, 0, 255), Wing = rgb(0, 0, 0), Eye = rgb(255, 255, 255), Style = "Crystal", Material = "Neon", Effects = { "Glitch", "Aura" } },
	{ Id = "ReiSupremo", Name = "Dragão Rei Supremo", Rarity = "Secreto", Price = 15000000000, Income = 30000000,
		Body = rgb(120, 0, 20), Belly = rgb(255, 215, 0), Wing = rgb(255, 215, 0), Eye = rgb(255, 255, 255), Style = "Hydra", Material = "Metal", Effects = { "Crown", "Fire", "Aura" } },
	{ Id = "Ancestral", Name = "Dragão Arco-Íris Ancestral", Rarity = "Secreto", Price = 40000000000, Income = 70000000,
		Body = rgb(255, 255, 255), Belly = rgb(255, 255, 255), Wing = rgb(255, 255, 255), Eye = rgb(0, 0, 0), Style = "Serpent", Material = "Neon", Effects = { "Rainbow", "Stars", "Halo" } },
	{ Id = "Primordial", Name = "Dragão Primordial", Rarity = "Secreto", Price = 100000000000, Income = 150000000,
		Body = rgb(10, 10, 10), Belly = rgb(255, 40, 0), Wing = rgb(10, 10, 10), Eye = rgb(255, 0, 0), Style = "Skeleton", Material = "ForceField", Effects = { "Fire", "Aura", "Stars", "Halo" } },
}

Dragons.ById = {}
Dragons.ByRarity = {}
for index, dragon in ipairs(Dragons.List) do
	dragon.Order = index
	Dragons.ById[dragon.Id] = dragon
	Dragons.ByRarity[dragon.Rarity] = Dragons.ByRarity[dragon.Rarity] or {}
	table.insert(Dragons.ByRarity[dragon.Rarity], dragon)
	assert(Rarities.Get(dragon.Rarity), "Raridade inválida: " .. dragon.Rarity)
end

function Dragons.Get(id: string)
	return Dragons.ById[id]
end

-- Sorteia um dragão aleatório de uma raridade
function Dragons.RandomOfRarity(rarityId: string, rngArg: Random?)
	local rng = rngArg or Random.new()
	local list = Dragons.ByRarity[rarityId]
	if not list then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

-- Sorteia uma raridade usando o peso; luck multiplica as raridades Raro ou melhor.
function Dragons.RollRarity(luckArg: number?, rngArg: Random?): string
	local rng = rngArg or Random.new()
	local luck = luckArg or 1
	local total = 0
	local weights = {}
	for _, r in ipairs(Rarities.List) do
		local w = r.Weight
		if r.Order >= 3 then
			w *= luck
		end
		weights[r.Id] = w
		total += w
	end
	local roll = rng:NextNumber() * total
	for _, r in ipairs(Rarities.List) do
		roll -= weights[r.Id]
		if roll <= 0 then
			return r.Id
		end
	end
	return "Comum"
end

return Dragons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Formatação de números ($1.2K, $3.4M...) e tempo.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Number(n: number): string
	n = tonumber(n) or 0
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n))
		return negative and ("-" .. s) or s
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local s
	if n >= 100 then
		s = string.format("%d", math.floor(n))
	elseif n >= 10 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = string.format("%.2f", math.floor(n * 100) / 100)
	end
	if s:find("%.") then
		s = s:gsub("0+$", ""):gsub("%.$", "")
	end
	return (negative and "-" or "") .. s .. SUFFIXES[index]
end

function Format.Cash(n: number): string
	return "$" .. Format.Number(n)
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Gear</string>
          <string name="Source"><![CDATA[-- Equipamentos (ferramentas).
-- Price = custo em dinheiro do jogo | Rebirth = rebirth mínimo para comprar
-- Pass = só vem com gamepass (Robux) | Cooldown em segundos

local Gear = {}

Gear.List = {
	{ Id = "Tapa", Name = "Tapa", Description = "Empurra quem estiver na sua frente e faz soltar o dragão.",
		Price = 500, Rebirth = 0, Cooldown = 2, Kind = "Slap", Power = 55, Range = 9, Color = Color3.fromRGB(255, 200, 160) },
	{ Id = "BobinaVelocidade", Name = "Bobina de Velocidade", Description = "Corre mais rápido enquanto segura.",
		Price = 1500, Rebirth = 0, Cooldown = 0, Kind = "SpeedCoil", Color = Color3.fromRGB(60, 160, 255) },
	{ Id = "Armadilha", Name = "Armadilha", Description = "Coloca uma armadilha que prende o ladrão por 4s.",
		Price = 3000, Rebirth = 0, Cooldown = 10, Kind = "Trap", Duration = 4, Color = Color3.fromRGB(120, 120, 120) },
	{ Id = "TapaFerro", Name = "Tapa de Ferro", Description = "Tapa mais forte que ainda atordoa por 1s.",
		Price = 25000, Rebirth = 1, Cooldown = 2, Kind = "Slap", Power = 85, Range = 10, Stun = 1, Color = Color3.fromRGB(160, 160, 170) },
	{ Id = "BobinaGravidade", Name = "Bobina de Gravidade", Description = "Pula muito mais alto enquanto segura.",
		Price = 100000, Rebirth = 2, Cooldown = 0, Kind = "GravityCoil", Color = Color3.fromRGB(170, 90, 255) },
	{ Id = "Teia", Name = "Lança-Teia", Description = "Prende o jogador mais próximo à sua frente por 3s.",
		Price = 500000, Rebirth = 3, Cooldown = 12, Kind = "Freeze", Range = 45, Duration = 3, Visual = "Web", Color = Color3.fromRGB(240, 240, 240) },
	{ Id = "Capa", Name = "Capa de Invisibilidade", Description = "Fica invisível e mais rápido por 8s.",
		Price = 2500000, Rebirth = 4, Cooldown = 30, Kind = "Invisible", Duration = 8, Color = Color3.fromRGB(80, 60, 120) },
	{ Id = "RaioCongelante", Name = "Raio Congelante", Description = "Congela o jogador mais próximo por 4s.",
		Price = 15000000, Rebirth = 6, Cooldown = 15, Kind = "Freeze", Range = 60, Duration = 4, Visual = "Ice", Color = Color3.fromRGB(120, 220, 255) },
	{ Id = "TapaEsmeralda", Name = "Tapa Esmeralda", Description = "Tapa gigante que arremessa longe.",
		Price = 100000000, Rebirth = 8, Cooldown = 2, Kind = "Slap", Power = 130, Range = 12, Stun = 1.5, Color = Color3.fromRGB(40, 220, 120) },

	-- Somente com Robux (gamepass)
	{ Id = "TapaBuracoNegro", Name = "Tapa Buraco Negro", Description = "Arremessa os inimigos para longe. (Gamepass)",
		Pass = "TapaBuracoNegro", Cooldown = 1.5, Kind = "Slap", Power = 170, Range = 13, Stun = 1.5, Color = Color3.fromRGB(20, 0, 40) },
	{ Id = "Martelo", Name = "Martelo do Banimento", Description = "\"Bane\" o alvo: manda ele de volta pra base dele. (Gamepass)",
		Pass = "Martelo", Cooldown = 20, Kind = "Ban", Range = 10, Color = Color3.fromRGB(255, 60, 60) },
}

Gear.ById = {}
for index, item in ipairs(Gear.List) do
	item.Order = index
	Gear.ById[item.Id] = item
end

function Gear.Get(id: string)
	return Gear.ById[id]
end

return Gear
]]></string>
