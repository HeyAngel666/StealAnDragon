  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="45">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[-- Efeitos visuais vindos do servidor: dinheiro flutuando, empurrões, confete,
-- raios, tremor de câmera, aviso de meteoro, alerta de roubo, etc.

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Gear = require(Shared.Gear)
local UI = require(script.Parent.UI)

local EffectsController = {}
local player = Players.LocalPlayer
local handlers = {}

local function getRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart"), character and character:FindFirstChildOfClass("Humanoid")
end

function handlers.Sound(self, data)
	self.App.Controllers.SoundController:Play(data.Name, data.Position)
end

function handlers.Collect(self, data)
	self.App.Controllers.SoundController:Play("Coin")
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = data.Position + Vector3.new(0, 3, 0)
	holder.Parent = workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 50)
	gui.AlwaysOnTop = true
	gui.Parent = holder
	local l = UI.label({ Text = "+" .. Format.Cash(data.Amount), Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(120, 255, 120), Parent = gui })
	TweenService:Create(holder, TweenInfo.new(1.2), { Position = holder.Position + Vector3.new(0, 6, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(1.2), { TextTransparency = 1 }):Play()
	Debris:AddItem(holder, 1.3)
	self.App.Controllers.TutorialController:OnEvent("Collected")
end

function handlers.Knockback(_, data)
	local root, humanoid = getRoot()
	if not root or not humanoid then
		return
	end
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = data.Velocity
	root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-4, 4), math.random(-8, 8))
	task.delay(data.Ragdoll or 0.6, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

function handlers.Swing()
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool then
		-- o script de animação padrão do Roblox toca o golpe com isso
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 1)
	end
end

function handlers.Cooldown(self, data)
	local item = Gear.Get(data.Gear)
	if item then
		self.App.Controllers.HudController:SetCooldown(item.Name, data.Duration)
	end
end

function handlers.Confetti(self)
	local colors = { UI.Colors.Gold, UI.Colors.Red, UI.Colors.Green, UI.Colors.Blue, UI.Colors.Purple }
	for _ = 1, 70 do
		local piece = UI.new("Frame", {
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22)),
			Position = UDim2.new(math.random(), 0, -0.05, 0),
			Rotation = math.random(0, 360),
			ZIndex = 30,
			Parent = self.App.Gui,
		})
		local duration = math.random(18, 30) / 10
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-360, 360),
		}):Play()
		Debris:AddItem(piece, duration)
	end
end

function handlers.Beam(_, data)
	local from, to = data.From, data.To
	local dist = (to - from).Magnitude
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Material = Enum.Material.Neon
	beam.Color = data.Color or Color3.new(1, 1, 1)
	beam.Size = Vector3.new(0.5, 0.5, dist)
	beam.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -dist / 2)
	beam.Parent = workspace
	TweenService:Create(beam, TweenInfo.new(0.4), { Transparency = 1, Size = Vector3.new(0.1, 0.1, dist) }):Play()
	Debris:AddItem(beam, 0.45)
end

function handlers.Shake(_, data)
	local root = getRoot()
	local camera = workspace.CurrentCamera
	if not root or not camera then
		return
	end
	local dist = (root.Position - data.Position).Magnitude
	local strength = (data.Strength or 1) * math.clamp(1 - dist / 80, 0, 1)
	if strength <= 0 then
		return
	end
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > 0.4 then
			conn:Disconnect()
			return
		end
		local s = strength * (1 - t / 0.4) * 0.6
		camera.CFrame = camera.CFrame * CFrame.new(math.random(-10, 10) / 10 * s, math.random(-10, 10) / 10 * s, 0)
	end)
end

function handlers.MeteorWarning(_, data)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, 22, 22)
	ring.CFrame = CFrame.new(data.Position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Color = Color3.fromRGB(255, 40, 40)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.6
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(data.Time or 1.2), { Transparency = 0.2 }):Play()
	Debris:AddItem(ring, data.Time or 1.2)
end

function handlers.Frozen(self, data)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(170, 220, 255)
	cc.Parent = Lighting
	Debris:AddItem(cc, data.Duration or 3)
	self.App.Controllers.SoundController:Play("Freeze")
end

function handlers.StealAlert(self, data)
	local thief = Players:GetPlayerByUserId(data.Thief)
	if thief and thief.Character then
		local h = Instance.new("Highlight")
		h.FillColor = Color3.fromRGB(255, 40, 40)
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = thief.Character
		Debris:AddItem(h, 10)
	end
	-- tela pisca vermelho
	local flash = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 0, 0), BackgroundTransparency = 0.6, Size = UDim2.fromScale(1, 1), ZIndex = 25, Parent = self.App.Gui })
	TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
	Debris:AddItem(flash, 0.8)
end

function handlers.CarryStart(self, data)
	self.App.Controllers.HudController:SetCarrying(true)
	self.App.Controllers.WorldController:PointTo("Base", data.BaseIndex)
end

function handlers.CarryEnd(self)
	self.App.Controllers.HudController:SetCarrying(false)
	self.App.Controllers.WorldController:ClearPointer()
end

function handlers.Tutorial(self, data)
	self.App.Controllers.TutorialController:OnEvent(data.Event)
end

function handlers.Offline(self, data)
	local frame = UI.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 250),
		ZIndex = 40,
		Parent = self.App.Gui,
	})
	UI.gradient(UI.Colors.PanelLight, UI.Colors.Panel).Parent = frame
	UI.label({ Text = "👋 BEM-VINDO DE VOLTA!", Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 10), TextColor3 = UI.Colors.Gold, Parent = frame })
	UI.label({ Text = "Seus dragões renderam enquanto você estava fora (" .. Format.Time(data.Seconds) .. "):", Size = UDim2.new(1, -30, 0, 50),
		Position = UDim2.fromOffset(15, 60), TextWrapped = true, MaxText = 20, Parent = frame })
	UI.label({ Text = "+" .. Format.Cash(data.Amount), Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 112), TextColor3 = Color3.fromRGB(120, 255, 120), MaxText = 44, Parent = frame })
	local state = self.App.State
	if state and not (state.Passes and state.Passes.VIP) then
		UI.label({ Text = "VIP guarda até 3 horas de renda offline!", Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 162), TextColor3 = UI.Colors.Gold, MaxText = 16, Parent = frame })
	end
	UI.button({ Text = "OBA!", Color = UI.Colors.Green, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(160, 46), Parent = frame }, function()
		frame:Destroy()
	end)
	UI.pop(frame)
	self.App.Controllers.SoundController:Play("Reward")
end

function EffectsController:Init(App)
	self.App = App
end

function EffectsController:Start(App)
	App.Remotes.Effect.OnClientEvent:Connect(function(name, data)
		local handler = handlers[name]
		if handler then
			handler(self, data or {})
		end
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">GamepadController</string>
              <string name="Source"><![CDATA[-- Suporte a controle (Xbox / PlayStation / controle no PC).
--   Y (Triângulo) = abrir o menu lateral (navegue com o direcional e aperte A)
--   B (Bola)      = fechar a janela / sair do menu
--   Direcional ↓  = coletar tudo (dentro da sua base)
-- Andar, pular, usar itens (R2) e trocar itens (L1/R1) já funcionam pelo Roblox.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent.UI)

local GamepadController = {}

local function menuSelected(hud): boolean
	local selected = GuiService.SelectedObject
	return selected ~= nil and selected:IsDescendantOf(hud.MenuButtons.Shop.Parent)
end

function GamepadController:Init(App)
	self.App = App
	self.Hint = UI.label({
		Name = "GamepadHint",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.fromOffset(460, 28),
		Text = "Ⓨ Menu   Ⓑ Fechar   ⬇ Coletar tudo   ⓧ Comprar/Roubar",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 20,
		Visible = false,
		Parent = App.Gui,
	})
end

function GamepadController:Start(App)
	local hud = App.Controllers.HudController
	local panels = App.Controllers.PanelController

	local function updateHint()
		local last = UserInputService:GetLastInputType()
		self.Hint.Visible = UserInputService.GamepadEnabled and last.Name:find("Gamepad") ~= nil
	end
	updateHint()
	UserInputService.LastInputTypeChanged:Connect(updateHint)
	UserInputService.GamepadConnected:Connect(updateHint)
	UserInputService.GamepadDisconnected:Connect(updateHint)

	-- Y: abre/fecha a seleção do menu lateral
	ContextActionService:BindAction("GamepadMenu", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if panels:GetOpen() then
			panels:Close()
		end
		if menuSelected(hud) then
			GuiService.SelectedObject = nil
		else
			GuiService.SelectedObject = hud.MenuButtons.Shop
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonY)

	-- B: fecha janela ou sai do menu
	ContextActionService:BindAction("GamepadBack", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if panels:GetOpen() then
			panels:Close()
			return Enum.ContextActionResult.Sink
		end
		if GuiService.SelectedObject then
			GuiService.SelectedObject = nil
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.ButtonB)

	-- Direcional para baixo: coletar tudo (só quando não está navegando na interface)
	ContextActionService:BindAction("GamepadCollect", function(_, state)
		if state ~= Enum.UserInputState.Begin or GuiService.SelectedObject then
			return Enum.ContextActionResult.Pass
		end
		App:Send("CollectAll")
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.DPadDown)
end

return GamepadController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[-- Interface fixa: dinheiro, renda, botões do menu, evento atual, status da base.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Config = require(Shared.Config)
local UI = require(script.Parent.UI)

local HudController = {}

local MENU = {
	{ Panel = "Shop", Icon = "🛒", Text = "Loja", Color = UI.Colors.Red },
	{ Panel = "Robux", Icon = "💎", Text = "VIP", Color = UI.Colors.Gold },
	{ Panel = "Rebirth", Icon = "🌟", Text = "Rebirth", Color = UI.Colors.Purple },
	{ Panel = "Index", Icon = "📖", Text = "Índice", Color = UI.Colors.Blue },
	{ Panel = "Rewards", Icon = "🎁", Text = "Presentes", Color = UI.Colors.Green },
	{ Panel = "Codes", Icon = "🎟️", Text = "Códigos", Color = Color3.fromRGB(60, 180, 200) },
	{ Panel = "Settings", Icon = "⚙️", Text = "Config", Color = UI.Colors.Gray },
}

function HudController:Init(App)
	self.App = App
	local gui = App.Gui

	-- Dinheiro (topo)
	local cashFrame = UI.frame({
		Name = "Cash",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(300, 64),
		BackgroundColor3 = Color3.fromRGB(40, 120, 50),
		Parent = gui,
	})
	UI.gradient(Color3.fromRGB(90, 220, 100), Color3.fromRGB(30, 130, 50)).Parent = cashFrame
	UI.label({ Text = "💰", Size = UDim2.fromOffset(52, 52), Position = UDim2.new(0, -18, 0.5, -26), MaxText = 44, Parent = cashFrame })
	UI.shine(cashFrame)
	self.CashLabel = UI.label({ Text = "$0", Size = UDim2.new(1, -10, 0.65, 0), Position = UDim2.fromOffset(5, 2), MaxText = 40, Parent = cashFrame })
	self.IncomeLabel = UI.label({ Text = "+$0/s", Size = UDim2.new(1, -10, 0.32, 0), Position = UDim2.new(0, 5, 0.64, 0), MaxText = 20,
		TextColor3 = Color3.fromRGB(230, 255, 200), Parent = cashFrame })

	self.BaseLabel = UI.label({
		Name = "BaseStatus",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 76),
		Size = UDim2.fromOffset(360, 26),
		Text = "",
		MaxText = 22,
		Parent = gui,
	})

	-- Menu lateral
	local menu = UI.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(170, 470),
		Parent = gui,
	})
	local grid = UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(78, 78),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	local _ = grid
	self.MenuButtons = {}
	for i, item in ipairs(MENU) do
		local b = UI.button({ Text = "", Color = item.Color, LayoutOrder = i, Parent = menu }, function()
			App.Controllers.PanelController:Open(item.Panel)
		end)
		UI.label({ Text = item.Icon, Size = UDim2.new(1, 0, 0.62, 0), MaxText = 36, Parent = b })
		UI.label({ Text = item.Text, Size = UDim2.new(1, 0, 0.36, 0), Position = UDim2.fromScale(0, 0.64), MaxText = 16, Parent = b })
		local badge = UI.frame({ Name = "Badge", Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -18, 0, -8), BackgroundColor3 = UI.Colors.Red, Visible = false, Radius = 12, Parent = b })
		UI.label({ Text = "!", Size = UDim2.fromScale(1, 1), Parent = badge })
		self.MenuButtons[item.Panel] = b
		if item.Panel == "Robux" or item.Panel == "Rewards" then
			UI.shine(b)
		end
	end
	self.AdminButton = UI.button({ Text = "", Color = UI.Colors.Red, LayoutOrder = 99, Parent = menu }, function()
		App.Controllers.PanelController:Open("Admin")
	end)
	UI.label({ Text = "🛠️", Size = UDim2.new(1, 0, 0.62, 0), MaxText = 36, Parent = self.AdminButton })
	UI.label({ Text = "Admin", Size = UDim2.new(1, 0, 0.36, 0), Position = UDim2.fromScale(0, 0.64), MaxText = 16, Parent = self.AdminButton })
	self.AdminButton.Visible = false

	-- Evento (direita, topo)
	self.EventFrame = UI.frame({
		Name = "Event",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(300, 70),
		BackgroundColor3 = Color3.fromRGB(150, 60, 220),
		Visible = false,
		Parent = gui,
	})
	self.EventName = UI.label({ Text = "", Size = UDim2.new(1, -10, 0.5, 0), Position = UDim2.fromOffset(5, 3), MaxText = 24, Parent = self.EventFrame })
	self.EventTimer = UI.label({ Text = "", Size = UDim2.new(1, -10, 0.4, 0), Position = UDim2.new(0, 5, 0.55, 0), MaxText = 18, Parent = self.EventFrame })

	self.LuckLabel = UI.label({
		Name = "Luck",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 84),
		Size = UDim2.fromOffset(300, 26),
		Text = "",
		TextColor3 = Color3.fromRGB(120, 255, 120),
		MaxText = 20,
		Parent = gui,
	})

	-- Botão coletar tudo
	self.CollectButton = UI.button({
		Text = "💰 Coletar tudo",
		Color = UI.Colors.Green,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -90),
		Size = UDim2.fromOffset(190, 52),
		Parent = gui,
	}, function()
		App:Send("CollectAll")
	end)

	-- Aviso de carregamento do dragão
	self.CarryLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(520, 40),
		Text = "🐉 Leve o dragão até a SUA BASE!",
		TextColor3 = Color3.fromRGB(255, 230, 90),
		Visible = false,
		MaxText = 30,
		Parent = gui,
	})

	-- Recarga dos itens
	self.CooldownLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(300, 26),
		Text = "",
		MaxText = 20,
		Parent = gui,
	})
	self.Cooldowns = {}
end

function HudController:SetCarrying(active: boolean)
	self.CarryLabel.Visible = active
end

function HudController:SetCooldown(gearName: string, duration: number)
	self.Cooldowns[gearName] = os.clock() + duration
end

function HudController:Start(App)
	local displayedCash = 0
	App.StateChanged.Event:Connect(function(state)
		self.IncomeLabel.Text = "+" .. Format.Cash(state.Income) .. "/s"
		self.AdminButton.Visible = state.IsAdmin == true
		-- badge de presentes disponíveis
		local canClaim = state.Daily and state.Daily.CanClaim
		if state.Playtime then
			local elapsed = state.ServerTime - state.Playtime.JoinTime
			for i, reward in ipairs(Config.PlaytimeRewards) do
				if not state.Playtime.Claimed[i] and not state.Playtime.Claimed[tostring(i)] and elapsed >= reward.Minutes * 60 then
					canClaim = true
				end
			end
		end
		self.MenuButtons.Rewards.Badge.Visible = canClaim == true
	end)

	RunService.RenderStepped:Connect(function(dt)
		local state = App.State
		if not state then
			return
		end
		-- animação do contador de dinheiro
		displayedCash += (state.Cash - displayedCash) * math.min(1, dt * 8)
		if math.abs(state.Cash - displayedCash) < 1 then
			displayedCash = state.Cash
		end
		self.CashLabel.Text = Format.Cash(displayedCash)

		local now = workspace:GetServerTimeNow()
		local lockEnd = math.max(state.LockedUntil or 0, state.ShieldUntil or 0)
		if lockEnd > now then
			self.BaseLabel.Text = ((state.ShieldUntil or 0) > now and "🛡️ Escudo " or "🔒 Base trancada ") .. Format.Time(lockEnd - now)
			self.BaseLabel.TextColor3 = Color3.fromRGB(120, 220, 255)
		else
			self.BaseLabel.Text = "🔓 Base aberta - tranque no botão verde!"
			self.BaseLabel.TextColor3 = Color3.fromRGB(255, 140, 120)
		end

		local eventEnds = workspace:GetAttribute("EventEnds") or 0
		if eventEnds > now then
			self.EventFrame.Visible = true
			self.EventName.Text = workspace:GetAttribute("EventName") or ""
			self.EventTimer.Text = (workspace:GetAttribute("EventDescription") or "") .. "  " .. Format.Time(eventEnds - now)
		else
			self.EventFrame.Visible = false
		end
		local luckEnds = workspace:GetAttribute("ServerLuckEnds") or 0
		self.LuckLabel.Text = luckEnds > now and ("🍀 Sorte x3 do servidor: " .. Format.Time(luckEnds - now)) or ""

		local parts = {}
		for name, t in pairs(self.Cooldowns) do
			local left = t - os.clock()
			if left > 0 then
				table.insert(parts, string.format("⏳ %s %.1fs", name, left))
			else
				self.Cooldowns[name] = nil
			end
		end
		self.CooldownLabel.Text = table.concat(parts, "   ")
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">NotifyController</string>
              <string name="Source"><![CDATA[-- Mensagens na tela: pequenas (canto) e grandes (centro).

local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)

local NotifyController = {}

local KIND_ICONS = { info = "💬", success = "✅", error = "❌", warning = "⚠️", rare = "✨" }

local KIND_COLORS = {
	info = Color3.fromRGB(70, 130, 230),
	success = Color3.fromRGB(60, 190, 90),
	error = Color3.fromRGB(220, 60, 60),
	warning = Color3.fromRGB(240, 150, 40),
	rare = Color3.fromRGB(170, 80, 255),
}

function NotifyController:Init(App)
	self.App = App
	self.Toasts = UI.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 140),
		Size = UDim2.fromOffset(340, 400),
		Parent = App.Gui,
	})
	local layout = UI.list(self.Toasts, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.VerticalAlignment = Enum.VerticalAlignment.Top

	self.AlertLabel = UI.label({
		Name = "Alert",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.new(0.8, 0, 0, 60),
		Text = "",
		Visible = false,
		MaxText = 46,
		ZIndex = 20,
		Parent = App.Gui,
	})
	self.AlertLabel:FindFirstChildOfClass("UIStroke").Thickness = 4
	self.AlertGradient = UI.new("UIGradient", { Rotation = 90, Parent = self.AlertLabel })
end

function NotifyController:Toast(text: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or KIND_COLORS.info
	local frame = UI.frame({
		Size = UDim2.fromOffset(330, 44),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.05,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = self.Toasts,
	})
	UI.gradient(color:Lerp(Color3.new(1, 1, 1), 0.15), color:Lerp(Color3.new(0, 0, 0), 0.2)).Parent = frame
	UI.label({ Text = KIND_ICONS[kind or "info"] or "💬", Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(6, 6), MaxText = 26, Parent = frame })
	UI.label({
		Text = text,
		Size = UDim2.new(1, -50, 1, -8),
		Position = UDim2.fromOffset(42, 4),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 20,
		TextWrapped = true,
		Parent = frame,
	})
	UI.pop(frame)
	local count = 0
	for _, child in ipairs(self.Toasts:GetChildren()) do
		if child:IsA("Frame") then
			count += 1
		end
	end
	if count > 6 then
		-- remove a mais antiga
		local oldest, oldestOrder = nil, -math.huge
		for _, child in ipairs(self.Toasts:GetChildren()) do
			if child:IsA("Frame") and child.LayoutOrder > oldestOrder then
				oldest, oldestOrder = child, child.LayoutOrder
			end
		end
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(4, function()
		if frame.Parent then
			TweenService:Create(frame, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.wait(0.3)
			frame:Destroy()
		end
	end)
end

local alertToken = 0
function NotifyController:Alert(text: string, color: Color3?)
	alertToken += 1
	local token = alertToken
	local l = self.AlertLabel
	l.Text = text
	local base = color or Color3.new(1, 1, 1)
	l.TextColor3 = Color3.new(1, 1, 1)
	self.AlertGradient.Color = ColorSequence.new(base:Lerp(Color3.new(1, 1, 1), 0.5), base)
	l.TextTransparency = 0
	l.Visible = true
	UI.pop(l)
	task.delay(3.2, function()
		if token == alertToken then
			TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			task.wait(0.4)
			if token == alertToken then
				l.Visible = false
			end
		end
	end)
end

function NotifyController:Start(App)
	App.Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		self:Toast(text, kind)
	end)
	App.Remotes.Alert.OnClientEvent:Connect(function(text, color)
		self:Alert(text, color)
	end)
end

return NotifyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">PanelController</string>
              <string name="Source"><![CDATA[-- Abre/fecha as janelas (Loja, Robux, Rebirth, Índice, Presentes, Códigos, Config, Admin).

local GuiService = game:GetService("GuiService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent.UI)

local PanelController = {}
local panels = {} -- [name] = { Frame, Module }
local openName = nil

local PANEL_LIST = {
	{ Name = "Shop", Title = "🛒 LOJA DE EQUIPAMENTOS", Color = UI.Colors.Red },
	{ Name = "Robux", Title = "💎 LOJA VIP", Color = UI.Colors.Gold },
	{ Name = "Rebirth", Title = "🌟 REBIRTH", Color = UI.Colors.Purple },
	{ Name = "Index", Title = "📖 ÍNDICE DE DRAGÕES", Color = UI.Colors.Blue },
	{ Name = "Rewards", Title = "🎁 PRESENTES", Color = UI.Colors.Green },
	{ Name = "Codes", Title = "🎟️ CÓDIGOS", Color = UI.Colors.Blue },
	{ Name = "Settings", Title = "⚙️ CONFIGURAÇÕES", Color = UI.Colors.Gray },
	{ Name = "Admin", Title = "🛠️ ADMIN", Color = UI.Colors.Red },
}

function PanelController:Init(App)
	self.App = App
	local panelsFolder = script.Parent.Parent:WaitForChild("Panels")
	for _, info in ipairs(PANEL_LIST) do
		local frame = UI.frame({
			Name = info.Name .. "Panel",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromOffset(720, 480),
			Visible = false,
			ZIndex = 5,
			Parent = App.Gui,
		})
		UI.gradient(UI.Colors.PanelLight, UI.Colors.Panel).Parent = frame
		UI.shadow(frame)
		local header = UI.frame({
			Name = "Header",
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = info.Color,
			Parent = frame,
		})
		UI.label({ Text = info.Title, Size = UDim2.new(1, -80, 1, -10), Position = UDim2.fromOffset(16, 5), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 32, Parent = header })
		UI.button({ Text = "X", Color = UI.Colors.Red, Size = UDim2.fromOffset(46, 46), Position = UDim2.new(1, -52, 0, 5), Parent = header }, function()
			self:Close()
		end)
		local content = UI.new("Frame", {
			Name = "Content",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 66),
			Size = UDim2.new(1, -24, 1, -78),
			Parent = frame,
		})
		local module = require(panelsFolder:WaitForChild(info.Name))
		module:Build(App, content)
		panels[info.Name] = { Frame = frame, Module = module }
	end

	App.StateChanged.Event:Connect(function(state)
		if openName then
			local p = panels[openName]
			if p.Module.Update then
				p.Module:Update(state)
			end
		end
	end)

	-- barracas da praça abrem janelas
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local name = prompt:GetAttribute("OpenPanel")
		if name then
			self:Open(name)
		end
	end)
end

function PanelController:Open(name: string)
	local p = panels[name]
	if not p then
		return
	end
	if openName == name then
		return self:Close()
	end
	self:Close()
	openName = name
	p.Frame.Visible = true
	UI.pop(p.Frame)
	self.App.Controllers.SoundController:Play("Click")
	if p.Module.OnOpen then
		p.Module:OnOpen()
	end
	if p.Module.Update and self.App.State then
		p.Module:Update(self.App.State)
	end
	-- controle (console): já seleciona o primeiro botão da janela
	if UserInputService.GamepadEnabled then
		task.defer(function()
			for _, d in ipairs(p.Frame.Content:GetDescendants()) do
				if d:IsA("GuiButton") and d.Visible then
					GuiService.SelectedObject = d
					return
				end
			end
		end)
	end
end

function PanelController:Close()
	if openName then
		local frame = panels[openName].Frame
		frame.Visible = false
		openName = nil
		local selected = GuiService.SelectedObject
		if selected and selected:IsDescendantOf(frame) then
			GuiService.SelectedObject = nil
		end
	end
end

function PanelController:GetOpen(): string?
	return openName
end

function PanelController:IsOpen(name: string): boolean
	return openName == name
end

return PanelController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[-- Toca efeitos sonoros e a música de fundo (IDs em Shared/Sounds).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Sounds = require(ReplicatedStorage.Shared.Sounds)

local SoundController = {}
local templates = {}
local music
local sfxEnabled = true

function SoundController:Init(App)
	self.App = App
	local folder = Instance.new("Folder")
	folder.Name = "GameSounds"
	folder.Parent = SoundService
	for name, info in pairs(Sounds) do
		if info.Id and info.Id ~= 0 then
			local s = Instance.new("Sound")
			s.Name = name
			s.SoundId = "rbxassetid://" .. info.Id
			s.Volume = info.Volume or 0.5
			s.Parent = folder
			templates[name] = s
		end
	end
	if templates.Music then
		music = templates.Music
		music.Looped = true
	end
end

function SoundController:Play(name: string, position: Vector3?)
	if not sfxEnabled then
		return
	end
	local template = templates[name]
	if not template or name == "Music" then
		return
	end
	if position then
		local holder = Instance.new("Part")
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = Vector3.new(1, 1, 1)
		holder.Position = position
		holder.Parent = workspace
		local s = template:Clone()
		s.RollOffMaxDistance = 150
		s.Parent = holder
		s:Play()
		Debris:AddItem(holder, 5)
	else
		SoundService:PlayLocalSound(template)
	end
end

function SoundController:Start(App)
	App.StateChanged.Event:Connect(function(state)
		local settings = state.Settings or {}
		sfxEnabled = settings.Sfx ~= false
		if music then
			if settings.Music ~= false then
				if not music.IsPlaying then
					music:Play()
				end
			elseif music.IsPlaying then
				music:Stop()
			end
		end
	end)
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[-- Tutorial para jogadores novos, com seta guiando cada passo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)
local UI = require(script.Parent.UI)

local TutorialController = {}

local STEPS = {
	{ Text = "1/4  🐉 Vá até a esteira e compre um dragão (aperte E)!", Wait = "Bought" },
	{ Text = "2/4  💰 Volte pra sua base e pise no botão verde do dragão para coletar!", Wait = "Collected" },
	{ Text = "3/4  🔒 Pise no botão grande na entrada da base para TRANCAR!", Wait = "Locked" },
	{ Text = "4/4  😈 Agora roube dragões das outras bases! Segure E e leve até a sua.", Wait = "Stole", Timeout = 25 },
}

function TutorialController:Init(App)
	self.App = App
	self.Step = 0
	self.Banner = UI.frame({
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.fromOffset(640, 50),
		BackgroundColor3 = Color3.fromRGB(255, 180, 40),
		Visible = false,
		Parent = App.Gui,
	})
	self.BannerText = UI.label({ Text = "", Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), MaxText = 24, Parent = self.Banner })
end

function TutorialController:ShowStep(index: number)
	self.Step = index
	local step = STEPS[index]
	local world = self.App.Controllers.WorldController
	if not step then
		self.Banner.Visible = false
		world:ClearPointer()
		self.App:Send("TutorialDone")
		self.App.Controllers.NotifyController:Alert("🎉 Tutorial completo! Boa sorte, ladrão de dragões!", Color3.fromRGB(255, 220, 80))
		return
	end
	self.Banner.Visible = true
	self.BannerText.Text = step.Text
	UI.pop(self.Banner)
	local state = self.App.State
	local baseIndex = state and state.BaseIndex or 1
	local baseCF = Layout.Bases[baseIndex]
	if step.Wait == "Bought" then
		local root = self.App.Player.Character and self.App.Player.Character:FindFirstChild("HumanoidRootPart")
		local x = root and math.clamp(root.Position.X, -150, 150) or 0
		world:PointTo("Position", Vector3.new(x, 3, 0))
	elseif step.Wait == "Collected" and baseCF then
		world:PointTo("Position", (baseCF * CFrame.new(Layout.Slots[1] + Vector3.new(5, 2, 0))).Position)
	elseif step.Wait == "Locked" and baseCF then
		self.LockBaseline = state and state.LockedUntil or 0
		world:PointTo("Position", (baseCF * CFrame.new(Layout.LockButton + Vector3.new(0, 2, 0))).Position)
	else
		world:ClearPointer()
	end
	if step.Timeout then
		task.delay(step.Timeout, function()
			if self.Step == index then
				self:ShowStep(index + 1)
			end
		end)
	end
end

function TutorialController:OnEvent(event: string)
	local step = STEPS[self.Step]
	if step and step.Wait == event then
		self.App.Controllers.SoundController:Play("Reward")
		self:ShowStep(self.Step + 1)
	end
end

function TutorialController:Start(App)
	local started = false
	App.StateChanged.Event:Connect(function(state)
		if not started then
			started = true
			if not state.TutorialDone then
				task.wait(2)
				self:ShowStep(1)
			end
		end
		-- passo de trancar: detecta pela trava
		if STEPS[self.Step] and STEPS[self.Step].Wait == "Locked" and (state.LockedUntil or 0) > (self.LockBaseline or 0) + 1 then
			self:OnEvent("Locked")
		end
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- Pequena biblioteca para criar a interface com o mesmo estilo em tudo.

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.Colors = {
	Panel = Color3.fromRGB(34, 28, 52),
	PanelLight = Color3.fromRGB(52, 44, 78),
	Stroke = Color3.fromRGB(15, 10, 25),
	Gold = Color3.fromRGB(255, 200, 60),
	Green = Color3.fromRGB(70, 210, 100),
	Red = Color3.fromRGB(230, 70, 70),
	Blue = Color3.fromRGB(70, 150, 255),
	Purple = Color3.fromRGB(160, 90, 255),
	Gray = Color3.fromRGB(110, 110, 120),
	White = Color3.new(1, 1, 1),
}

local CUSTOM = { Parent = true, MaxText = true, Radius = true, NoStroke = true }

function UI.new(className: string, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if not CUSTOM[k] then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(radius: number?)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.stroke(thickness: number?, color: Color3?)
	return UI.new("UIStroke", { Thickness = thickness or 3, Color = color or UI.Colors.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.textStroke(thickness: number?)
	return UI.new("UIStroke", { Thickness = thickness or 2, Color = UI.Colors.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function UI.gradient(top: Color3, bottom: Color3)
	return UI.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function UI.padding(px: number)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
	})
end

function UI.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = UI.Colors.White,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 30),
	}
	for k, v in pairs(props or {}) do
		defaults[k] = v
	end
	local l = UI.new("TextLabel", defaults)
	UI.textStroke(2).Parent = l
	local c = UI.new("UITextSizeConstraint", { MaxTextSize = props and props.MaxText or 40 })
	c.Parent = l
	return l
end

function UI.button(props, onClick)
	local color = props.Color or UI.Colors.Green
	local b = UI.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = props.Text or "",
		Font = UI.Font,
		TextColor3 = UI.Colors.White,
		TextScaled = true,
		AutoButtonColor = false,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	UI.corner(props.Radius or 12).Parent = b
	UI.stroke(3).Parent = b
	UI.textStroke(2).Parent = b
	UI.padding(6).Parent = b
	UI.new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 30, Parent = b })
	local grad = UI.gradient(color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.15))
	grad.Parent = b
	local scale = UI.new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.05), { Scale = 0.94 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

-- muda a cor de um botão criado com UI.button
function UI.setButtonColor(b: TextButton, color: Color3)
	local grad = b:FindFirstChildOfClass("UIGradient")
	if grad then
		grad.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.15))
	end
end

function UI.frame(props)
	local defaults = {
		BackgroundColor3 = UI.Colors.Panel,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props or {}) do
		defaults[k] = v
	end
	local f = UI.new("Frame", defaults)
	UI.corner(props and props.Radius or 14).Parent = f
	if not (props and props.NoStroke) then
		UI.stroke(3).Parent = f
	end
	return f
end

function UI.list(parent: Instance, padding: number?, horizontal: boolean?)
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, padding or 8),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = parent,
	})
end

function UI.scroll(props)
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UI.Colors.Gold,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Selectable = false,
	}
	for k, v in pairs(props or {}) do
		defaults[k] = v
	end
	return UI.new("ScrollingFrame", defaults)
end

-- faixa de brilho que passa pelo botão de tempos em tempos
function UI.shine(button: GuiObject)
	local holder = UI.new("Frame", { Name = "Shine", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = button.ZIndex + 2, Parent = button })
	UI.corner(12).Parent = holder
	local streak = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.55, BorderSizePixel = 0,
		Size = UDim2.new(0.25, 0, 2, 0), Position = UDim2.new(-0.4, 0, -0.5, 0), Rotation = 20, ZIndex = button.ZIndex + 2, Parent = holder })
	UI.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = streak })
	task.spawn(function()
		while holder.Parent do
			streak.Position = UDim2.new(-0.4, 0, -0.5, 0)
			TweenService:Create(streak, TweenInfo.new(0.7, Enum.EasingStyle.Quad), { Position = UDim2.new(1.2, 0, -0.5, 0) }):Play()
			task.wait(3 + math.random())
		end
	end)
end

-- sombra suave atrás de um frame
function UI.shadow(frame: GuiObject)
	local shadow = UI.new("Frame", {
		Name = "Shadow",
		AnchorPoint = frame.AnchorPoint,
		Position = frame.Position + UDim2.fromOffset(6, 8),
		Size = frame.Size,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		ZIndex = frame.ZIndex - 1,
		Visible = frame.Visible,
		Parent = frame.Parent,
	})
	UI.corner(16).Parent = shadow
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		shadow.Visible = frame.Visible
	end)
	return shadow
end

function UI.pop(inst: GuiObject)
	local scale = inst:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = inst })
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[-- Coisas do mundo no cliente: quais botões (E/F) aparecem, barreira de laser,
-- asas batendo, dragões arco-íris, iluminação dos eventos e a seta guia.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)

local WorldController = {}
local player = Players.LocalPlayer

-- ============ Botões de roubar/vender ============

local function setupPrompt(instance: Instance)
	if not instance:IsA("ProximityPrompt") then
		return
	end
	local prompt = instance :: ProximityPrompt
	local kind = prompt:GetAttribute("PromptType")
	local owner = prompt:GetAttribute("OwnerUserId")
	if kind == "Steal" then
		prompt.Enabled = owner ~= player.UserId
	elseif kind == "Sell" then
		prompt.Enabled = owner == player.UserId
	end
end

-- ============ Barreiras ============

local function setupBarrier(barrier: BasePart)
	local function update()
		local locked = barrier:GetAttribute("Locked") == true
		local owner = barrier:GetAttribute("OwnerUserId")
		barrier.CanCollide = locked and owner ~= player.UserId
	end
	barrier:GetAttributeChangedSignal("Locked"):Connect(update)
	barrier:GetAttributeChangedSignal("OwnerUserId"):Connect(update)
	update()
end

-- ============ Animação dos dragões ============

local animated = {} -- [model] = { welds = {{weld, base, side}}, phase, rainbowParts, glitch }

-- eixo do modelo convertido para o espaço do osso (funciona com qualquer orientação do FBX)
local function boneAxis(bone: Bone, root: BasePart, modelAxis: Vector3): Vector3
	local world = root.CFrame:VectorToWorldSpace(modelAxis)
	return bone.WorldCFrame:VectorToObjectSpace(world).Unit
end

local function registerDragon(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local info = { Welds = {}, Bones = {}, Phase = math.random() * math.pi * 2, Colored = {} }
	local root = (model :: Model).PrimaryPart
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Bone") and root then
			local name = d.Name
			local side = root.CFrame:PointToObjectSpace(d.WorldPosition).X >= 0 and 1 or -1
			local tailIndex = tonumber(string.match(name, "^Tail(%d+)$"))
			if string.match(name, "^Wing[LR]1$") then
				table.insert(info.Bones, { Bone = d, Kind = "Wing1", Side = side, Axis = boneAxis(d, root, Vector3.new(0, 0, -1)) })
			elseif string.match(name, "^Wing[LR]2$") then
				table.insert(info.Bones, { Bone = d, Kind = "Wing2", Side = side, Axis = boneAxis(d, root, Vector3.new(0, 0, -1)) })
			elseif tailIndex then
				table.insert(info.Bones, { Bone = d, Kind = "Tail", Index = tailIndex, Axis = boneAxis(d, root, Vector3.new(0, 1, 0)) })
			elseif string.match(name, "^Neck1") or string.match(name, "^Head") then
				table.insert(info.Bones, { Bone = d, Kind = "Neck", Axis = boneAxis(d, root, Vector3.new(1, 0, 0)) })
			end
		elseif d:IsA("Weld") and d.Name == "WingJoint" then
			table.insert(info.Welds, { Weld = d, Base = d.C0, Side = d:GetAttribute("Side") or 1 })
		elseif d:IsA("BasePart") then
			local role = d:GetAttribute("Role")
			if role == "Body" or role == "Wing" or role == "Belly" then
				table.insert(info.Colored, d)
			end
		end
	end
	info.Rainbow = CollectionService:HasTag(model, "Rainbow")
	info.Glitch = CollectionService:HasTag(model, "Glitch")
	animated[model] = info
end

-- ============ Seta guia ============

function WorldController:PointTo(kind: string, value)
	self:ClearPointer()
	local target
	if kind == "Base" then
		local cf = Layout.Bases[value]
		if not cf then
			return
		end
		target = (cf * CFrame.new(0, 3, 0)).Position
	elseif kind == "Position" then
		target = value
	end
	if not target then
		return
	end
	local part = Instance.new("Part")
	part.Name = "GuideTarget"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.Position = target
	part.Parent = workspace
	local a1 = Instance.new("Attachment")
	a1.Parent = part
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(80, 80)
	gui.AlwaysOnTop = true
	gui.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
	gui.Parent = part
	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.Text = "⬇️"
	arrow.TextScaled = true
	arrow.Parent = gui
	self.Pointer = part
	self:AttachBeam()
end

function WorldController:AttachBeam()
	if not self.Pointer then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local a0 = root:FindFirstChild("GuideAttachment") or Instance.new("Attachment")
	a0.Name = "GuideAttachment"
	a0.Parent = root
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = self.Pointer:FindFirstChildOfClass("Attachment")
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(0.3)
	beam.Segments = 1
	beam.Parent = self.Pointer
end

function WorldController:ClearPointer()
	if self.Pointer then
		self.Pointer:Destroy()
		self.Pointer = nil
	end
end

-- ============ Iluminação dos eventos ============

local EVENT_LOOK = {
	[""] = { ClockTime = 14.5, Tint = Color3.new(1, 1, 1), Saturation = 0 },
	ChuvaDeOuro = { ClockTime = 17.2, Tint = Color3.fromRGB(255, 235, 180), Saturation = 0.2 },
	NoiteDeLava = { ClockTime = 0.5, Tint = Color3.fromRGB(255, 170, 140), Saturation = 0.2 },
	HoraLendaria = { ClockTime = 19, Tint = Color3.fromRGB(230, 200, 255), Saturation = 0.25 },
	TempestadeArcoIris = { ClockTime = 12, Tint = Color3.fromRGB(255, 230, 255), Saturation = 0.6 },
	Frenesi = { ClockTime = 13, Tint = Color3.fromRGB(220, 255, 220), Saturation = 0.3 },
}

local function applyEventLook()
	local id = workspace:GetAttribute("EventId") or ""
	local look = EVENT_LOOK[id] or EVENT_LOOK[""]
	local cc = Lighting:FindFirstChild("EventColor")
	if not cc then
		cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "EventColor"
		cc.Parent = Lighting
	end
	TweenService:Create(Lighting, TweenInfo.new(3), { ClockTime = look.ClockTime }):Play()
	TweenService:Create(cc, TweenInfo.new(3), { TintColor = look.Tint, Saturation = look.Saturation }):Play()
end

-- ============ Início ============

function WorldController:Init(App)
	self.App = App
end

function WorldController:Start(App)
	local dragonsFolder = workspace:WaitForChild("Dragons")
	for _, d in ipairs(dragonsFolder:GetDescendants()) do
		setupPrompt(d)
	end
	dragonsFolder.DescendantAdded:Connect(setupPrompt)

	local map = workspace:WaitForChild("Map")
	local bases = map:WaitForChild("Bases")
	for _, base in ipairs(bases:GetChildren()) do
		setupBarrier(base:WaitForChild("Barrier"))
	end

	for _, model in ipairs(CollectionService:GetTagged("Dragon")) do
		registerDragon(model)
	end
	CollectionService:GetInstanceAddedSignal("Dragon"):Connect(function(model)
		task.defer(registerDragon, model)
	end)
	CollectionService:GetInstanceRemovedSignal("Dragon"):Connect(function(model)
		animated[model] = nil
	end)

	workspace:GetAttributeChangedSignal("EventId"):Connect(applyEventLook)
	applyEventLook()

	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		self:AttachBeam()
	end)

	-- marcador "SUA BASE" visível de longe
	App.StateChanged.Event:Connect(function(state)
		if state.BaseIndex and state.BaseIndex > 0 and self.MarkedBase ~= state.BaseIndex then
			self.MarkedBase = state.BaseIndex
			if self.BaseMarker then
				self.BaseMarker:Destroy()
			end
			local base = bases:FindFirstChild("Base" .. state.BaseIndex)
			if base then
				local gui = Instance.new("BillboardGui")
				gui.Name = "MyBaseMarker"
				gui.Size = UDim2.fromOffset(180, 40)
				gui.StudsOffsetWorldSpace = Vector3.new(0, 16, 0)
				gui.AlwaysOnTop = true
				gui.MaxDistance = 1000
				gui.Adornee = base:WaitForChild("Sign")
				local label = Instance.new("TextLabel")
				label.BackgroundTransparency = 1
				label.Size = UDim2.fromScale(1, 1)
				label.Font = Enum.Font.FredokaOne
				label.TextScaled = true
				label.TextColor3 = Color3.fromRGB(255, 230, 90)
				label.TextStrokeTransparency = 0
				label.Text = "🏠 SUA BASE"
				label.Parent = gui
				gui.Parent = App.Gui
				self.BaseMarker = gui
			end
		end
	end)

	-- gradientes de raridade que giram (Lendário+)
	RunService.RenderStepped:Connect(function()
		local rot = (os.clock() * 90) % 360
		for _, g in ipairs(CollectionService:GetTagged("SpinGradient")) do
			g.Rotation = rot
		end
	end)

	-- animação (30x por segundo)
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		if acc < 1 / 30 then
			return
		end
		acc = 0
		local t = os.clock()
		local camera = workspace.CurrentCamera
		local camPos = camera and camera.CFrame.Position or Vector3.zero
		for model, info in pairs(animated) do
			if not model.Parent then
				animated[model] = nil
			else
				local root = model.PrimaryPart
				if root and (root.Position - camPos).Magnitude < 220 then
					local flap = math.sin(t * 5 + info.Phase) * 0.45
					for _, w in ipairs(info.Welds) do
						w.Weld.C0 = w.Base * CFrame.Angles(0, 0, w.Side * flap)
					end
					-- modelos 3D importados: anima os ossos
					for _, b in ipairs(info.Bones) do
						local angle
						if b.Kind == "Wing1" then
							angle = b.Side * flap
						elseif b.Kind == "Wing2" then
							angle = b.Side * math.sin(t * 5 + info.Phase - 0.7) * 0.3
						elseif b.Kind == "Tail" then
							angle = math.sin(t * 2.2 + info.Phase - b.Index * 0.6) * 0.15
						else
							angle = math.sin(t * 1.6 + info.Phase) * 0.06
						end
						b.Bone.Transform = CFrame.fromAxisAngle(b.Axis, angle)
					end
					if info.Rainbow then
						local color = Color3.fromHSV((t * 0.25 + info.Phase) % 1, 0.8, 1)
						for _, p in ipairs(info.Colored) do
							p.Color = color
						end
					elseif info.Glitch and math.random() < 0.15 then
						local color = Color3.fromHSV(math.random(), 1, 1)
						for _, p in ipairs(info.Colored) do
							p.Color = color
						end
					end
				end
			end
		end
	end)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Inicia todos os controladores do cliente.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local App = {
	Player = player,
	State = nil,
	Remotes = Remotes,
	Controllers = {},
	StateChanged = Instance.new("BindableEvent"),
}

function App:Send(action: string, ...)
	Remotes.Action:FireServer(action, ...)
end

local gui = Instance.new("ScreenGui")
gui.Name = "MainGui"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = false
gui.Parent = playerGui
App.Gui = gui

-- escala da interface para celular/tablet
local uiScale = Instance.new("UIScale")
uiScale.Parent = gui
local function updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		uiScale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.15)
	end
end
updateScale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

local folder = script.Parent:WaitForChild("Controllers")
local ORDER = {
	"SoundController",
	"NotifyController",
	"PanelController",
	"HudController",
	"EffectsController",
	"WorldController",
	"TutorialController",
	"GamepadController",
}

for _, name in ipairs(ORDER) do
	App.Controllers[name] = require(folder:WaitForChild(name))
end
for _, name in ipairs(ORDER) do
	local c = App.Controllers[name]
	if c.Init then
		c:Init(App)
	end
end

Remotes.State.OnClientEvent:Connect(function(state)
	App.State = state
	App.StateChanged:Fire(state)
end)

for _, name in ipairs(ORDER) do
	local c = App.Controllers[name]
	if c.Start then
		task.spawn(c.Start, c, App)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="56">
          <Properties>
            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Admin</string>
              <string name="Source"><![CDATA[-- Janela: painel de admin (só aparece para o dono do jogo/admins).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Dragons = require(Shared.Dragons)
local Mutations = require(Shared.Mutations)
local UI = require(script.Parent.Parent.Controllers.UI)

local Admin = {}

local EVENTS = {
	{ "ChuvaDeOuro", "🌟 Chuva de Ouro" },
	{ "NoiteDeLava", "🌋 Noite de Lava" },
	{ "HoraLendaria", "🐉 Hora Lendária" },
	{ "TempestadeArcoIris", "🌈 Arco-Íris" },
	{ "Frenesi", "💰 Frenesi" },
	{ "Stop", "⛔ Parar evento" },
}

function Admin:Build(App, content)
	local scroll = UI.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(215, 50), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = scroll })
	UI.padding(4).Parent = scroll
	local order = 0
	local function add(text, color, fn)
		order += 1
		UI.button({ Text = text, Color = color, LayoutOrder = order, MaxText = 20, Parent = scroll }, fn)
	end
	for _, e in ipairs(EVENTS) do
		add(e[2], UI.Colors.Purple, function()
			App:Send("Admin", "Event", e[1])
		end)
	end
	add("🍀 Sorte servidor 10min", UI.Colors.Green, function()
		App:Send("Admin", "ServerLuck")
	end)
	add("☄️ Meteoros", UI.Colors.Red, function()
		App:Send("Admin", "Meteor")
	end)
	add("🧊 Congelar todos", UI.Colors.Blue, function()
		App:Send("Admin", "FreezeAll")
	end)
	add("🔓 Abrir bases", UI.Colors.Red, function()
		App:Send("Admin", "UnlockAll")
	end)
	add("💰 +1M (você)", UI.Colors.Gold, function()
		App:Send("Admin", "Cash", 1e6)
	end)
	add("💰 +1B (você)", UI.Colors.Gold, function()
		App:Send("Admin", "Cash", 1e9)
	end)

	-- escolher dragão e mutação para soltar na esteira / dar a todos
	local dragonIndex, mutationIndex = #Dragons.List, 1
	order += 1
	local dragonButton = UI.button({ Text = "", Color = UI.Colors.Blue, LayoutOrder = order, MaxText = 18, Parent = scroll })
	order += 1
	local mutationButton = UI.button({ Text = "", Color = UI.Colors.Blue, LayoutOrder = order, MaxText = 18, Parent = scroll })
	local function refresh()
		dragonButton.Text = "🐉 " .. Dragons.List[dragonIndex].Name
		local m = Mutations.List[mutationIndex]
		mutationButton.Text = "✨ Mutação: " .. (m.Name ~= "" and m.Name or "Normal")
	end
	dragonButton.Activated:Connect(function()
		dragonIndex = dragonIndex % #Dragons.List + 1
		refresh()
	end)
	mutationButton.Activated:Connect(function()
		mutationIndex = mutationIndex % #Mutations.List + 1
		refresh()
	end)
	refresh()
	add("➡️ Soltar na esteira", UI.Colors.Green, function()
		App:Send("Admin", "SpawnDragon", Dragons.List[dragonIndex].Id, Mutations.List[mutationIndex].Id)
	end)
	add("🎁 Dar a TODOS", UI.Colors.Gold, function()
		App:Send("Admin", "GiveAllDragon", Dragons.List[dragonIndex].Id)
	end)

	order += 1
	local box = UI.new("TextBox", { Size = UDim2.fromOffset(215, 50), BackgroundColor3 = Color3.fromRGB(20, 15, 30), TextColor3 = Color3.new(1, 1, 1),
		PlaceholderText = "Aviso para todos...", Font = UI.Font, TextScaled = true, Text = "", ClearTextOnFocus = false, LayoutOrder = order, Parent = scroll })
	UI.corner(10).Parent = box
	add("📢 Enviar aviso", UI.Colors.Purple, function()
		if #box.Text > 0 then
			App:Send("Admin", "Announce", box.Text)
			box.Text = ""
		end
	end)
end

return Admin
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Codes</string>
              <string name="Source"><![CDATA[-- Janela: resgatar códigos.

local UI = require(script.Parent.Parent.Controllers.UI)

local Codes = {}

function Codes:Build(App, content)
	UI.label({ Text = "Digite um código para ganhar prêmios!", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 30), Parent = content })
	local box = UI.new("TextBox", {
		Size = UDim2.new(0.7, 0, 0, 56),
		Position = UDim2.new(0.15, 0, 0, 100),
		BackgroundColor3 = Color3.fromRGB(20, 15, 30),
		TextColor3 = Color3.new(1, 1, 1),
		PlaceholderText = "CÓDIGO AQUI",
		PlaceholderColor3 = Color3.fromRGB(140, 140, 150),
		Font = UI.Font,
		TextScaled = true,
		Text = "",
		ClearTextOnFocus = false,
		Parent = content,
	})
	UI.corner(12).Parent = box
	UI.stroke(3).Parent = box
	UI.padding(8).Parent = box
	UI.button({ Text = "RESGATAR", Size = UDim2.fromOffset(240, 56), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 180), Parent = content }, function()
		if #box.Text > 0 then
			App:Send("RedeemCode", box.Text)
			box.Text = ""
		end
	end)
	UI.label({ Text = "👍 Curta e favorite o jogo! Novos códigos a cada atualização.", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 270),
		TextColor3 = UI.Colors.Gold, MaxText = 20, Parent = content })
end

return Codes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[-- Janela: Índice de dragões (coleção). Completar uma raridade dá +5% de renda.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Dragons = require(Shared.Dragons)
local Rarities = require(Shared.Rarities)
local Format = require(Shared.Format)
local Config = require(Shared.Config)
local DragonBuilder = require(Shared.DragonBuilder)
local UI = require(script.Parent.Parent.Controllers.UI)

local Index = {}
local cards = {}
local built = false

function Index:Build(App, content)
	self.App = App
	self.Summary = UI.label({ Text = "", Size = UDim2.new(1, 0, 0, 28), MaxText = 20, Parent = content })
	local scroll = UI.scroll({ Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), Parent = content })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 190), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = scroll })
	UI.padding(4).Parent = scroll
	self.Scroll = scroll
end

function Index:BuildCards()
	if built then
		return
	end
	built = true
	for i, def in ipairs(Dragons.List) do
		local rarity = Rarities.Get(def.Rarity)
		local card = UI.frame({ Size = UDim2.fromOffset(160, 190), BackgroundColor3 = rarity.Color:Lerp(Color3.new(0, 0, 0), 0.6), LayoutOrder = i, Parent = self.Scroll })
		card:FindFirstChildOfClass("UIStroke").Color = rarity.Color
		local vp = UI.new("ViewportFrame", { Size = UDim2.new(1, -12, 0, 110), Position = UDim2.fromOffset(6, 6), BackgroundTransparency = 1,
			Ambient = Color3.fromRGB(200, 200, 200), LightColor = Color3.new(1, 1, 1), Parent = card })
		local model = DragonBuilder.Build(def.Id, "Normal", { NoEffects = true })
		model:PivotTo(CFrame.Angles(0, math.rad(150), 0))
		model.Parent = vp
		local camera = Instance.new("Camera")
		local size = model:GetExtentsSize()
		local center = model:GetBoundingBox().Position
		local dist = math.max(size.X, size.Y, size.Z) * 1.25
		camera.CFrame = CFrame.lookAt(center + Vector3.new(dist * 0.6, dist * 0.35, -dist * 0.8), center)
		camera.FieldOfView = 50
		camera.Parent = vp
		vp.CurrentCamera = camera
		local name = UI.label({ Text = def.Name, Size = UDim2.new(1, -8, 0, 24), Position = UDim2.fromOffset(4, 118), MaxText = 16, Parent = card })
		UI.label({ Text = rarity.Name, Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 142), TextColor3 = rarity.Color, MaxText = 15, Parent = card })
		local income = UI.label({ Text = Format.Cash(def.Income) .. "/s", Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 164),
			TextColor3 = Color3.fromRGB(120, 255, 120), MaxText = 15, Parent = card })
		cards[def.Id] = { Viewport = vp, Name = name, Income = income, Def = def }
	end
end

function Index:OnOpen()
	self:BuildCards()
end

function Index:Update(state)
	if not built then
		return
	end
	local found, total = 0, #Dragons.List
	for id, c in pairs(cards) do
		local known = state.Index[id] == true
		if known then
			found += 1
		end
		c.Viewport.ImageColor3 = known and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
		c.Name.Text = known and c.Def.Name or "???"
		c.Income.Visible = known
	end
	local completed = 0
	for _, rarity in ipairs(Rarities.List) do
		local all = true
		for _, def in ipairs(Dragons.ByRarity[rarity.Id] or {}) do
			if not state.Index[def.Id] then
				all = false
			end
		end
		if all then
			completed += 1
		end
	end
	self.Summary.Text = string.format("Descobertos: %d/%d  •  Raridades completas: %d (bônus +%d%% de renda)", found, total, completed,
		math.floor(completed * Config.IndexBonusPerRarity * 100))
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Rebirth</string>
              <string name="Source"><![CDATA[-- Janela: Rebirth.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rebirths = require(Shared.Rebirths)
local Rarities = require(Shared.Rarities)
local Gear = require(Shared.Gear)
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local UI = require(script.Parent.Parent.Controllers.UI)

local Rebirth = {}

function Rebirth:Build(App, content)
	self.App = App
	self.Current = UI.label({ Text = "Rebirth atual: 0", Size = UDim2.new(1, 0, 0, 36), Parent = content, TextColor3 = UI.Colors.Gold })
	self.Need = UI.label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 44), MaxText = 24, Parent = content })

	local barBack = UI.frame({ Size = UDim2.new(0.8, 0, 0, 30), Position = UDim2.new(0.1, 0, 0, 80), BackgroundColor3 = Color3.fromRGB(20, 15, 30), Parent = content })
	self.Bar = UI.frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = UI.Colors.Green, NoStroke = true, Parent = barBack })
	self.BarText = UI.label({ Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, MaxText = 20, Parent = barBack })

	self.Rarity = UI.label({ Text = "", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 118), MaxText = 20, Parent = content })

	local rewards = UI.frame({ Size = UDim2.new(1, -20, 0, 140), Position = UDim2.fromOffset(10, 154), BackgroundColor3 = UI.Colors.PanelLight, Parent = content })
	UI.label({ Text = "🎁 RECOMPENSAS", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 4), TextColor3 = UI.Colors.Gold, Parent = rewards })
	self.Rewards = UI.label({ Text = "", Size = UDim2.new(1, -20, 0, 96), Position = UDim2.fromOffset(10, 38), TextWrapped = true, MaxText = 20,
		TextYAlignment = Enum.TextYAlignment.Top, Parent = rewards })

	UI.label({ Text = "⚠️ Você perde: dinheiro, dragões e itens comprados com dinheiro.", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 302),
		TextColor3 = Color3.fromRGB(255, 150, 130), MaxText = 18, Parent = content })

	self.Button = UI.button({ Text = "REBIRTH!", Color = UI.Colors.Purple, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.fromOffset(260, 56) , Parent = content }, function()
		App:Send("Rebirth")
	end)
end

function Rebirth:Update(state)
	local nextEntry = Rebirths.List[state.Rebirths + 1]
	self.Current.Text = "Rebirth atual: " .. state.Rebirths .. "  (renda x" .. Rebirths.MultiplierFor(state.Rebirths) .. ")"
	if not nextEntry then
		self.Need.Text = "Você chegou ao Rebirth máximo! 👑"
		self.Bar.Size = UDim2.fromScale(1, 1)
		self.BarText.Text = "MÁXIMO"
		self.Rarity.Text = ""
		self.Rewards.Text = ""
		self.Button.Visible = false
		return
	end
	self.Button.Visible = true
	self.Need.Text = "Próximo: Rebirth " .. (state.Rebirths + 1)
	local progress = math.clamp(state.Cash / nextEntry.Cash, 0, 1)
	self.Bar.Size = UDim2.fromScale(progress, 1)
	self.BarText.Text = Format.Cash(state.Cash) .. " / " .. Format.Cash(nextEntry.Cash)
	if nextEntry.NeedRarity then
		local r = Rarities.Get(nextEntry.NeedRarity)
		self.Rarity.Text = "Precisa de 1 dragão " .. r.Name .. " ou melhor na base"
		self.Rarity.TextColor3 = r.Color
	else
		self.Rarity.Text = ""
	end
	local lines = {
		"💰 Renda x" .. nextEntry.Multiplier,
		"🐉 +" .. Config.SlotsPerRebirth .. " espaço na base",
		"🔒 Trava +" .. Config.LockPerRebirth .. "s",
	}
	if nextEntry.Unlocks then
		table.insert(lines, "🛠️ Libera: " .. Gear.Get(nextEntry.Unlocks).Name)
	end
	self.Rewards.Text = table.concat(lines, "\n")
	UI.setButtonColor(self.Button, progress >= 1 and UI.Colors.Purple or UI.Colors.Gray)
end

return Rebirth
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Rewards</string>
              <string name="Source"><![CDATA[-- Janela: Presentes por tempo jogado + prêmio diário.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rarities = require(Shared.Rarities)
local Format = require(Shared.Format)
local UI = require(script.Parent.Parent.Controllers.UI)

local Rewards = {}
local slots = {}

function Rewards:Build(App, content)
	self.App = App
	local daily = UI.frame({ Size = UDim2.new(1, -10, 0, 70), Position = UDim2.fromOffset(5, 0), BackgroundColor3 = UI.Colors.PanelLight, Parent = content })
	self.DailyText = UI.label({ Text = "📅 Prêmio diário", Size = UDim2.new(1, -230, 1, -16), Position = UDim2.fromOffset(12, 8), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = daily })
	self.DailyButton = UI.button({ Text = "Pegar!", Size = UDim2.fromOffset(200, 52), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Parent = daily }, function()
		App:Send("ClaimDaily")
	end)

	UI.label({ Text = "🎁 Presentes por tempo jogado (reinicia ao entrar de novo)", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 78), MaxText = 18, Parent = content })
	local grid = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -110), Position = UDim2.fromOffset(0, 108), Parent = content })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 150), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = grid })
	for i, reward in ipairs(Config.PlaytimeRewards) do
		local f = UI.frame({ BackgroundColor3 = UI.Colors.PanelLight, LayoutOrder = i, Parent = grid })
		local text
		if reward.Kind == "Cash" then
			text = "💰 " .. Format.Cash(reward.Amount) .. "+"
		else
			local r = Rarities.Get(reward.Rarity)
			text = "🐉 Dragão " .. r.Name
		end
		UI.label({ Text = text, Size = UDim2.new(1, -10, 0, 40), Position = UDim2.fromOffset(5, 8), TextWrapped = true, MaxText = 20, Parent = f })
		local timer = UI.label({ Text = "", Size = UDim2.new(1, -10, 0, 26), Position = UDim2.fromOffset(5, 52), MaxText = 20, TextColor3 = UI.Colors.Gold, Parent = f })
		local b = UI.button({ Text = "Pegar", Size = UDim2.new(1, -20, 0, 44), Position = UDim2.new(0, 10, 1, -52), Parent = f }, function()
			App:Send("ClaimPlaytime", i)
		end)
		slots[i] = { Timer = timer, Button = b }
	end

	RunService.Heartbeat:Connect(function()
		if content.Parent.Visible then
			self:Refresh()
		end
	end)
end

function Rewards:Refresh()
	local state = self.App.State
	if not state or not state.Playtime then
		return
	end
	local elapsed = workspace:GetServerTimeNow() - state.Playtime.JoinTime
	for i, reward in ipairs(Config.PlaytimeRewards) do
		local s = slots[i]
		local claimed = state.Playtime.Claimed[tostring(i)]
		local left = reward.Minutes * 60 - elapsed
		if claimed then
			s.Timer.Text = "✔ Pego"
			s.Button.Visible = false
		elseif left > 0 then
			s.Timer.Text = "⏳ " .. Format.Time(left)
			s.Button.Visible = false
		else
			s.Timer.Text = "PRONTO!"
			s.Button.Visible = true
		end
	end
	local daily = state.Daily
	if daily then
		local day = (daily.Streak % #Config.DailyRewards) + 1
		self.DailyText.Text = "📅 Prêmio diário - Dia " .. day .. " (sequência: " .. daily.Streak .. ")"
		self.DailyButton.Text = daily.CanClaim and "Pegar!" or "Volte amanhã"
		UI.setButtonColor(self.DailyButton, daily.CanClaim and UI.Colors.Green or UI.Colors.Gray)
	end
end

function Rewards:Update()
	self:Refresh()
end

return Rewards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Robux</string>
              <string name="Source"><![CDATA[-- Janela: Loja VIP (gamepasses e produtos de Robux).

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Monetization)
local UI = require(script.Parent.Parent.Controllers.UI)

local Robux = {}
local passButtons = {}
local prices = {} -- [key] = preço real em Robux (vem do Roblox, já com preço regional)
local fetched = false

-- Busca o preço atual do item no Roblox (não fica escrito no código)
local function fetchPrice(id: number, infoType: Enum.InfoType): number?
	if id == 0 then
		return nil
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfoAsync(id, infoType)
	end)
	if not ok then
		ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, infoType)
		end)
	end
	if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
		return info.PriceInRobux
	end
	return nil
end

local function priceText(key: string): string
	local price = prices[key]
	return price and ("R$ " .. price) or "Comprar"
end

local CATEGORY_COLORS = {
	["Dinheiro"] = UI.Colors.Green,
	["Dragões"] = UI.Colors.Gold,
	["Proteção"] = UI.Colors.Blue,
	["Servidor"] = Color3.fromRGB(60, 200, 120),
	["Trollar"] = UI.Colors.Red,
}

local function card(parent, order, title, description, color, buttonText, onClick)
	local f = UI.frame({ Size = UDim2.fromOffset(212, 190), BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.35), LayoutOrder = order, Parent = parent })
	UI.gradient(color:Lerp(Color3.new(0, 0, 0), 0.1), color:Lerp(Color3.new(0, 0, 0), 0.55)).Parent = f
	UI.label({ Text = title, Size = UDim2.new(1, -12, 0, 32), Position = UDim2.fromOffset(6, 6), MaxText = 22, Parent = f })
	UI.label({ Text = description, Size = UDim2.new(1, -16, 0, 84), Position = UDim2.fromOffset(8, 40), TextWrapped = true, MaxText = 15,
		TextColor3 = Color3.fromRGB(235, 235, 240), TextYAlignment = Enum.TextYAlignment.Top, Parent = f })
	local b = UI.button({ Text = buttonText, Color = UI.Colors.Green, Size = UDim2.new(1, -20, 0, 46), Position = UDim2.new(0, 10, 1, -54), Parent = f }, onClick)
	return f, b
end

function Robux:Build(App, content)
	self.App = App
	local tabs = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), Parent = content })
	UI.list(tabs, 10, true)
	local pages = {}
	local function show(name)
		for n, page in pairs(pages) do
			page.Visible = n == name
		end
	end
	UI.button({ Text = "⭐ Passes", Color = UI.Colors.Gold, Size = UDim2.fromOffset(200, 42), Parent = tabs }, function()
		show("Passes")
	end)
	UI.button({ Text = "🛍️ Itens", Color = UI.Colors.Blue, Size = UDim2.fromOffset(200, 42), Parent = tabs }, function()
		show("Products")
	end)

	for _, name in ipairs({ "Passes", "Products" }) do
		local scroll = UI.scroll({ Size = UDim2.new(1, 0, 1, -54), Position = UDim2.fromOffset(0, 54), Visible = name == "Passes", Parent = content })
		UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(212, 190), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = scroll })
		UI.padding(4).Parent = scroll
		pages[name] = scroll
	end

	for i, pass in ipairs(Monetization.Passes) do
		local _, b = card(pages.Passes, i, pass.Name, pass.Description, UI.Colors.Purple, "...", function()
			App:Send("PromptPass", pass.Key)
		end)
		passButtons[pass.Key] = { Button = b, Id = pass.Id }
	end
	for i, product in ipairs(Monetization.Products) do
		local color = CATEGORY_COLORS[product.Category] or UI.Colors.Blue
		local _, b = card(pages.Products, i, product.Name, "[" .. product.Category .. "] " .. product.Description, color, "...", function()
			App:Send("PromptProduct", product.Key)
		end)
		self.ProductButtons = self.ProductButtons or {}
		self.ProductButtons[product.Key] = { Button = b, Id = product.Id }
	end
end

-- Busca os preços ao abrir a loja pela primeira vez
function Robux:OnOpen()
	if fetched then
		return
	end
	fetched = true
	task.spawn(function()
		for key, info in pairs(passButtons) do
			prices[key] = fetchPrice(info.Id, Enum.InfoType.GamePass)
		end
		for key, info in pairs(self.ProductButtons or {}) do
			prices[key] = fetchPrice(info.Id, Enum.InfoType.Product)
			info.Button.Text = priceText(key)
		end
		if self.App.State then
			self:Update(self.App.State)
		end
	end)
end

function Robux:Update(state)
	for key, info in pairs(passButtons) do
		local owned = state.Passes[key]
		info.Button.Text = owned and "✔ Você tem" or priceText(key)
		UI.setButtonColor(info.Button, owned and UI.Colors.Gray or UI.Colors.Green)
	end
end

return Robux
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- Janela: configurações (música e efeitos sonoros).

local UI = require(script.Parent.Parent.Controllers.UI)

local Settings = {}
local toggles = {}

function Settings:Build(App, content)
	self.App = App
	UI.list(content, 16)
	for i, info in ipairs({ { Key = "Music", Text = "🎵 Música" }, { Key = "Sfx", Text = "🔊 Efeitos sonoros" } }) do
		local row = UI.frame({ Size = UDim2.new(1, -20, 0, 70), BackgroundColor3 = UI.Colors.PanelLight, LayoutOrder = i, Parent = content })
		UI.label({ Text = info.Text, Size = UDim2.new(0.6, 0, 1, -16), Position = UDim2.fromOffset(16, 8), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		local b = UI.button({ Text = "LIGADO", Size = UDim2.fromOffset(180, 50), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Parent = row }, function()
			local state = App.State
			if state then
				local current = state.Settings[info.Key] ~= false
				App:Send("SetSetting", info.Key, not current)
			end
		end)
		toggles[info.Key] = b
	end
	self.SaveInfo = UI.label({ Text = "", Size = UDim2.new(1, -20, 0, 30), LayoutOrder = 10, MaxText = 18, Parent = content })
end

function Settings:Update(state)
	for key, b in pairs(toggles) do
		local on = state.Settings[key] ~= false
		b.Text = on and "LIGADO" or "DESLIGADO"
		UI.setButtonColor(b, on and UI.Colors.Green or UI.Colors.Red)
	end
	self.SaveInfo.Text = state.CanSave and "💾 Seu progresso é salvo automaticamente." or "⚠️ Progresso NÃO está sendo salvo."
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Janela: Loja de Equipamentos (dinheiro do jogo).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Gear = require(Shared.Gear)
local Format = require(Shared.Format)
local UI = require(script.Parent.Parent.Controllers.UI)

local Shop = {}
local rows = {}

function Shop:Build(App, content)
	self.App = App
	local scroll = UI.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	UI.list(scroll, 8)
	UI.padding(4).Parent = scroll
	for i, item in ipairs(Gear.List) do
		local row = UI.frame({ Size = UDim2.new(1, -16, 0, 74), BackgroundColor3 = UI.Colors.PanelLight, LayoutOrder = i, Parent = scroll })
		local icon = UI.frame({ Size = UDim2.fromOffset(58, 58), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = item.Color, Parent = row })
		UI.label({ Text = item.Pass and "💎" or "🛠️", Size = UDim2.fromScale(1, 1), Parent = icon })
		UI.label({ Text = item.Name, Size = UDim2.new(1, -280, 0, 30), Position = UDim2.fromOffset(76, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24, Parent = row })
		UI.label({ Text = item.Description, Size = UDim2.new(1, -280, 0, 30), Position = UDim2.fromOffset(76, 38), TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(210, 210, 220), TextWrapped = true, MaxText = 15, Parent = row })
		local button = UI.button({ Text = "", Size = UDim2.fromOffset(180, 52), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Parent = row }, function()
			if item.Pass then
				App:Send("PromptPass", item.Pass)
			else
				App:Send("BuyGear", item.Id)
			end
		end)
		rows[item.Id] = button
	end
end

function Shop:Update(state)
	for _, item in ipairs(Gear.List) do
		local button = rows[item.Id]
		if item.Pass then
			local owned = state.Passes[item.Pass]
			button.Text = owned and "✔ Seu" or "💎 Robux"
			UI.setButtonColor(button, owned and UI.Colors.Gray or UI.Colors.Gold)
		elseif state.Gear[item.Id] then
			button.Text = "✔ Comprado"
			UI.setButtonColor(button, UI.Colors.Gray)
		elseif state.Rebirths < item.Rebirth then
			button.Text = "🔒 Rebirth " .. item.Rebirth
			UI.setButtonColor(button, UI.Colors.Purple)
		else
			button.Text = Format.Cash(item.Price)
			UI.setButtonColor(button, state.Cash >= item.Price and UI.Colors.Green or UI.Colors.Red)
		end
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="65">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>