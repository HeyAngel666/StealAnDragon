          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">ActionService</string>
            <string name="Source"><![CDATA[-- Recebe os pedidos do cliente (com limite anti-spam) e envia mensagens/efeitos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ActionService = {}
local buckets = {} -- [player] = { tokens, last }

local function allow(player: Player): boolean
	local b = buckets[player]
	local t = os.clock()
	if not b then
		b = { Tokens = 10, Last = t }
		buckets[player] = b
	end
	b.Tokens = math.min(10, b.Tokens + (t - b.Last) * 8)
	b.Last = t
	if b.Tokens < 1 then
		return false
	end
	b.Tokens -= 1
	return true
end

-- ============ Mensagens para o cliente ============

function ActionService:Notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function ActionService:NotifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

function ActionService:Alert(player: Player, text: string, color: Color3?)
	Remotes.Alert:FireClient(player, text, color)
end

function ActionService:AlertAll(text: string, color: Color3?)
	Remotes.Alert:FireAllClients(text, color)
end

function ActionService:Effect(player: Player, name: string, data)
	Remotes.Effect:FireClient(player, name, data or {})
end

function ActionService:EffectAll(name: string, data)
	Remotes.Effect:FireAllClients(name, data or {})
end

-- ============ Pedidos do cliente ============

local handlers = {}

function handlers.BuyGear(S, player, gearId)
	if type(gearId) == "string" then
		S.GearService:Buy(player, gearId)
	end
end

function handlers.Rebirth(S, player)
	S.RebirthService:Rebirth(player)
end

function handlers.RedeemCode(S, player, code)
	if type(code) == "string" and #code <= 40 then
		S.RewardService:RedeemCode(player, code)
	end
end

function handlers.ClaimPlaytime(S, player, index)
	if type(index) == "number" then
		S.RewardService:ClaimPlaytime(player, index)
	end
end

function handlers.ClaimDaily(S, player)
	S.RewardService:ClaimDaily(player)
end

function handlers.PromptPass(S, player, key)
	if type(key) == "string" then
		S.MonetizationService:PromptPass(player, key)
	end
end

function handlers.PromptProduct(S, player, key)
	if type(key) == "string" then
		S.MonetizationService:PromptProduct(player, key)
	end
end

function handlers.SetSetting(S, player, key, value)
	local data = S.DataService:Get(player)
	if data and (key == "Music" or key == "Sfx") and type(value) == "boolean" then
		data.Settings[key] = value
		S.StateService:MarkDirty(player)
	end
end

function handlers.TutorialDone(S, player)
	local data = S.DataService:Get(player)
	if data then
		data.TutorialDone = true
		S.StateService:MarkDirty(player)
	end
end

function handlers.CollectAll(S, player)
	if S.BaseService:IsInOwnBase(player) then
		S.DragonService:CollectAll(player)
	end
end

function handlers.Admin(S, player, command, arg1, arg2)
	if type(command) == "string" then
		S.AdminService:Run(player, command, arg1, arg2)
	end
end

function ActionService:Start()
	Remotes.Action.OnServerEvent:Connect(function(player, action, ...)
		if type(action) ~= "string" or not allow(player) then
			return
		end
		local handler = handlers[action]
		if handler and self.Services.DataService:Get(player) then
			local ok, err = pcall(handler, self.Services, player, ...)
			if not ok then
				warn("[ActionService] Erro em", action, err)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return ActionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- Comandos de admin (painel "Admin" na interface). Use para fazer eventos
-- ao vivo ("admin abuse"), que atraem muitos jogadores.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Dragons = require(Shared.Dragons)
local Mutations = require(Shared.Mutations)

local AdminService = {}

local cache = {}

local function check(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		if ok and rank >= 255 then
			return true
		end
	end
	return table.find(Config.AdminUserIds, player.UserId) ~= nil
end

function AdminService:IsAdmin(player: Player): boolean
	if cache[player] == nil then
		cache[player] = check(player)
	end
	return cache[player]
end

function AdminService:Start()
	Players.PlayerRemoving:Connect(function(player)
		cache[player] = nil
	end)
end

function AdminService:Run(player: Player, command: string, arg1, arg2)
	if not self:IsAdmin(player) then
		return
	end
	local S = self.Services
	if command == "Event" then
		if arg1 == "Stop" then
			S.EventService:StopEvent()
		else
			S.EventService:StartEvent(tostring(arg1))
		end
	elseif command == "Cash" then
		local data = S.DataService:Get(player)
		local amount = tonumber(arg1)
		if data and amount then
			data.Cash += amount
		end
	elseif command == "SpawnDragon" then
		local id = tostring(arg1)
		local mut = Mutations.ById[tostring(arg2)] and tostring(arg2) or "Normal"
		if Dragons.Get(id) then
			S.ConveyorService:Spawn(id, mut)
		end
	elseif command == "ServerLuck" then
		S.EventService:AddServerLuck(600, player)
	elseif command == "Meteor" then
		S.EventService:MeteorShower(player)
	elseif command == "FreezeAll" then
		S.EventService:FreezeAll(player)
	elseif command == "UnlockAll" then
		S.EventService:UnlockAll(player)
	elseif command == "Announce" then
		local text = tostring(arg1 or ""):sub(1, 120)
		if #text > 0 then
			local ok, filtered = pcall(function()
				local TextService = game:GetService("TextService")
				return TextService:FilterStringAsync(text, player.UserId):GetNonChatStringForBroadcastAsync()
			end)
			if ok then
				S.ActionService:AlertAll("📢 " .. filtered, Color3.fromRGB(255, 255, 255))
			end
		end
	elseif command == "GiveAllDragon" then
		-- presente para todos no servidor
		local id = tostring(arg1)
		if Dragons.Get(id) then
			for _, p in ipairs(Players:GetPlayers()) do
				S.DragonService:Give(p, id, "Normal")
			end
			S.ActionService:AlertAll("🎁 O ADMIN deu " .. Dragons.Get(id).Name .. " para TODOS!", Color3.fromRGB(255, 220, 80))
		end
	end
	S.StateService:MarkDirty(player)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[-- Bases dos jogadores: dono, espaços, trava (laser), escudo e placas.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Format = require(Shared.Format)

local BaseService = {}
BaseService.Bases = {}
local baseOf = {} -- [player] = base

local function now()
	return workspace:GetServerTimeNow()
end

function BaseService:Init()
	local MapService = self.Services.MapService
	for i, cf in ipairs(Layout.Bases) do
		local model = MapService:GetBaseModel(i)
		local base = {
			Index = i,
			CFrame = cf,
			Model = model,
			Owner = nil,
			LockedUntil = 0,
			ShieldUntil = 0,
			ForcedOpenUntil = 0,
			Slots = {}, -- [slotIndex] = { Uid, Record, Model, Stealing }
			Reserved = {}, -- [slotIndex] = true (dragão voando para o espaço)
		}
		self.Bases[i] = base

		model.LockButton.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and player == base.Owner then
				self:Lock(base)
			end
		end)

		model.Barrier.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and player ~= base.Owner and self:IsLocked(base) then
				self:PushOut(base, player)
			end
		end)

		for _, slot in ipairs(model.Slots:GetChildren()) do
			local slotIndex = slot:GetAttribute("Index")
			slot.Collect.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				if player and player == base.Owner then
					self.Services.DragonService:Collect(player, slotIndex)
				end
			end)
		end
		self:RefreshVisuals(base)
	end
end

function BaseService:Assign(player: Player)
	for _, base in ipairs(self.Bases) do
		if not base.Owner then
			base.Owner = player
			base.Slots = {}
			base.Reserved = {}
			base.LockedUntil = now() + Config.JoinLockDuration
			base.ShieldUntil = 0
			base.ForcedOpenUntil = 0
			baseOf[player] = base
			base.Model:SetAttribute("OwnerUserId", player.UserId)
			player:SetAttribute("BaseIndex", base.Index)
			for _, text in ipairs(base.Model.Sign:GetDescendants()) do
				if text.Name == "OwnerText" then
					text.Text = "BASE DE " .. string.upper(player.DisplayName)
				end
			end
			player.RespawnLocation = base.Model.Spawn
			self:RefreshSlots(player)
			self:RefreshVisuals(base)
			return base
		end
	end
	return nil
end

function BaseService:Free(player: Player)
	local base = baseOf[player]
	if not base then
		return
	end
	baseOf[player] = nil
	base.Owner = nil
	base.Slots = {}
	base.Reserved = {}
	base.LockedUntil = 0
	base.ShieldUntil = 0
	base.Model:SetAttribute("OwnerUserId", nil)
	for _, text in ipairs(base.Model.Sign:GetDescendants()) do
		if text.Name == "OwnerText" then
			text.Text = "BASE LIVRE"
		end
	end
	self:RefreshSlotsFor(base, 0)
	self:RefreshVisuals(base)
end

function BaseService:GetBaseOf(player: Player)
	return baseOf[player]
end

function BaseService:GetBaseAt(position: Vector3)
	for _, base in ipairs(self.Bases) do
		if Layout.IsInsideBase(base.CFrame, position) then
			return base
		end
	end
	return nil
end

function BaseService:IsInOwnBase(player: Player): boolean
	local base = baseOf[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	return base ~= nil and root ~= nil and Layout.IsInsideBase(base.CFrame, root.Position)
end

-- ============ Espaços ============

function BaseService:GetCapacity(player: Player): number
	local data = self.Services.DataService:Get(player)
	if not data then
		return Config.StartSlots
	end
	local slots = Config.StartSlots + data.Rebirths * Config.SlotsPerRebirth
	if self.Services.MonetizationService:HasPass(player, "ExtraSlots") then
		slots += Config.ExtraSlotsPass
	end
	return math.min(slots, Config.MaxSlots)
end

function BaseService:CountDragons(player: Player): number
	local base = baseOf[player]
	if not base then
		return 0
	end
	local n = 0
	for _ in pairs(base.Slots) do
		n += 1
	end
	for _ in pairs(base.Reserved) do
		n += 1
	end
	return n
end

function BaseService:FindFreeSlot(player: Player): number?
	local base = baseOf[player]
	if not base then
		return nil
	end
	local capacity = self:GetCapacity(player)
	for i = 1, capacity do
		if not base.Slots[i] and not base.Reserved[i] then
			return i
		end
	end
	return nil
end

function BaseService:RefreshSlots(player: Player)
	local base = baseOf[player]
	if base then
		self:RefreshSlotsFor(base, self:GetCapacity(player))
	end
end

function BaseService:RefreshSlotsFor(base, capacity: number)
	for _, slot in ipairs(base.Model.Slots:GetChildren()) do
		local i = slot:GetAttribute("Index")
		local unlocked = i <= capacity
		slot.Pedestal.Transparency = unlocked and 0 or 0.75
		slot.Pedestal.Color = unlocked and Color3.fromRGB(235, 235, 240) or Color3.fromRGB(90, 90, 95)
		slot.Collect.Transparency = unlocked and 0 or 1
		slot.Collect.CanTouch = unlocked
	end
end

-- ============ Trava ============

function BaseService:IsLocked(base): boolean
	local t = now()
	if t < base.ForcedOpenUntil then
		return false
	end
	return t < base.LockedUntil or t < base.ShieldUntil
end

function BaseService:Lock(base)
	if not base.Owner or self:IsLocked(base) or now() < base.ForcedOpenUntil then
		return
	end
	local data = self.Services.DataService:Get(base.Owner)
	local rebirths = data and data.Rebirths or 0
	base.LockedUntil = now() + Config.LockDuration + rebirths * Config.LockPerRebirth
	self.Services.ActionService:Effect(base.Owner, "Sound", { Name = "Lock" })
	self.Services.ActionService:Notify(base.Owner, "🔒 Base trancada!", "success")
	self:RefreshVisuals(base)
	self.Services.StateService:MarkDirty(base.Owner)
end

function BaseService:AddShield(player: Player, seconds: number)
	local base = baseOf[player]
	if not base then
		return
	end
	base.ShieldUntil = math.max(base.ShieldUntil, now()) + seconds
	self:RefreshVisuals(base)
end

function BaseService:ForceOpenAll(exceptPlayer: Player?, seconds: number)
	for _, base in ipairs(self.Bases) do
		if base.Owner and base.Owner ~= exceptPlayer then
			base.ForcedOpenUntil = now() + seconds
			self:RefreshVisuals(base)
		end
	end
end

function BaseService:PushOut(base, player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root then
		return
	end
	local entrance = base.CFrame * CFrame.new(0, 3, Layout.BaseSize / 2 + 6)
	local localPos = base.CFrame:PointToObjectSpace(root.Position)
	if localPos.Z < Layout.BaseSize / 2 - 2 then
		-- já está dentro: manda pra fora
		character:PivotTo(CFrame.new(entrance.Position))
	else
		local dir = (entrance.Position - base.CFrame.Position) * Vector3.new(1, 0, 1)
		self.Services.ActionService:Effect(player, "Knockback", { Velocity = dir.Unit * 60 + Vector3.new(0, 25, 0) })
	end
end

function BaseService:RefreshVisuals(base)
	local model = base.Model
	local locked = self:IsLocked(base)
	local t = now()
	model.Barrier.Transparency = locked and 0.35 or 1
	model.Barrier:SetAttribute("Locked", locked)
	model.Barrier:SetAttribute("OwnerUserId", base.Owner and base.Owner.UserId or 0)
	model:SetAttribute("Locked", locked)

	local lockText = model.LockButton.LockGui.Text
	local statusText = model.Sign.StatusGui.Text
	if not base.Owner then
		lockText.Text = ""
		statusText.Text = ""
		model.LockButton.Color = Color3.fromRGB(120, 120, 120)
		return
	end
	if t < base.ForcedOpenUntil then
		lockText.Text = "⚠️ BASES ABERTAS " .. math.ceil(base.ForcedOpenUntil - t) .. "s"
		statusText.Text = "🔓 ABERTA À FORÇA!"
		model.LockButton.Color = Color3.fromRGB(255, 150, 0)
	elseif locked then
		local remaining = math.max(base.LockedUntil, base.ShieldUntil) - t
		lockText.Text = "🔒 " .. Format.Time(remaining)
		statusText.Text = (t < base.ShieldUntil and "🛡️ " or "🔒 ") .. Format.Time(remaining)
		model.LockButton.Color = Color3.fromRGB(220, 60, 60)
	else
		lockText.Text = "🔓 PISE PARA TRANCAR"
		statusText.Text = ""
		model.LockButton.Color = Color3.fromRGB(60, 220, 90)
	end
end

function BaseService:Start()
	local wasLocked = {}
	while true do
		task.wait(0.5)
		for _, base in ipairs(self.Bases) do
			if base.Owner then
				local locked = self:IsLocked(base)
				if wasLocked[base] and not locked then
					self.Services.ActionService:Effect(base.Owner, "Sound", { Name = "Unlock" })
					self.Services.ActionService:Notify(base.Owner, "🔓 Sua base destrancou! Volte e tranque de novo.", "warning")
				end
				wasLocked[base] = locked
				self:RefreshVisuals(base)
			else
				wasLocked[base] = nil
			end
		end
	end
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ConveyorService</string>
            <string name="Source"><![CDATA[-- Esteira central: dragões saem da caverna, andam até o portal e podem ser comprados.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Dragons = require(Shared.Dragons)
local Rarities = require(Shared.Rarities)
local Mutations = require(Shared.Mutations)
local Format = require(Shared.Format)
local DragonBuilder = require(Shared.DragonBuilder)
local RarityStyle = require(Shared.RarityStyle)

local ConveyorService = {}
local active = {} -- lista de { Model, Id, Mut, Price, Distance, Bought }
local rng = Random.new()
local folder

function ConveyorService:Init()
	folder = Instance.new("Folder")
	folder.Name = "ConveyorDragons"
	folder.Parent = workspace
end

function ConveyorService:PriceOf(dragonId: string, mutationId: string): number
	return math.floor(Dragons.Get(dragonId).Price * Mutations.Get(mutationId).Multiplier)
end

function ConveyorService:Spawn(forcedId: string?, forcedMutation: string?)
	local S = self.Services
	local dragonId = forcedId
	if not dragonId then
		local rarity = Dragons.RollRarity(S.EventService:GetLuck(), rng)
		dragonId = Dragons.RandomOfRarity(rarity, rng).Id
	end
	local mutationId = forcedMutation or Mutations.Roll(S.EventService:GetMutationBoosts(), rng)
	local def = Dragons.Get(dragonId)
	local rarity = Rarities.Get(def.Rarity)
	local mutation = Mutations.Get(mutationId)
	local price = self:PriceOf(dragonId, mutationId)

	local model = DragonBuilder.Build(dragonId, mutationId)
	local startCF = CFrame.lookAt(Layout.ConveyorStart, Layout.ConveyorStart + Vector3.new(1, 0, 0))
	model:PivotTo(startCF)

	local entry = { Model = model, Id = dragonId, Mut = mutationId, Price = price, Distance = 0, Bought = false }

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Comprar " .. Format.Cash(price)
	prompt.ObjectText = (mutation.Id ~= "Normal" and (mutation.Name .. " ") or "") .. def.Name .. " [" .. rarity.Name .. "]"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("PromptType", "Buy")
	prompt.Parent = model.Root.PromptAttachment
	prompt.Triggered:Connect(function(player)
		self:Buy(player, entry)
	end)

	-- placa com nome, raridade e preço
	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.fromOffset(220, 80)
	gui.Adornee = model.Root
	gui.StudsOffsetWorldSpace = Vector3.new(0, (model:GetAttribute("Height") or 5) + 2, 0)
	gui.MaxDistance = 90
	gui.Parent = model.Root
	local back = Instance.new("Frame")
	back.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
	back.BackgroundTransparency = 0.35
	back.Size = UDim2.fromScale(1, 1)
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = rarity.Color
	stroke.Parent = back
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Parent = back
	local function line(text, color, order, height)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, height, 0)
		t.Font = Enum.Font.FredokaOne
		t.TextScaled = true
		t.TextStrokeTransparency = 0
		t.TextColor3 = color
		t.Text = text
		t.LayoutOrder = order
		t.Parent = back
		return t
	end
	if mutation.Id ~= "Normal" then
		line(mutation.Name, mutation.Color, 0, 0.22)
	end
	line(def.Name, Color3.new(1, 1, 1), 1, 0.28)
	RarityStyle.Apply(line(rarity.Name, rarity.Color, 2, 0.22), rarity.Id)
	line(Format.Cash(price) .. "  •  " .. Format.Cash(def.Income * mutation.Multiplier) .. "/s", Color3.fromRGB(120, 255, 120), 3, 0.24)

	model.Parent = folder
	table.insert(active, entry)

	local prefix = mutation.Id ~= "Normal" and (mutation.Name .. " ") or ""
	if rarity.Order >= 5 or mutationId == "ArcoIris" then
		S.ActionService:AlertAll(string.format("✨ Um %s%s (%s) apareceu na esteira!", prefix, def.Name, rarity.Name), rarity.Color)
		S.ActionService:EffectAll("Sound", { Name = "Roar" })
	end
	return entry
end

function ConveyorService:Buy(player: Player, entry)
	local S = self.Services
	if entry.Bought or not entry.Model.Parent then
		return
	end
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	if S.StealService:IsCarrying(player) then
		S.ActionService:Notify(player, "Você está carregando um dragão!", "error")
		return
	end
	if data.Cash < entry.Price then
		S.ActionService:Notify(player, "Dinheiro insuficiente! Faltam " .. Format.Cash(entry.Price - data.Cash), "error")
		S.ActionService:Effect(player, "Sound", { Name = "Error" })
		return
	end
	if not S.BaseService:FindFreeSlot(player) then
		S.ActionService:Notify(player, "Sua base está cheia! Venda um dragão ou faça Rebirth.", "error")
		S.ActionService:Effect(player, "Sound", { Name = "Error" })
		return
	end

	entry.Bought = true
	data.Cash -= entry.Price
	local mutationId = entry.Mut
	-- passe de Sorte: chance de subir a mutação
	if S.MonetizationService:HasPass(player, "Luck") and rng:NextNumber() < 0.3 then
		local up = Mutations.UpgradeChain[mutationId]
		if up then
			mutationId = up
			S.ActionService:Notify(player, "🍀 Sorte! Seu dragão virou " .. Mutations.Get(up).Name .. "!", "rare")
		end
	end
	local flyFrom = entry.Model:GetPivot()
	entry.Model:Destroy()
	S.DragonService:Give(player, entry.Id, mutationId, flyFrom)
	S.ActionService:Effect(player, "Sound", { Name = "Buy" })
	S.ActionService:Notify(player, "Você comprou " .. Dragons.Get(entry.Id).Name .. "!", "success")
	S.RewardService:OnTutorialEvent(player, "Bought")
	S.StateService:MarkDirty(player)
end

function ConveyorService:Start()
	local length = (Layout.ConveyorEnd - Layout.ConveyorStart).Magnitude
	local dir = (Layout.ConveyorEnd - Layout.ConveyorStart).Unit

	RunService.Heartbeat:Connect(function(dt)
		local speed = Config.ConveyorSpeed * self.Services.EventService:GetConveyorSpeed()
		for i = #active, 1, -1 do
			local entry = active[i]
			if entry.Bought or not entry.Model.Parent then
				table.remove(active, i)
			else
				entry.Distance += speed * dt
				if entry.Distance >= length then
					entry.Model:Destroy()
					table.remove(active, i)
				else
					local pos = Layout.ConveyorStart + dir * entry.Distance
					entry.Model:PivotTo(CFrame.lookAt(pos, pos + dir))
				end
			end
		end
	end)

	-- preenche a esteira no começo para não ficar vazia
	for i = 1, 12 do
		local entry = self:Spawn()
		entry.Distance = length * (i / 13)
	end

	while true do
		task.wait(Config.ConveyorSpawnInterval / self.Services.EventService:GetSpawnRate())
		if #active < Config.ConveyorMaxDragons and #Players:GetPlayers() > 0 then
			self:Spawn()
		end
	end
end

return ConveyorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Salva e carrega os dados dos jogadores (DataStore), com trava de sessão
-- para evitar perda/duplicação quando o jogador troca de servidor.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}
DataService.Profiles = {} -- [player] = { Data = {...}, CanSave = bool }

local SESSION_TIMEOUT = 300

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponível (ative 'Enable Studio Access to API Services'):", result)
	end
end

local function defaultData()
	return {
		Version = 1,
		Cash = Config.StartingCash,
		Rebirths = 0,
		TotalEarned = 0,
		TotalSteals = 0,
		Dragons = {}, -- [uid] = { Id, Mut, Slot, Stored }
		Gear = {}, -- [gearId] = true
		Index = {}, -- [dragonId] = true
		Codes = {}, -- [code] = true
		Purchases = {}, -- últimos PurchaseIds processados
		TestPasses = {}, -- gamepasses simulados no Studio
		DailyStreak = 0,
		LastDaily = 0,
		LastOnline = 0,
		TutorialDone = false,
		Settings = { Music = true, Sfx = true },
	}
end

local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			if type(v) == "table" then
				data[k] = table.clone(v)
			else
				data[k] = v
			end
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			reconcile(data[k], v)
		end
	end
end

function DataService:NewUid(): string
	return HttpService:GenerateGUID(false)
end

function DataService:Load(player: Player)
	local key = "Player_" .. player.UserId
	local data
	local canSave = store ~= nil

	if store then
		for attempt = 1, 6 do
			local locked = false
			local ok, err = pcall(function()
				store:UpdateAsync(key, function(old)
					old = old or defaultData()
					local session = old.Session
					local now = os.time()
					if session and session.JobId ~= game.JobId and now - (session.Time or 0) < SESSION_TIMEOUT and attempt < 6 then
						locked = true
						return nil
					end
					old.Session = { JobId = game.JobId, Time = now }
					data = old
					return old
				end)
			end)
			if ok and not locked and data then
				break
			end
			if not ok then
				warn("[DataService] Erro ao carregar", player.Name, err)
			end
			data = nil
			if not player.Parent then
				return nil
			end
			task.wait(locked and 5 or 2)
		end
		if not data then
			warn("[DataService] Não foi possível carregar os dados de", player.Name, "- usando dados temporários")
			canSave = false
		end
	end

	data = data or defaultData()
	reconcile(data, defaultData())

	local profile = { Data = data, CanSave = canSave }
	if not player.Parent then
		-- saiu enquanto carregava: libera a trava de sessão
		self.Profiles[player] = profile
		self:Release(player)
		return nil
	end
	self.Profiles[player] = profile
	return profile
end

function DataService:Get(player: Player)
	local profile = self.Profiles[player]
	return profile and profile.Data
end

function DataService:Save(player: Player, release: boolean?)
	local profile = self.Profiles[player]
	if not profile or not profile.CanSave or not store then
		return
	end
	local data = profile.Data
	data.LastOnline = os.time()
	local key = "Player_" .. player.UserId
	for _ = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				if old and old.Session and old.Session.JobId ~= game.JobId then
					-- outro servidor assumiu esses dados; não sobrescrever
					return nil
				end
				data.Session = (not release) and { JobId = game.JobId, Time = os.time() } or nil
				return data
			end)
		end)
		if ok then
			return
		end
		warn("[DataService] Erro ao salvar", player.Name, err)
		task.wait(1)
	end
end

function DataService:Release(player: Player)
	self:Save(player, true)
	self.Profiles[player] = nil
end

function DataService:Start()
	-- salvamento automático
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				if self.Profiles[player] then
					task.spawn(self.Save, self, player)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if self.Profiles[player] then
				pending += 1
				task.spawn(function()
					self.Services.PlayerService:BeforeSave(player)
					self:Save(player, true)
					pending -= 1
				end)
			end
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">DragonService</string>
            <string name="Source"><![CDATA[-- Dragões nas bases: colocar, render dinheiro, coletar, vender e transferir.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Dragons = require(Shared.Dragons)
local Rarities = require(Shared.Rarities)
local Mutations = require(Shared.Mutations)
local Rebirths = require(Shared.Rebirths)
local Format = require(Shared.Format)
local DragonBuilder = require(Shared.DragonBuilder)
local RarityStyle = require(Shared.RarityStyle)

local DragonService = {}
local friendCache = {} -- [player] = { [userId] = bool }

-- ============ Valores ============

function DragonService:BaseIncome(record): number
	local def = Dragons.Get(record.Id)
	if not def then
		return 0
	end
	return def.Income * Mutations.Get(record.Mut).Multiplier
end

function DragonService:SellValue(record): number
	local def = Dragons.Get(record.Id)
	if not def then
		return 0
	end
	return math.floor(def.Price * Mutations.Get(record.Mut).Multiplier * Config.SellRefund)
end

function DragonService:GetFriendBoost(player: Player): number
	local cache = friendCache[player]
	if not cache then
		return 0
	end
	local count = 0
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and cache[other.UserId] then
			count += 1
		end
	end
	return math.min(count * Config.FriendBoostPer, Config.FriendBoostMax)
end

function DragonService:GetIndexBonus(player: Player): number
	local data = self.Services.DataService:Get(player)
	if not data then
		return 0
	end
	local bonus = 0
	for _, rarity in ipairs(Rarities.List) do
		local list = Dragons.ByRarity[rarity.Id]
		local complete = list ~= nil
		for _, def in ipairs(list or {}) do
			if not data.Index[def.Id] then
				complete = false
				break
			end
		end
		if complete then
			bonus += Config.IndexBonusPerRarity
		end
	end
	return bonus
end

function DragonService:GetMultiplier(player: Player): number
	local S = self.Services
	local data = S.DataService:Get(player)
	if not data then
		return 1
	end
	local mult = Rebirths.MultiplierFor(data.Rebirths)
	if S.MonetizationService:HasPass(player, "DoubleCash") then
		mult *= 2
	end
	if S.MonetizationService:HasPass(player, "VIP") then
		mult *= 1.5
	end
	mult *= 1 + self:GetFriendBoost(player) + self:GetIndexBonus(player)
	mult *= S.EventService:GetCashMultiplier()
	return mult
end

function DragonService:GetIncomePerSecond(player: Player): number
	local base = self.Services.BaseService:GetBaseOf(player)
	if not base then
		return 0
	end
	local total = 0
	for _, entry in pairs(base.Slots) do
		if not entry.Stealing then
			total += self:BaseIncome(entry.Record)
		end
	end
	return total * self:GetMultiplier(player)
end

-- ============ Modelo no pedestal ============

local function makePrompt(parent: Instance, actionText: string, objectText: string, hold: number, key: Enum.KeyCode, kind: string, ownerId: number)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.KeyboardKeyCode = key
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("PromptType", kind)
	prompt:SetAttribute("OwnerUserId", ownerId)
	prompt.Parent = parent
	return prompt
end

function DragonService:UpdateInfo(base, slotIndex: number)
	local slot = base.Model.Slots:FindFirstChild("Slot" .. slotIndex)
	if not slot then
		return
	end
	local info = slot.Collect.Info
	local entry = base.Slots[slotIndex]
	if not entry then
		info.Enabled = false
		return
	end
	local def = Dragons.Get(entry.Record.Id)
	local rarity = Rarities.Get(def.Rarity)
	local mutation = Mutations.Get(entry.Record.Mut)
	local frame = info.Frame
	info.Enabled = true
	frame.Mutation.Text = mutation.Id ~= "Normal" and mutation.Name or ""
	frame.Mutation.TextColor3 = mutation.Color or Color3.new(1, 1, 1)
	frame.DragonName.Text = def.Name
	frame.Rarity.Text = rarity.Name
	if frame.Rarity:GetAttribute("RarityId") ~= rarity.Id then
		frame.Rarity:SetAttribute("RarityId", rarity.Id)
		RarityStyle.Apply(frame.Rarity, rarity.Id)
		frame.Stroke.Color = rarity.Color
	end
	frame.Income.Text = Format.Cash(self:BaseIncome(entry.Record) * self:GetMultiplier(base.Owner)) .. "/s"
	if entry.Stealing then
		frame.Stored.Text = "⚠️ SENDO ROUBADO!"
	else
		frame.Stored.Text = "Coletar: " .. Format.Cash(entry.Record.Stored or 0)
	end
end

function DragonService:SpawnModel(player: Player, base, slotIndex: number, uid: string, record, flyFrom: CFrame?)
	local slot = base.Model.Slots["Slot" .. slotIndex]
	local stand = slot.Stand.Value
	local def = Dragons.Get(record.Id)
	local model = DragonBuilder.Build(record.Id, record.Mut)
	model.Name = uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("SlotIndex", slotIndex)

	local attachment = model.Root.PromptAttachment
	local mutation = Mutations.Get(record.Mut)
	local title = (mutation.Id ~= "Normal" and (mutation.Name .. " ") or "") .. def.Name
	makePrompt(attachment, "Roubar", title, Config.StealHoldTime, Enum.KeyCode.E, "Steal", player.UserId)
	makePrompt(attachment, "Vender " .. Format.Cash(self:SellValue(record)), title, 1, Enum.KeyCode.F, "Sell", player.UserId)

	if flyFrom then
		model:PivotTo(flyFrom)
		model.Parent = workspace.Dragons
		-- voa em arco até o pedestal
		local startPos = flyFrom.Position
		local endPos = stand.Position
		local duration = 1.6
		local t0 = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			if not model.Parent then
				conn:Disconnect()
				return
			end
			local a = math.clamp((os.clock() - t0) / duration, 0, 1)
			local pos = startPos:Lerp(endPos, a) + Vector3.new(0, math.sin(a * math.pi) * 25, 0)
			local look = (endPos - startPos) * Vector3.new(1, 0, 1)
			local cf = look.Magnitude > 0.1 and CFrame.lookAt(pos, pos + look) or CFrame.new(pos)
			if a >= 1 then
				conn:Disconnect()
				model:PivotTo(stand)
			else
				model:PivotTo(cf)
			end
		end)
	else
		model:PivotTo(stand)
		model.Parent = workspace.Dragons
	end
	return model
end

-- Coloca um dragão (já salvo em data.Dragons) no espaço indicado
function DragonService:Place(player: Player, uid: string, record, flyFrom: CFrame?)
	local base = self.Services.BaseService:GetBaseOf(player)
	if not base then
		return
	end
	local slotIndex = record.Slot
	local entry = { Uid = uid, Record = record, Model = nil, Stealing = nil }
	base.Slots[slotIndex] = entry
	entry.Model = self:SpawnModel(player, base, slotIndex, uid, record, flyFrom)
	self:UpdateInfo(base, slotIndex)
end

-- Dá um dragão novo ao jogador. Retorna uid ou nil (base cheia)
function DragonService:Give(player: Player, dragonId: string, mutationId: string?, flyFrom: CFrame?)
	local S = self.Services
	local data = S.DataService:Get(player)
	local slotIndex = S.BaseService:FindFreeSlot(player)
	if not data or not slotIndex then
		return nil
	end
	local uid = S.DataService:NewUid()
	local record = { Id = dragonId, Mut = mutationId or "Normal", Slot = slotIndex, Stored = 0 }
	data.Dragons[uid] = record
	local isNew = not data.Index[dragonId]
	data.Index[dragonId] = true
	self:Place(player, uid, record, flyFrom)
	if isNew then
		local def = Dragons.Get(dragonId)
		S.ActionService:Notify(player, "📖 Novo dragão no Índice: " .. def.Name .. "!", "success")
	end
	local def = Dragons.Get(dragonId)
	if Rarities.Get(def.Rarity).Order >= 5 then
		local mutation = Mutations.Get(mutationId)
		S.ActionService:NotifyAll(string.format("🐉 %s conseguiu %s%s (%s)!", player.DisplayName,
			mutation.Id ~= "Normal" and (mutation.Name .. " ") or "", def.Name, Rarities.Get(def.Rarity).Name), "rare")
	end
	S.StateService:MarkDirty(player)
	return uid
end

function DragonService:Remove(player: Player, uid: string)
	local S = self.Services
	local data = S.DataService:Get(player)
	local base = S.BaseService:GetBaseOf(player)
	if not data or not base then
		return nil
	end
	local record = data.Dragons[uid]
	if not record then
		return nil
	end
	data.Dragons[uid] = nil
	local entry = base.Slots[record.Slot]
	if entry and entry.Uid == uid then
		if entry.Model then
			entry.Model:Destroy()
		end
		base.Slots[record.Slot] = nil
	end
	self:UpdateInfo(base, record.Slot)
	S.StateService:MarkDirty(player)
	return record
end

function DragonService:FindEntryByUid(player: Player, uid: string)
	local base = self.Services.BaseService:GetBaseOf(player)
	if not base then
		return nil
	end
	for slotIndex, entry in pairs(base.Slots) do
		if entry.Uid == uid then
			return entry, slotIndex, base
		end
	end
	return nil
end

-- ============ Ações ============

function DragonService:Collect(player: Player, slotIndex: number)
	local S = self.Services
	local base = S.BaseService:GetBaseOf(player)
	local data = S.DataService:Get(player)
	if not base or not data then
		return
	end
	local entry = base.Slots[slotIndex]
	if not entry or entry.Stealing then
		return
	end
	local amount = math.floor(entry.Record.Stored or 0)
	if amount <= 0 then
		return
	end
	entry.Record.Stored = 0
	data.Cash += amount
	self:UpdateInfo(base, slotIndex)
	local slot = base.Model.Slots["Slot" .. slotIndex]
	S.ActionService:Effect(player, "Collect", { Amount = amount, Position = slot.Collect.Position })
	S.StateService:MarkDirty(player)
end

function DragonService:CollectAll(player: Player)
	local base = self.Services.BaseService:GetBaseOf(player)
	if not base then
		return
	end
	for slotIndex in pairs(base.Slots) do
		self:Collect(player, slotIndex)
	end
end

function DragonService:Sell(player: Player, uid: string)
	local S = self.Services
	local entry = self:FindEntryByUid(player, uid)
	if not entry or entry.Stealing then
		return
	end
	local data = S.DataService:Get(player)
	local value = self:SellValue(entry.Record) + math.floor(entry.Record.Stored or 0)
	self:Remove(player, uid)
	data.Cash += value
	S.ActionService:Effect(player, "Sound", { Name = "Coin" })
	S.ActionService:Notify(player, "Vendido por " .. Format.Cash(value), "success")
	S.StateService:MarkDirty(player)
end

-- Carrega todos os dragões salvos ao entrar
function DragonService:LoadAll(player: Player)
	local S = self.Services
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local used = {}
	local toFix = {}
	for uid, record in pairs(data.Dragons) do
		if not Dragons.Get(record.Id) then
			data.Dragons[uid] = nil
		elseif type(record.Slot) ~= "number" or record.Slot < 1 or record.Slot > Config.MaxSlots or used[record.Slot] then
			table.insert(toFix, uid)
		else
			used[record.Slot] = true
		end
	end
	for _, uid in ipairs(toFix) do
		local free
		for i = 1, Config.MaxSlots do
			if not used[i] then
				free = i
				break
			end
		end
		if free then
			used[free] = true
			data.Dragons[uid].Slot = free
		else
			data.Dragons[uid] = nil
		end
	end
	for uid, record in pairs(data.Dragons) do
		self:Place(player, uid, record)
	end
end

function DragonService:ClearModels(player: Player)
	local base = self.Services.BaseService:GetBaseOf(player)
	if not base then
		return
	end
	for slotIndex, entry in pairs(base.Slots) do
		if entry.Model then
			entry.Model:Destroy()
		end
		base.Slots[slotIndex] = nil
		self:UpdateInfo(base, slotIndex)
	end
end

function DragonService:OnPlayerAdded(player: Player)
	friendCache[player] = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			task.spawn(function()
				local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
				if ok and isFriend then
					friendCache[player][other.UserId] = true
					if friendCache[other] then
						friendCache[other][player.UserId] = true
					end
					self.Services.ActionService:Notify(player, "👥 Bônus de amigo! " .. other.DisplayName .. " está no servidor.", "success")
				end
			end)
		end
	end
end

function DragonService:Init()
	local folder = Instance.new("Folder")
	folder.Name = "Dragons"
	folder.Parent = workspace
end

function DragonService:Start()
	Players.PlayerRemoving:Connect(function(player)
		friendCache[player] = nil
	end)

	-- Loop de renda
	while true do
		task.wait(Config.IncomeTick)
		local S = self.Services
		for _, player in ipairs(Players:GetPlayers()) do
			local data = S.DataService:Get(player)
			local base = S.BaseService:GetBaseOf(player)
			if data and base then
				local mult = self:GetMultiplier(player)
				local auto = S.MonetizationService:HasPass(player, "AutoCollect")
				local earned = 0
				for slotIndex, entry in pairs(base.Slots) do
					if not entry.Stealing then
						local income = self:BaseIncome(entry.Record) * mult * Config.IncomeTick
						earned += income
						if auto then
							data.Cash += income
						else
							entry.Record.Stored = (entry.Record.Stored or 0) + income
						end
						self:UpdateInfo(base, slotIndex)
					end
				end
				data.TotalEarned += earned
			end
		end
	end
end

return DragonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- Eventos do servidor: automáticos (a cada ~9 min) e comprados com Robux
-- (sorte do servidor, chuva de meteoros, congelar todos, abrir bases).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local EventService = {}

EventService.Events = {
	{ Id = "ChuvaDeOuro", Name = "🌟 CHUVA DE OURO", Description = "Muito mais dragões de Ouro e Diamante!",
		Mutations = { Ouro = 6, Diamante = 3 } },
	{ Id = "NoiteDeLava", Name = "🌋 NOITE DE LAVA", Description = "Dragões de LAVA (x3) aparecem na esteira!",
		Mutations = { Lava = 1 } },
	{ Id = "HoraLendaria", Name = "🐉 HORA LENDÁRIA", Description = "Sorte x4 para dragões raros!",
		Luck = 4 },
	{ Id = "TempestadeArcoIris", Name = "🌈 TEMPESTADE ARCO-ÍRIS", Description = "Chance de Arco-Íris x8!",
		Mutations = { ArcoIris = 8 } },
	{ Id = "Frenesi", Name = "💰 FRENESI DO DINHEIRO", Description = "Todos ganham dinheiro em dobro!",
		Cash = 2, SpawnRate = 1.5 },
}

local byId = {}
for _, e in ipairs(EventService.Events) do
	byId[e.Id] = e
end

local current = nil
local currentEnds = 0
local serverLuckUntil = 0
local SERVER_LUCK = 3

local function now()
	return workspace:GetServerTimeNow()
end

function EventService:GetCurrent()
	if current and now() < currentEnds then
		return current
	end
	return nil
end

function EventService:GetLuck(): number
	local luck = 1
	local e = self:GetCurrent()
	if e and e.Luck then
		luck *= e.Luck
	end
	if now() < serverLuckUntil then
		luck *= SERVER_LUCK
	end
	return luck
end

function EventService:GetMutationBoosts()
	local e = self:GetCurrent()
	return e and e.Mutations or {}
end

function EventService:GetCashMultiplier(): number
	local e = self:GetCurrent()
	return e and e.Cash or 1
end

function EventService:GetSpawnRate(): number
	local e = self:GetCurrent()
	return e and e.SpawnRate or 1
end

function EventService:GetConveyorSpeed(): number
	local e = self:GetCurrent()
	return e and e.SpawnRate and 1.3 or 1
end

local function publish()
	local e = EventService:GetCurrent()
	workspace:SetAttribute("EventId", e and e.Id or "")
	workspace:SetAttribute("EventName", e and e.Name or "")
	workspace:SetAttribute("EventDescription", e and e.Description or "")
	workspace:SetAttribute("EventEnds", e and currentEnds or 0)
	workspace:SetAttribute("ServerLuckEnds", serverLuckUntil)
end

function EventService:StartEvent(id: string, duration: number?)
	local e = byId[id]
	if not e then
		return false
	end
	current = e
	currentEnds = now() + (duration or Config.EventDuration)
	publish()
	local S = self.Services
	S.ActionService:AlertAll(e.Name .. " COMEÇOU! " .. e.Description, Color3.fromRGB(255, 220, 80))
	S.ActionService:EffectAll("Sound", { Name = "Event" })
	S.StateService:MarkAllDirty()
	return true
end

function EventService:StopEvent()
	current = nil
	currentEnds = 0
	publish()
	self.Services.StateService:MarkAllDirty()
end

-- ============ Produtos de servidor ============

function EventService:AddServerLuck(seconds: number, buyer: Player?)
	serverLuckUntil = math.max(serverLuckUntil, now()) + seconds
	publish()
	local who = buyer and buyer.DisplayName or "Alguém"
	self.Services.ActionService:AlertAll("🍀 " .. who .. " ativou SORTE x3 para o servidor inteiro!", Color3.fromRGB(120, 255, 120))
	self.Services.ActionService:EffectAll("Sound", { Name = "Event" })
end

function EventService:MeteorShower(buyer: Player?)
	local S = self.Services
	local who = buyer and buyer.DisplayName or "Alguém"
	S.ActionService:AlertAll("☄️ " .. who .. " comprou CHUVA DE METEOROS! CORRA!", Color3.fromRGB(255, 120, 40))
	S.ActionService:EffectAll("Sound", { Name = "Event" })
	task.spawn(function()
		local rng = Random.new()
		for _ = 1, 45 do
			-- mira perto de jogadores aleatórios (menos o comprador)
			local targets = {}
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= buyer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					table.insert(targets, p.Character.HumanoidRootPart.Position)
				end
			end
			local pos
			if #targets > 0 and rng:NextNumber() < 0.6 then
				pos = targets[rng:NextInteger(1, #targets)] + Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
			else
				pos = Vector3.new(rng:NextNumber(-180, 180), 0, rng:NextNumber(-100, 100))
			end
			self:DropMeteor(Vector3.new(pos.X, 1, pos.Z), buyer)
			task.wait(0.45)
		end
	end)
end

function EventService:DropMeteor(target: Vector3, buyer: Player?)
	local S = self.Services
	local meteor = Instance.new("Part")
	meteor.Name = "Meteor"
	meteor.Shape = Enum.PartType.Ball
	meteor.Size = Vector3.new(6, 6, 6)
	meteor.Material = Enum.Material.Basalt
	meteor.Color = Color3.fromRGB(60, 40, 30)
	meteor.Anchored = true
	meteor.CanCollide = false
	meteor.CanQuery = false
	meteor.CanTouch = false
	local fire = Instance.new("Fire")
	fire.Size = 10
	fire.Heat = 15
	fire.Parent = meteor
	local startPos = target + Vector3.new(40, 160, 20)
	meteor.Position = startPos
	meteor.Parent = workspace
	S.ActionService:EffectAll("MeteorWarning", { Position = target, Time = 1.2 })
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 1.2 do
			local a = (os.clock() - t0) / 1.2
			meteor.Position = startPos:Lerp(target, a)
			task.wait()
		end
		meteor:Destroy()
		local boom = Instance.new("Explosion")
		boom.Position = target
		boom.BlastRadius = 10
		boom.BlastPressure = 0
		boom.DestroyJointRadiusPercent = 0
		boom.Parent = workspace
		Debris:AddItem(boom, 2)
		S.ActionService:EffectAll("Sound", { Name = "Explosion", Position = target })
		S.ActionService:EffectAll("Shake", { Position = target, Strength = 1 })
		for _, p in ipairs(Players:GetPlayers()) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if p ~= buyer and root and (root.Position - target).Magnitude < 14 then
				local dir = (root.Position - target) * Vector3.new(1, 0, 1)
				dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(1, 0, 0)
				S.GearService:HitPlayer(nil, p, dir * 70 + Vector3.new(0, 60, 0), 1.2)
			end
		end
	end)
end

function EventService:FreezeAll(buyer: Player?)
	local S = self.Services
	local who = buyer and buyer.DisplayName or "Alguém"
	S.ActionService:AlertAll("🧊 " .. who .. " CONGELOU TODO MUNDO!", Color3.fromRGB(120, 220, 255))
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= buyer then
			S.StealService:Interrupt(p, "Você foi congelado e soltou o dragão!")
			S.MovementService:Freeze(p, 8, "Ice")
		end
	end
	S.ActionService:EffectAll("Sound", { Name = "Freeze" })
end

function EventService:UnlockAll(buyer: Player?)
	local S = self.Services
	local who = buyer and buyer.DisplayName or "Alguém"
	S.BaseService:ForceOpenAll(buyer, 30)
	S.ActionService:AlertAll("🔓 " .. who .. " ABRIU TODAS AS BASES POR 30s! HORA DE ROUBAR!", Color3.fromRGB(255, 150, 40))
	S.ActionService:EffectAll("Sound", { Name = "Alarm" })
end

function EventService:Start()
	publish()
	while true do
		task.wait(Config.EventInterval)
		if not self:GetCurrent() and #Players:GetPlayers() > 0 then
			local e = self.Events[math.random(1, #self.Events)]
			self:StartEvent(e.Id)
			task.wait(Config.EventDuration)
			if current == e then
				self:StopEvent()
				self.Services.ActionService:NotifyAll(e.Name .. " terminou!", "info")
			end
		end
	end
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">GearService</string>
            <string name="Source"><![CDATA[-- Equipamentos: loja (dinheiro do jogo), criação das ferramentas e seus efeitos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage.Shared
local Gear = require(Shared.Gear)
local Format = require(Shared.Format)

local GearService = {}
local cooldowns = {} -- [player] = { [gearId] = time }
local traps = {} -- [player] = { parts }

local function now()
	return workspace:GetServerTimeNow()
end

-- ============ Visual das ferramentas ============

local function makeHandle(item)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.CanCollide = false
	handle.Massless = true
	handle.Color = item.Color
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	local kind = item.Kind
	if kind == "Slap" then
		handle.Size = Vector3.new(1.4, 1.8, 0.6)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = handle
		if item.Id == "TapaBuracoNegro" then
			handle.Material = Enum.Material.Neon
			local e = Instance.new("ParticleEmitter")
			e.Color = ColorSequence.new(Color3.fromRGB(150, 60, 255))
			e.LightEmission = 1
			e.Rate = 20
			e.Speed = NumberRange.new(0.5, 1)
			e.Lifetime = NumberRange.new(0.4, 0.8)
			e.Parent = handle
		elseif item.Id == "TapaEsmeralda" then
			handle.Material = Enum.Material.Glass
		elseif item.Id == "TapaFerro" then
			handle.Material = Enum.Material.Metal
		end
	elseif kind == "SpeedCoil" or kind == "GravityCoil" then
		handle.Shape = Enum.PartType.Cylinder
		handle.Size = Vector3.new(1.6, 0.9, 0.9)
		handle.Material = Enum.Material.Neon
	elseif kind == "Trap" then
		handle.Size = Vector3.new(1.6, 0.4, 1.6)
		handle.Material = Enum.Material.Metal
	elseif kind == "Freeze" then
		handle.Size = Vector3.new(0.5, 0.5, 2.2)
		handle.Material = Enum.Material.Neon
	elseif kind == "Invisible" then
		handle.Size = Vector3.new(1.6, 2, 0.2)
		handle.Material = Enum.Material.Fabric
		handle.Transparency = 0.3
	elseif kind == "Ban" then
		handle.Size = Vector3.new(0.5, 3.2, 0.5)
		handle.Material = Enum.Material.Wood
		local head = Instance.new("Part")
		head.Name = "HammerHead"
		head.Size = Vector3.new(2.2, 1.2, 1.2)
		head.Color = item.Color
		head.Material = Enum.Material.Neon
		head.CanCollide = false
		head.Massless = true
		head.CFrame = handle.CFrame * CFrame.new(0, 1.6, 0)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = head
		weld.Parent = head
		head.Parent = handle
	else
		handle.Size = Vector3.new(1, 1, 1)
	end
	return handle
end

function GearService:CreateTool(item)
	local tool = Instance.new("Tool")
	tool.Name = item.Name
	tool.ToolTip = item.Description
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("GearId", item.Id)
	local handle = makeHandle(item)
	handle.Parent = tool
	if item.Kind == "Ban" then
		tool.GripPos = Vector3.new(0, -1, 0)
	end
	tool.Equipped:Connect(function()
		local player = Players:GetPlayerFromCharacter(tool.Parent)
		if player then
			self:OnEquipped(player, item, true)
		end
	end)
	tool.Unequipped:Connect(function()
		local player = tool:FindFirstAncestorOfClass("Player")
		if player then
			self:OnEquipped(player, item, false)
		end
	end)
	tool.Activated:Connect(function()
		local player = Players:GetPlayerFromCharacter(tool.Parent)
		if player then
			self:Activate(player, item)
		end
	end)
	return tool
end

-- ============ Inventário ============

function GearService:OwnedGear(player: Player)
	local S = self.Services
	local data = S.DataService:Get(player)
	local owned = {}
	if not data then
		return owned
	end
	for _, item in ipairs(Gear.List) do
		if item.Pass then
			if S.MonetizationService:HasPass(player, item.Pass) then
				table.insert(owned, item)
			end
		elseif data.Gear[item.Id] then
			table.insert(owned, item)
		end
	end
	return owned
end

function GearService:GiveTools(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local have = {}
	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") and tool:GetAttribute("GearId") then
					have[tool:GetAttribute("GearId")] = tool
				end
			end
		end
	end
	local ownedIds = {}
	for _, item in ipairs(self:OwnedGear(player)) do
		ownedIds[item.Id] = true
		if not have[item.Id] then
			self:CreateTool(item).Parent = backpack
		end
	end
	-- remove ferramentas que o jogador não tem mais (ex.: depois do rebirth)
	for id, tool in pairs(have) do
		if not ownedIds[id] then
			tool:Destroy()
		end
	end
end

function GearService:Buy(player: Player, gearId: string)
	local S = self.Services
	local item = Gear.Get(gearId)
	local data = S.DataService:Get(player)
	if not item or not data or item.Pass then
		return
	end
	if data.Gear[gearId] then
		return S.ActionService:Notify(player, "Você já tem esse item.", "info")
	end
	if data.Rebirths < item.Rebirth then
		return S.ActionService:Notify(player, "Precisa de Rebirth " .. item.Rebirth .. "!", "error")
	end
	if data.Cash < item.Price then
		S.ActionService:Effect(player, "Sound", { Name = "Error" })
		return S.ActionService:Notify(player, "Dinheiro insuficiente! Faltam " .. Format.Cash(item.Price - data.Cash), "error")
	end
	data.Cash -= item.Price
	data.Gear[gearId] = true
	self:GiveTools(player)
	S.ActionService:Effect(player, "Sound", { Name = "Buy" })
	S.ActionService:Notify(player, "Comprou " .. item.Name .. "! Está na sua mochila.", "success")
	S.StateService:MarkDirty(player)
end

-- ============ Efeitos ============

function GearService:OnEquipped(player: Player, item, equipped: boolean)
	local S = self.Services
	if equipped and S.StealService:IsCarrying(player) then
		task.defer(function()
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:UnequipTools()
			end
		end)
		S.ActionService:Notify(player, "Não dá pra usar itens carregando um dragão!", "error")
		return
	end
	if item.Kind == "SpeedCoil" or item.Kind == "GravityCoil" then
		S.MovementService:SetCoil(player, item.Kind, equipped)
	end
end

local function findTarget(player: Player, range: number, minDot: number)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local best, bestDist = nil, range
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.Character then
			local oroot = other.Character:FindFirstChild("HumanoidRootPart")
			local ohum = other.Character:FindFirstChildOfClass("Humanoid")
			if oroot and ohum and ohum.Health > 0 then
				local offset = oroot.Position - root.Position
				local dist = offset.Magnitude
				if dist < bestDist then
					local dot = dist > 0.1 and root.CFrame.LookVector:Dot(offset.Unit) or 1
					if dot >= minDot then
						best, bestDist = other, dist
					end
				end
			end
		end
	end
	return best
end

function GearService:Activate(player: Player, item)
	local S = self.Services
	if S.StealService:IsCarrying(player) or S.MovementService:IsFrozen(player) then
		return
	end
	cooldowns[player] = cooldowns[player] or {}
	local t = now()
	if (cooldowns[player][item.Id] or 0) > t then
		return
	end
	if item.Cooldown and item.Cooldown > 0 then
		cooldowns[player][item.Id] = t + item.Cooldown
		S.ActionService:Effect(player, "Cooldown", { Gear = item.Id, Duration = item.Cooldown })
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	if item.Kind == "Slap" then
		S.ActionService:EffectAll("Sound", { Name = "Slap", Position = root.Position })
		S.ActionService:Effect(player, "Swing", {})
		local target = findTarget(player, item.Range, 0.2)
		if target then
			self:HitPlayer(player, target, root.CFrame.LookVector * item.Power + Vector3.new(0, item.Power * 0.45, 0), item.Stun)
		end
	elseif item.Kind == "Trap" then
		self:PlaceTrap(player, item, root.Position - Vector3.new(0, 2.8, 0))
	elseif item.Kind == "Freeze" then
		local target = findTarget(player, item.Range, 0.5)
		if target then
			local troot = target.Character.HumanoidRootPart
			S.ActionService:EffectAll("Beam", { From = root.Position, To = troot.Position, Color = item.Color })
			S.ActionService:EffectAll("Sound", { Name = "Freeze", Position = troot.Position })
			S.StealService:Interrupt(target, "Você foi congelado e soltou o dragão!")
			S.MovementService:Freeze(target, item.Duration, item.Visual)
		else
			S.ActionService:Notify(player, "Ninguém na mira!", "info")
			cooldowns[player][item.Id] = t + 1
		end
	elseif item.Kind == "Invisible" then
		S.MovementService:SetInvisible(player, item.Duration)
		S.ActionService:Notify(player, "👻 Você está invisível!", "info")
	elseif item.Kind == "Ban" then
		local target = findTarget(player, item.Range, 0.2)
		S.ActionService:EffectAll("Sound", { Name = "Slap", Position = root.Position })
		S.ActionService:Effect(player, "Swing", {})
		if target then
			S.StealService:Interrupt(target, "BANIDO! 🔨 O dragão voltou.")
			local tbase = S.BaseService:GetBaseOf(target)
			if tbase and target.Character then
				target.Character:PivotTo(tbase.Model.Spawn.CFrame + Vector3.new(0, 4, 0))
			end
			S.MovementService:Freeze(target, 1.5, nil)
			S.ActionService:Alert(target, "🔨 VOCÊ FOI BANIDO por " .. player.DisplayName .. "! (de volta pra base)", Color3.fromRGB(255, 80, 80))
			S.ActionService:NotifyAll("🔨 " .. player.DisplayName .. " baniu " .. target.DisplayName .. " com o Martelo do Banimento!", "rare")
		else
			cooldowns[player][item.Id] = t + 1
		end
	end
end

-- Empurra um jogador e faz ele soltar o dragão
function GearService:HitPlayer(attacker: Player?, target: Player, velocity: Vector3, stun: number?)
	local S = self.Services
	S.StealService:Interrupt(target, attacker and ("Você levou um tapa de " .. attacker.DisplayName .. "!") or "Você foi atingido!")
	S.ActionService:Effect(target, "Knockback", { Velocity = velocity, Ragdoll = (stun or 0) > 0 and stun or 0.6 })
	if stun and stun > 0 then
		S.MovementService:Freeze(target, stun, nil)
	end
end

function GearService:PlaceTrap(player: Player, item, position: Vector3)
	traps[player] = traps[player] or {}
	local list = traps[player]
	if #list >= 2 then
		local old = table.remove(list, 1)
		if old then
			old:Destroy()
		end
	end
	local trap = Instance.new("Part")
	trap.Name = "Trap"
	trap.Anchored = true
	trap.CanCollide = false
	trap.Size = Vector3.new(4, 0.4, 4)
	trap.Shape = Enum.PartType.Cylinder
	trap.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	trap.Size = Vector3.new(0.4, 4, 4)
	trap.Color = Color3.fromRGB(90, 90, 95)
	trap.Material = Enum.Material.DiamondPlate
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local tooth = Instance.new("WedgePart")
		tooth.Size = Vector3.new(0.3, 0.7, 0.5)
		tooth.Anchored = true
		tooth.CanCollide = false
		tooth.CanTouch = false
		tooth.Color = Color3.fromRGB(200, 200, 210)
		tooth.Material = Enum.Material.Metal
		tooth.CFrame = CFrame.new(position + Vector3.new(math.cos(a) * 1.6, 0.5, math.sin(a) * 1.6)) * CFrame.Angles(0, -a, 0)
		tooth.Parent = trap
	end
	trap.Parent = workspace
	table.insert(list, trap)
	local used = false
	trap.Touched:Connect(function(hit)
		if used then
			return
		end
		local victim = Players:GetPlayerFromCharacter(hit.Parent)
		if victim and victim ~= player then
			used = true
			local S = self.Services
			S.StealService:Interrupt(victim, "Você pisou numa armadilha!")
			S.MovementService:Freeze(victim, item.Duration, "Web")
			S.ActionService:EffectAll("Sound", { Name = "Freeze", Position = trap.Position })
			S.ActionService:Notify(player, "🪤 " .. victim.DisplayName .. " caiu na sua armadilha!", "success")
			trap:Destroy()
		end
	end)
	Debris:AddItem(trap, 60)
end

function GearService:Start()
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
		for _, trap in ipairs(traps[player] or {}) do
			trap:Destroy()
		end
		traps[player] = nil
	end)
end

return GearService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Rankings globais (todos os servidores): mais ricos e mais roubos.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local LeaderboardService = {}
local stores = {}
local nameCache = {}

local BOARDS = {
	{ Key = "TopMoney", Store = "TopEarned", Field = "TotalEarned", Prefix = "$" },
	{ Key = "TopSteals", Store = "TopSteals", Field = "TotalSteals", Prefix = "" },
}

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	name = ok and name or "???"
	nameCache[userId] = name
	return name
end

function LeaderboardService:Init()
	for _, b in ipairs(BOARDS) do
		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Config.DataStoreName .. "_" .. b.Store)
		if ok then
			stores[b.Key] = store
		end
	end
end

function LeaderboardService:SubmitPlayer(player: Player)
	local data = self.Services.DataService:Get(player)
	if not data then
		return
	end
	for _, b in ipairs(BOARDS) do
		local store = stores[b.Key]
		if store then
			-- OrderedDataStore só aceita inteiros; dinheiro guardado em "milhares" para caber
			local value = data[b.Field] or 0
			if b.Field == "TotalEarned" then
				value = math.floor(value / 1000)
			end
			task.spawn(pcall, store.SetAsync, store, "Player_" .. player.UserId, math.clamp(math.floor(value), 0, 2 ^ 52))
		end
	end
end

function LeaderboardService:Refresh()
	local plaza = workspace.Map:FindFirstChild("Plaza")
	if not plaza then
		return
	end
	for _, b in ipairs(BOARDS) do
		local store = stores[b.Key]
		local board = plaza:FindFirstChild(b.Key)
		if store and board then
			local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
			if ok then
				local entries = pages:GetCurrentPage()
				local list = board.BoardGui.List
				for i = 1, 10 do
					local row = list:FindFirstChild("Row" .. i)
					local entry = entries[i]
					if entry then
						local userId = tonumber((entry.key:gsub("Player_", "")))
						local value = entry.value
						if b.Field == "TotalEarned" then
							value *= 1000
						end
						row.Text = string.format("%d. %s  -  %s%s", i, userId and getName(userId) or "?", b.Prefix, Format.Number(value))
					else
						row.Text = i .. ". ---"
					end
				end
			end
		end
	end
end

function LeaderboardService:Start()
	task.wait(10)
	while true do
		for _, player in ipairs(Players:GetPlayers()) do
			self:SubmitPlayer(player)
		end
		task.wait(5)
		self:Refresh()
		task.wait(175)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[-- Constrói o mapa inteiro por código: chão, esteira, caverna, portal, 8 bases,
-- praça com lojas e rankings, decoração e iluminação.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)
local DragonBuilder = require(Shared.DragonBuilder)

local MapService = {}

local FLOOR_TOP = 1

local BASE_COLORS = {
	Color3.fromRGB(220, 80, 80),
	Color3.fromRGB(80, 140, 230),
	Color3.fromRGB(90, 200, 110),
	Color3.fromRGB(240, 190, 60),
	Color3.fromRGB(170, 100, 230),
	Color3.fromRGB(240, 130, 50),
	Color3.fromRGB(70, 200, 210),
	Color3.fromRGB(240, 110, 180),
}

local rng = Random.new(1234)

local function P(props)
	local className = props.ClassName or "Part"
	local p = Instance.new(className)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "ClassName" and k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function label(parent: Instance, text: string, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.Text = text
	for k, v in pairs(props or {}) do
		t[k] = v
	end
	t.Parent = parent
	return t
end

local function surfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	local t = label(gui, text, { TextColor3 = color or Color3.new(1, 1, 1) })
	return gui, t
end

-- ===================== Terreno e decoração =====================

local Terrain = workspace.Terrain

local function buildTree(parent: Instance, pos: Vector3, scale: number)
	local trunkH = 8 * scale
	P({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(trunkH, 1.8 * scale, 1.8 * scale),
		CFrame = CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(120, 80, 50), Material = Enum.Material.Wood, Parent = parent })
	local hue = rng:NextNumber(0.24, 0.33)
	local top = pos + Vector3.new(0, trunkH, 0)
	-- copa arredondada com várias bolas
	local offsets = { Vector3.new(0, 1.5, 0), Vector3.new(2.2, 0, 0.6), Vector3.new(-2, 0.3, -0.8), Vector3.new(0.4, 0.2, 2.2), Vector3.new(-0.6, 0, -2.2), Vector3.new(0, 3.4, 0) }
	for i, o in ipairs(offsets) do
		local d = (i == #offsets and 4.5 or 6) * scale * rng:NextNumber(0.85, 1.1)
		P({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), Position = top + o * scale,
			Color = Color3.fromHSV(hue, 0.6, rng:NextNumber(0.55, 0.75)), Material = Enum.Material.Grass, Parent = parent })
	end
end

local FLOWER_COLORS = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 60), Color3.fromRGB(150, 110, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(90, 180, 255) }

local function buildFlowers(parent: Instance, center: Vector3, radius: number, count: number)
	for _ = 1, count do
		local pos = center + Vector3.new(rng:NextNumber(-radius, radius), 0, rng:NextNumber(-radius, radius))
		P({ Name = "Stem", Size = Vector3.new(0.2, 1, 0.2), Position = pos + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(60, 150, 60), CanCollide = false, Parent = parent })
		P({ Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), Position = pos + Vector3.new(0, 1.1, 0),
			Color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = parent })
	end
end

local GRASS = Color3.fromRGB(95, 200, 70)

local function buildTerrain(parent: Instance)
	Terrain:Clear()
	-- chão verde liso, estilo clássico
	P({ Name = "Ground", Size = Vector3.new(1000, 4, 800), Position = Vector3.new(20, -2, 0), Color = GRASS, Material = Enum.Material.SmoothPlastic, Parent = parent })
	-- faixas de grama um pouco mais clara (efeito de gramado cortado)
	for i = -9, 9 do
		if i % 2 == 0 then
			P({ Name = "GrassStripe", Size = Vector3.new(1000, 0.05, 20), Position = Vector3.new(20, 0.025, i * 40), Color = GRASS:Lerp(Color3.new(1, 1, 1), 0.08),
				Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = parent })
		end
	end
end

-- ===================== Esteira, caverna e portal =====================

local function buildConveyor(map: Instance)
	local folder = Instance.new("Model")
	folder.Name = "Conveyor"
	folder.Parent = map

	local startX, endX = Layout.ConveyorStart.X, Layout.ConveyorEnd.X
	local length = endX - startX
	local width = Layout.ConveyorWidth
	-- tapete vermelho (onde os dragões andam)
	P({ Name = "Belt", Size = Vector3.new(length, 1, width), Position = Vector3.new((startX + endX) / 2, 0.5, 0),
		Color = Color3.fromRGB(205, 35, 35), Material = Enum.Material.SmoothPlastic, Parent = folder })
	P({ Name = "BeltCenter", Size = Vector3.new(length, 0.05, width - 4), Position = Vector3.new((startX + endX) / 2, 1.03, 0),
		Color = Color3.fromRGB(225, 50, 50), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = folder })
	for _, side in ipairs({ -1, 1 }) do
		P({ Name = "Edge", Size = Vector3.new(length, 1.4, 1), Position = Vector3.new((startX + endX) / 2, 0.7, side * (width / 2 + 0.5)),
			Color = Color3.fromRGB(245, 245, 245), Material = Enum.Material.SmoothPlastic, Parent = folder })
	end
	-- calçada cinza clara dos dois lados do tapete
	for _, side in ipairs({ -1, 1 }) do
		P({ Name = "Sidewalk", Size = Vector3.new(length + 60, 0.4, 10), Position = Vector3.new((startX + endX) / 2 + 20, 0.2, side * (width / 2 + 6)),
			Color = Color3.fromRGB(200, 200, 205), Material = Enum.Material.SmoothPlastic, Parent = folder })
	end

	-- Caverna (onde os dragões nascem)
	local cave = Instance.new("Model")
	cave.Name = "Cave"
	cave.Parent = map
	local cx = startX - 8
	local rockColor = Color3.fromRGB(150, 145, 140)
	P({ Size = Vector3.new(26, 30, 12), Position = Vector3.new(cx - 6, 15, -19), Color = rockColor, Material = Enum.Material.Slate, Parent = cave })
	P({ Size = Vector3.new(26, 30, 12), Position = Vector3.new(cx - 6, 15, 19), Color = rockColor, Material = Enum.Material.Slate, Parent = cave })
	P({ Size = Vector3.new(26, 12, 50), Position = Vector3.new(cx - 6, 24, 0), Color = rockColor, Material = Enum.Material.Slate, Parent = cave })
	P({ Size = Vector3.new(4, 20, 30), Position = Vector3.new(cx - 18, 10, 0), Color = Color3.fromRGB(10, 5, 5), Material = Enum.Material.Slate, Parent = cave })
	local glow = P({ Size = Vector3.new(1, 16, 22), Position = Vector3.new(cx - 15, 9, 0), Color = Color3.fromRGB(255, 80, 20), Material = Enum.Material.Neon,
		Transparency = 0.5, CanCollide = false, Parent = cave })
	local caveLight = Instance.new("PointLight")
	caveLight.Range = 30
	caveLight.Color = Color3.fromRGB(255, 100, 40)
	caveLight.Brightness = 2
	caveLight.Parent = glow
	local sign = P({ Size = Vector3.new(30, 6, 1), Position = Vector3.new(cx + 7.5, 33, 0), Color = Color3.fromRGB(60, 35, 25), Material = Enum.Material.Wood,
		CFrame = CFrame.new(cx + 7.5, 33, 0) * CFrame.Angles(0, math.pi / 2, 0), Parent = cave })
	surfaceText(sign, Enum.NormalId.Back, "NINHO DOS DRAGÕES", Color3.fromRGB(255, 200, 80))
	surfaceText(sign, Enum.NormalId.Front, "NINHO DOS DRAGÕES", Color3.fromRGB(255, 200, 80))

	-- Portal (onde os dragões vão embora)
	local portal = Instance.new("Model")
	portal.Name = "Portal"
	portal.Parent = map
	local px = endX + 4
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		P({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), Position = Vector3.new(px, 10 + math.sin(a) * 9, math.cos(a) * 9),
			Color = Color3.fromRGB(170, 80, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = portal })
	end
	local core = P({ Size = Vector3.new(0.5, 16, 16), Position = Vector3.new(px, 10, 0), Color = Color3.fromRGB(120, 40, 220), Material = Enum.Material.Neon,
		Transparency = 0.55, CanCollide = false, Parent = portal })
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(200, 120, 255))
	pe.LightEmission = 1
	pe.Rate = 25
	pe.Speed = NumberRange.new(2, 5)
	pe.Lifetime = NumberRange.new(1, 2)
	pe.Parent = core
end

-- ===================== Bases =====================

local BASE_RED = Color3.fromRGB(200, 40, 35)
local BASE_RED_DARK = Color3.fromRGB(160, 28, 25)
local TRIM = Color3.fromRGB(250, 250, 250)
local FLOOR_COLOR = Color3.fromRGB(235, 232, 225)

local function buildBase(map: Instance, index: number, baseCF: CFrame)
	local model = Instance.new("Model")
	model.Name = "Base" .. index
	model:SetAttribute("Index", index)
	model.Parent = map

	local accent = BASE_COLORS[index]
	local half = Layout.BaseSize / 2
	local h = Layout.BaseWallHeight
	local up = Layout.UpperFloorY
	local stairsW = Layout.StairsWidth
	local function at(x, y, z)
		return baseCF * CFrame.new(x, y, z)
	end
	local function box(name, size, cf, color, extra)
		local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = Enum.Material.SmoothPlastic, Parent = model }
		for k, v in pairs(extra or {}) do
			props[k] = v
		end
		return P(props)
	end

	-- piso do térreo
	local floor = box("Floor", Vector3.new(Layout.BaseSize, 1, Layout.BaseSize), at(0, 0.5, 0), FLOOR_COLOR)
	floor:SetAttribute("BaseIndex", index)
	box("Aisle", Vector3.new(14, 0.1, Layout.BaseSize - 6), at(0, FLOOR_TOP + 0.05, 0), BASE_RED, { CanCollide = false })

	-- paredes vermelhas (fundo e laterais, altura dos 2 andares)
	local wallT = 2
	local totalH = up + 1 + 9
	box("Wall", Vector3.new(Layout.BaseSize, totalH, wallT), at(0, FLOOR_TOP + totalH / 2, -half + wallT / 2), BASE_RED)
	for _, side in ipairs({ -1, 1 }) do
		box("Wall", Vector3.new(wallT, totalH, Layout.BaseSize), at(side * (half - wallT / 2), FLOOR_TOP + totalH / 2, 0), BASE_RED)
		local segW = half - Layout.EntranceWidth / 2
		if segW > 0.5 then
			box("Wall", Vector3.new(segW, h, wallT), at(side * (Layout.EntranceWidth / 2 + segW / 2), FLOOR_TOP + h / 2, half - wallT / 2), BASE_RED)
		end
	end

	-- faixas brancas horizontais (base, meio e topo) por fora
	for _, y in ipairs({ FLOOR_TOP + 0.75, FLOOR_TOP + up, FLOOR_TOP + totalH - 0.6 }) do
		box("Trim", Vector3.new(Layout.BaseSize + 0.6, 1.5, 0.6), at(0, y, -half - 0.1), TRIM)
		for _, side in ipairs({ -1, 1 }) do
			box("Trim", Vector3.new(0.6, 1.5, Layout.BaseSize + 0.6), at(side * (half + 0.1), y, 0), TRIM)
		end
		box("Trim", Vector3.new(Layout.BaseSize + 0.6, 1.5, 0.6), at(0, y, half + 0.1), TRIM)
	end
	-- colunas brancas nos cantos e ao lado da entrada
	for _, x in ipairs({ -half, half, -Layout.EntranceWidth / 2 - 0.6, Layout.EntranceWidth / 2 + 0.6 }) do
		box("Post", Vector3.new(1.4, totalH, 1.4), at(x, FLOOR_TOP + totalH / 2, half), TRIM)
	end
	for _, x in ipairs({ -half, half }) do
		box("Post", Vector3.new(1.4, totalH, 1.4), at(x, FLOOR_TOP + totalH / 2, -half), TRIM)
	end
	-- "prateleiras" brancas na parede de fundo (detalhe da casinha)
	for _, y in ipairs({ FLOOR_TOP + 6, FLOOR_TOP + up + 5 }) do
		box("Shelf", Vector3.new(Layout.BaseSize - 6, 0.6, 1.2), at(0, y, -half + wallT + 0.6), TRIM)
	end

	-- 2º andar (com buraco sobre a escada)
	local slabY = FLOOR_TOP + up - 0.5
	local inner = Layout.BaseSize - 2 * wallT
	local sideW = inner / 2 - stairsW / 2
	for _, side in ipairs({ -1, 1 }) do
		box("UpperFloor", Vector3.new(sideW, 1, inner), at(side * (stairsW / 2 + sideW / 2), slabY, 0), FLOOR_COLOR)
	end
	local holeBack, holeFront = -half + wallT + 2, -2
	box("UpperFloor", Vector3.new(stairsW, 1, 2), at(0, slabY, holeBack - 1), FLOOR_COLOR)
	box("UpperFloor", Vector3.new(stairsW, 1, half - wallT - holeFront), at(0, slabY, (holeFront + half - wallT) / 2), FLOOR_COLOR)
	-- borda branca do 2º andar na frente + vidro
	local railH = 8
	box("FloorEdge", Vector3.new(inner, 1.2, 1), at(0, slabY, half - wallT / 2), TRIM)
	box("GlassRail", Vector3.new(inner, railH, 0.4), at(0, slabY + 0.5 + railH / 2, half - wallT / 2), Color3.fromRGB(190, 235, 255),
		{ Material = Enum.Material.Glass, Transparency = 0.6 })
	box("RailTop", Vector3.new(inner, 0.6, 0.8), at(0, slabY + 0.5 + railH, half - wallT / 2), TRIM)
	for _, side in ipairs({ -1, 1 }) do
		box("StairRail", Vector3.new(0.3, 3, holeFront - holeBack), at(side * (stairsW / 2 + 0.2), slabY + 2, (holeBack + holeFront) / 2), Color3.fromRGB(190, 235, 255),
			{ Material = Enum.Material.Glass, Transparency = 0.5 })
	end
	-- teto
	box("Roof", Vector3.new(Layout.BaseSize + 1, 1, Layout.BaseSize + 1), at(0, FLOOR_TOP + totalH + 0.5, 0), BASE_RED_DARK)
	box("RoofTrim", Vector3.new(Layout.BaseSize + 2, 0.8, Layout.BaseSize + 2), at(0, FLOOR_TOP + totalH + 1.3, 0), TRIM)
	-- pilares
	for _, x in ipairs({ -stairsW / 2 - 1, stairsW / 2 + 1 }) do
		for _, z in ipairs({ 6, 20 }) do
			box("Pillar", Vector3.new(1.4, up - 1, 1.4), at(x, FLOOR_TOP + (up - 1) / 2, z), TRIM)
		end
	end
	-- escada (sobe para o fundo)
	local steps = 15
	local run = holeFront - holeBack
	for i = 1, steps do
		local depth = run / steps
		local z = holeFront - (i - 0.5) * depth
		local topY = FLOOR_TOP + i * (up / steps)
		box("Step", Vector3.new(stairsW, topY - FLOOR_TOP, depth), at(0, FLOOR_TOP + (topY - FLOOR_TOP) / 2, z), i % 2 == 0 and TRIM or FLOOR_COLOR)
	end

	-- barreira de laser na entrada
	local barrier = box("Barrier", Vector3.new(Layout.EntranceWidth, h, 0.6), at(0, FLOOR_TOP + h / 2, half - 1), Color3.fromRGB(255, 40, 40),
		{ Material = Enum.Material.ForceField, Transparency = 1, CanCollide = false })
	barrier.CastShadow = false
	for _, side in ipairs({ -1, 1 }) do
		box("LaserLight", Vector3.new(0.5, h - 1, 0.5), at(side * (Layout.EntranceWidth / 2 - 0.3), FLOOR_TOP + h / 2, half - 0.3), Color3.fromRGB(255, 60, 60),
			{ Material = Enum.Material.Neon, CanCollide = false })
	end

	-- botão de trancar
	local lock = P({ Name = "LockButton", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 6, 6), CFrame = at(Layout.LockButton.X, FLOOR_TOP + 0.3, Layout.LockButton.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(60, 220, 90), Material = Enum.Material.Neon, Parent = model })
	P({ Name = "LockRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 7.4, 7.4), CFrame = at(Layout.LockButton.X, FLOOR_TOP + 0.2, Layout.LockButton.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = TRIM, Material = Enum.Material.SmoothPlastic, Parent = model })
	local lockGui = Instance.new("BillboardGui")
	lockGui.Name = "LockGui"
	lockGui.Size = UDim2.fromOffset(220, 60)
	lockGui.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	lockGui.MaxDistance = 80
	lockGui.Parent = lock
	label(lockGui, "🔓 PISE PARA TRANCAR", { Name = "Text" })

	-- placa com o nome do dono em cima do telhado, virada para a esteira
	local signY = FLOOR_TOP + totalH + 5.5
	box("SignFrame", Vector3.new(Layout.BaseSize - 6, 8, 0.8), at(0, signY, half - 2), TRIM)
	local sign = box("Sign", Vector3.new(Layout.BaseSize - 8, 6, 0.6), at(0, signY, half - 1.5), BASE_RED)
	local _, signFront = surfaceText(sign, Enum.NormalId.Back, "BASE LIVRE")
	signFront.Name = "OwnerText"
	local _, signBack = surfaceText(sign, Enum.NormalId.Front, "BASE LIVRE")
	signBack.Name = "OwnerText"
	-- faixa colorida do jogador acima da entrada
	box("Accent", Vector3.new(Layout.EntranceWidth + 2, 1.2, 0.8), at(0, FLOOR_TOP + h - 0.2, half + 0.3), accent, { Material = Enum.Material.Neon })

	local statusGui = Instance.new("BillboardGui")
	statusGui.Name = "StatusGui"
	statusGui.Size = UDim2.fromOffset(260, 50)
	statusGui.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
	statusGui.MaxDistance = 200
	statusGui.Parent = sign
	label(statusGui, "", { Name = "Text", TextColor3 = Color3.fromRGB(255, 90, 90) })

	-- espaços (pedestais)
	local slots = Instance.new("Folder")
	slots.Name = "Slots"
	slots.Parent = model
	for i, pos in ipairs(Layout.Slots) do
		local slot = Instance.new("Model")
		slot.Name = "Slot" .. i
		slot:SetAttribute("Index", i)
		slot.Parent = slots
		local y = FLOOR_TOP + pos.Y
		local pedestal = P({ Name = "Pedestal", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 7.5, 7.5),
			CFrame = at(pos.X, y + 0.6, pos.Z) * CFrame.Angles(0, 0, math.pi / 2), Color = TRIM, Material = Enum.Material.SmoothPlastic, Parent = slot })
		P({ Name = "PedestalBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 8.6, 8.6),
			CFrame = at(pos.X, y + 0.25, pos.Z) * CFrame.Angles(0, 0, math.pi / 2), Color = BASE_RED, Material = Enum.Material.SmoothPlastic, Parent = slot })
		slot.PrimaryPart = pedestal
		local towardAisle = pos.X < 0 and 1 or -1
		local collect = P({ Name = "Collect", Size = Vector3.new(2.6, 0.3, 4.4), CFrame = at(pos.X + towardAisle * 6.2, y + 0.15, pos.Z),
			Color = Color3.fromRGB(70, 230, 100), Material = Enum.Material.Neon, Parent = slot })
		collect:SetAttribute("SlotIndex", i)
		local standLocal = CFrame.lookAt(Vector3.new(pos.X, y + 1.2, pos.Z), Vector3.new(pos.X + towardAisle, y + 1.2, pos.Z))
		local stand = Instance.new("CFrameValue")
		stand.Name = "Stand"
		stand.Value = baseCF * standLocal
		stand.Parent = slot

		local info = Instance.new("BillboardGui")
		info.Name = "Info"
		info.Size = UDim2.fromOffset(240, 100)
		info.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
		info.MaxDistance = 70
		info.Enabled = false
		info.Parent = collect
		local frame = Instance.new("Frame")
		frame.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
		frame.BackgroundTransparency = 0.35
		frame.Size = UDim2.fromScale(1, 1)
		frame.Parent = info
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Stroke"
		stroke.Thickness = 2
		stroke.Color = accent
		stroke.Parent = frame
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 3)
		pad.PaddingBottom = UDim.new(0, 3)
		pad.Parent = frame
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = frame
		label(frame, "", { Name = "Mutation", LayoutOrder = 1, Size = UDim2.new(1, 0, 0.18, 0) })
		label(frame, "", { Name = "DragonName", LayoutOrder = 2, Size = UDim2.new(1, 0, 0.24, 0) })
		label(frame, "", { Name = "Rarity", LayoutOrder = 3, Size = UDim2.new(1, 0, 0.18, 0) })
		label(frame, "", { Name = "Income", LayoutOrder = 4, Size = UDim2.new(1, 0, 0.22, 0), TextColor3 = Color3.fromRGB(255, 240, 60) })
		label(frame, "", { Name = "Stored", LayoutOrder = 5, Size = UDim2.new(1, 0, 0.16, 0), TextColor3 = Color3.fromRGB(140, 255, 140) })
	end

	-- ponto de nascimento do dono
	local spawn = P({ ClassName = "SpawnLocation", Name = "Spawn", Size = Vector3.new(6, 0.2, 6), CFrame = at(Layout.SpawnPoint.X, FLOOR_TOP + 0.1, Layout.SpawnPoint.Z),
		Transparency = 1, CanCollide = false, Neutral = true, Duration = 0, Parent = model })
	spawn.CanTouch = false

	-- luzes internas
	for _, y in ipairs({ FLOOR_TOP + up - 2, FLOOR_TOP + up + 7 }) do
		local bulb = box("BaseLight", Vector3.new(1, 1, 1), at(0, y, 0), TRIM, { Transparency = 1, CanCollide = false })
		local pl = Instance.new("PointLight")
		pl.Range = 45
		pl.Brightness = 0.8
		pl.Color = Color3.fromRGB(255, 245, 230)
		pl.Parent = bulb
	end

	return model
end

-- ===================== Praça (lojas e rankings) =====================

local function buildStall(parent: Instance, cf: CFrame, title: string, panel: string, color: Color3, dragonId: string)
	local stall = Instance.new("Model")
	stall.Name = "Stall_" .. panel
	stall.Parent = parent
	local counter = P({ Name = "Counter", Size = Vector3.new(14, 4, 4), CFrame = cf * CFrame.new(0, 2, 0), Color = Color3.fromRGB(120, 80, 50), Material = Enum.Material.WoodPlanks, Parent = stall })
	for _, side in ipairs({ -1, 1 }) do
		P({ Size = Vector3.new(1, 12, 1), CFrame = cf * CFrame.new(side * 6.5, 6, 2), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = stall })
		P({ Size = Vector3.new(1, 12, 1), CFrame = cf * CFrame.new(side * 6.5, 6, -4), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = stall })
	end
	P({ ClassName = "WedgePart", Size = Vector3.new(16, 3, 9), CFrame = cf * CFrame.new(0, 13.5, -1), Color = color, Material = Enum.Material.Fabric, Parent = stall })
	local sign = P({ Name = "Sign", Size = Vector3.new(14, 3, 0.5), CFrame = cf * CFrame.new(0, 10, 2.3), Color = Color3.fromRGB(40, 25, 20), Material = Enum.Material.Wood, Parent = stall })
	surfaceText(sign, Enum.NormalId.Front, title, Color3.fromRGB(255, 220, 120))
	surfaceText(sign, Enum.NormalId.Back, title, Color3.fromRGB(255, 220, 120))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Abrir"
	prompt.ObjectText = title
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OpenPanel", panel)
	prompt.Parent = counter

	-- dragão decorativo em cima do balcão
	local deco = DragonBuilder.Build(dragonId, "Normal", { Scale = 0.8 })
	deco:PivotTo(cf * CFrame.new(0, 4, -1) * CFrame.Angles(0, math.pi, 0))
	deco.Parent = stall
end

local function buildLeaderboard(parent: Instance, cf: CFrame, name: string, title: string)
	local board = P({ Name = name, Size = Vector3.new(16, 20, 1), CFrame = cf * CFrame.new(0, 12, 0), Color = Color3.fromRGB(35, 30, 45), Material = Enum.Material.SmoothPlastic, Parent = parent })
	for _, side in ipairs({ -1, 1 }) do
		P({ Size = Vector3.new(1, 22, 1), CFrame = cf * CFrame.new(side * 8.5, 11, 0), Color = Color3.fromRGB(255, 190, 60), Material = Enum.Material.Metal, Parent = parent })
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = board
	label(gui, title, { Name = "Title", Size = UDim2.new(1, 0, 0.12, 0), TextColor3 = Color3.fromRGB(255, 210, 80) })
	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0.04, 0.14)
	list.Size = UDim2.fromScale(0.92, 0.84)
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	for i = 1, 10 do
		label(list, i .. ". ---", { Name = "Row" .. i, LayoutOrder = i, Size = UDim2.new(1, 0, 0.1, 0), TextXAlignment = Enum.TextXAlignment.Left })
	end
	return board
end

local function buildPlaza(map: Instance)
	local plaza = Instance.new("Model")
	plaza.Name = "Plaza"
	plaza.Parent = map
	local c = Layout.PlazaCenter
	P({ Name = "PlazaFloor", Size = Vector3.new(70, 0.4, 90), Position = c + Vector3.new(0, 0.2, 0), Color = Color3.fromRGB(215, 205, 190), Material = Enum.Material.Marble, Parent = plaza })
	-- fonte no meio
	P({ Name = "Fountain", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 16, 16), CFrame = CFrame.new(c + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(180, 175, 170), Material = Enum.Material.Marble, Parent = plaza })
	local water = P({ Name = "Water", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 14, 14), CFrame = CFrame.new(c + Vector3.new(0, 2.05, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(60, 160, 255), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false, Parent = plaza })
	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(Color3.fromRGB(180, 230, 255))
	spray.Rate = 30
	spray.Speed = NumberRange.new(10, 14)
	spray.SpreadAngle = Vector2.new(12, 12)
	spray.Acceleration = Vector3.new(0, -30, 0)
	spray.Lifetime = NumberRange.new(0.8, 1.1)
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Parent = water
	local statue = DragonBuilder.Build("Bahamut", "Ouro", { Scale = 0.9, NoEffects = true })
	statue:PivotTo(CFrame.new(c + Vector3.new(0, 2.2, 0)) * CFrame.Angles(0, math.pi / 2, 0))
	statue.Parent = plaza

	-- a frente da barraca (+Z) fica virada para a fonte
	local function facingCenter(offset: Vector3)
		local pos = c + offset + Vector3.new(0, 0.4, 0)
		local center = c + Vector3.new(0, 0.4, 0)
		return CFrame.lookAt(pos, pos + (pos - center))
	end
	buildStall(plaza, facingCenter(Vector3.new(12, 0, -30)), "LOJA DE EQUIPAMENTOS", "Shop", Color3.fromRGB(220, 60, 60), "Wyvern")
	buildStall(plaza, facingCenter(Vector3.new(12, 0, 30)), "LOJA VIP", "Robux", Color3.fromRGB(255, 190, 40), "Celestial")
	buildStall(plaza, facingCenter(Vector3.new(-16, 0, -32)), "REBIRTH", "Rebirth", Color3.fromRGB(150, 70, 255), "Fenix")
	buildStall(plaza, facingCenter(Vector3.new(-16, 0, 32)), "ÍNDICE DE DRAGÕES", "Index", Color3.fromRGB(60, 170, 255), "Gelo")

	buildLeaderboard(plaza, CFrame.new(c + Vector3.new(30, 0.4, -14)) * CFrame.Angles(0, math.pi / 2, 0), "TopMoney", "💰 MAIS RICOS")
	buildLeaderboard(plaza, CFrame.new(c + Vector3.new(30, 0.4, 14)) * CFrame.Angles(0, math.pi / 2, 0), "TopSteals", "🐉 MAIS ROUBOS")
end

-- ===================== Iluminação =====================

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 3
	Lighting.ShadowSoftness = 0.35
	Lighting.ColorShift_Top = Color3.fromRGB(255, 240, 220)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 150)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.22
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(255, 220, 200)
	atmosphere.Decay = Color3.fromRGB(150, 100, 120)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 0.6
	atmosphere.Parent = Lighting

	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.Parent = Lighting
	end

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local cc = Lighting:FindFirstChild("BaseColor") or Instance.new("ColorCorrectionEffect")
	cc.Name = "BaseColor"
	cc.Saturation = 0.22
	cc.Contrast = 0.08
	cc.Parent = Lighting

	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Parent = Lighting

	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.5
	clouds.Parent = workspace.Terrain
end

-- ===================== Construção =====================

function MapService:Init()
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	self.Map = map

	local env = Instance.new("Folder")
	env.Name = "Environment"
	env.Parent = map

	-- chão de terreno (grama, rios, montanhas)
	buildTerrain(env)

	buildConveyor(map)

	local bases = Instance.new("Folder")
	bases.Name = "Bases"
	bases.Parent = map
	self.Bases = {}
	for i, cf in ipairs(Layout.Bases) do
		self.Bases[i] = buildBase(bases, i, cf)
	end

	buildPlaza(map)

	-- árvores, pinheiros, pedras e flores em volta da área de jogo
	for _ = 1, 140 do
		local x = rng:NextNumber(-330, 380)
		local z = rng:NextNumber(-215, 215)
		local insidePlay = math.abs(z) < 112 and x > -215 and x < 275
		if not insidePlay then
			local roll = rng:NextNumber()
			if roll < 0.75 then
				buildTree(env, Vector3.new(x, 0, z), rng:NextNumber(0.9, 1.6))
			else
				buildFlowers(env, Vector3.new(x, 0, z), 5, 8)
			end
		end
	end
	-- árvores e flores entre as bases e nas calçadas
	for _, x in ipairs({ -160, -80, 0, 80, 160 }) do
		for _, z in ipairs({ -72, 72 }) do
			buildTree(env, Vector3.new(x, 0, z), 1.1)
			buildFlowers(env, Vector3.new(x, 0, z), 6, 10)
		end
	end
	for x = -180, 180, 45 do
		for _, z in ipairs({ -30, 30 }) do
			buildFlowers(env, Vector3.new(x + 20, 0, z), 4, 6)
		end
	end


	-- paredes invisíveis (limite do mapa)
	local limits = Instance.new("Folder")
	limits.Name = "Limits"
	limits.Parent = map
	local function wall(size, pos)
		P({ Name = "Limit", Size = size, Position = pos, Transparency = 1, CanCollide = true, Parent = limits })
	end
	wall(Vector3.new(4, 200, 300), Vector3.new(-222, 100, 0))
	wall(Vector3.new(4, 200, 300), Vector3.new(268, 100, 0))
	wall(Vector3.new(500, 200, 4), Vector3.new(23, 100, -118))
	wall(Vector3.new(500, 200, 4), Vector3.new(23, 100, 118))

	setupLighting()
end

function MapService:GetBaseModel(index: number)
	return self.Bases[index]
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- Gamepasses e Produtos (Robux). Processa compras com segurança (sem duplicar).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Monetization = require(Shared.Monetization)
local Dragons = require(Shared.Dragons)
local Format = require(Shared.Format)

local MonetizationService = {}
local owned = {} -- [player] = { [passKey] = true }
local IS_STUDIO = RunService:IsStudio()

function MonetizationService:GetOwnedPasses(player: Player)
	return owned[player] or {}
end

function MonetizationService:HasPass(player: Player, key: string): boolean
	local set = owned[player]
	return set ~= nil and set[key] == true
end

function MonetizationService:LoadPasses(player: Player)
	local set = {}
	owned[player] = set
	local data = self.Services.DataService:Get(player)
	if IS_STUDIO and data then
		for key in pairs(data.TestPasses) do
			set[key] = true
		end
	end
	for _, pass in ipairs(Monetization.Passes) do
		if pass.Id ~= 0 then
			local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and has then
				set[pass.Key] = true
			end
		end
	end
end

-- Aplica os efeitos de um passe recém-comprado
function MonetizationService:GrantPass(player: Player, key: string)
	local S = self.Services
	owned[player] = owned[player] or {}
	if owned[player][key] then
		return
	end
	owned[player][key] = true
	local pass = Monetization.PassByKey[key]
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
	S.BaseService:RefreshSlots(player)
	S.GearService:GiveTools(player)
	S.MovementService:Recompute(player)
	S.ActionService:Effect(player, "Sound", { Name = "Reward" })
	S.ActionService:Alert(player, "✅ Obrigado! Você ganhou: " .. pass.Name, Color3.fromRGB(255, 220, 80))
	S.ActionService:NotifyAll("💎 " .. player.DisplayName .. " comprou " .. pass.Name .. "!", "rare")
	S.StateService:MarkDirty(player)
end

function MonetizationService:PromptPass(player: Player, key: string)
	local S = self.Services
	local pass = Monetization.PassByKey[key]
	if not pass or self:HasPass(player, key) then
		return
	end
	if pass.Id == 0 then
		if IS_STUDIO then
			local data = S.DataService:Get(player)
			data.TestPasses[key] = true
			S.ActionService:Notify(player, "[Studio] Compra simulada de " .. pass.Name, "info")
			self:GrantPass(player, key)
		else
			S.ActionService:Notify(player, "Em breve!", "info")
		end
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

-- Verifica antes de abrir a compra (ex.: base cheia para produto de dragão)
function MonetizationService:CanBuyProduct(player: Player, product): (boolean, string?)
	local S = self.Services
	if product.Kind == "Dragon" and not S.BaseService:FindFreeSlot(player) then
		return false, "Sua base está cheia! Libere um espaço antes."
	end
	return true, nil
end

function MonetizationService:PromptProduct(player: Player, key: string)
	local S = self.Services
	local product = Monetization.ProductByKey[key]
	if not product then
		return
	end
	local ok, reason = self:CanBuyProduct(player, product)
	if not ok then
		S.ActionService:Notify(player, reason, "error")
		return
	end
	if product.Id == 0 then
		if IS_STUDIO then
			S.ActionService:Notify(player, "[Studio] Compra simulada de " .. product.Name, "info")
			self:GrantProduct(player, product)
		else
			S.ActionService:Notify(player, "Em breve!", "info")
		end
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

function MonetizationService:GrantProduct(player: Player, product): boolean
	local S = self.Services
	local data = S.DataService:Get(player)
	if not data then
		return false
	end
	local kind = product.Kind
	if kind == "Cash" then
		local amount = product.Amount * (1 + data.Rebirths) ^ 2
		data.Cash += amount
		S.ActionService:Effect(player, "Sound", { Name = "Coin" })
		S.ActionService:Alert(player, "💰 +" .. Format.Cash(amount), Color3.fromRGB(120, 255, 120))
	elseif kind == "Dragon" then
		local def = Dragons.RandomOfRarity(product.Rarity)
		local uid = S.DragonService:Give(player, def.Id, "Normal")
		if not uid then
			-- sem espaço: compensa com dinheiro
			local amount = def.Price * 3
			data.Cash += amount
			S.ActionService:Notify(player, "Base cheia! Você recebeu " .. Format.Cash(amount) .. " no lugar do dragão.", "warning")
		else
			S.ActionService:Alert(player, "🐉 Você ganhou " .. def.Name .. "!", Color3.fromRGB(255, 200, 60))
			S.ActionService:Effect(player, "Confetti", {})
		end
	elseif kind == "Shield" then
		S.BaseService:AddShield(player, product.Seconds)
		S.ActionService:Alert(player, "🛡️ Escudo ativado por " .. math.floor(product.Seconds / 60) .. " minutos!", Color3.fromRGB(120, 200, 255))
	elseif kind == "ServerLuck" then
		S.EventService:AddServerLuck(product.Seconds, player)
	elseif kind == "Meteor" then
		S.EventService:MeteorShower(player)
	elseif kind == "FreezeAll" then
		S.EventService:FreezeAll(player)
	elseif kind == "UnlockAll" then
		S.EventService:UnlockAll(player)
	end
	S.StateService:MarkDirty(player)
	return true
end

function MonetizationService:Init()
	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local data = self.Services.DataService:Get(player)
		if not data then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local product = Monetization.ProductById[receipt.ProductId]
		if not product then
			warn("[Monetization] Produto desconhecido:", receipt.ProductId)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		-- já processado antes? (evita dar duas vezes)
		for _, id in ipairs(data.Purchases) do
			if id == receipt.PurchaseId then
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		local ok, granted = pcall(self.GrantProduct, self, player, product)
		if not ok or not granted then
			warn("[Monetization] Falha ao entregar", product.Key, granted)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		table.insert(data.Purchases, receipt.PurchaseId)
		while #data.Purchases > 50 do
			table.remove(data.Purchases, 1)
		end
		self.Services.DataService:Save(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local pass = Monetization.PassById[passId]
			if pass then
				self:GrantPass(player, pass.Key)
			end
		end
	end)
end

function MonetizationService:Start()
	Players.PlayerRemoving:Connect(function(player)
		task.defer(function()
			owned[player] = nil
		end)
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[-- Controla velocidade/pulo dos jogadores juntando todos os efeitos
-- (carregando dragão, congelado, bobinas, passe de velocidade, capa).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MovementService = {}
local state = {} -- [player] = { FrozenUntil, SpeedCoil, GravityCoil, InvisibleUntil, IceBlock }

local function get(player)
	local s = state[player]
	if not s then
		s = { FrozenUntil = 0, InvisibleUntil = 0 }
		state[player] = s
	end
	return s
end

function MovementService:Recompute(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local s = get(player)
	local now = workspace:GetServerTimeNow()
	local S = self.Services

	local speed = Config.WalkSpeed
	local jump = 7.2
	if S.MonetizationService:HasPass(player, "Speed") then
		speed += Config.SpeedPassBonus
	end
	local carrying = S.StealService:IsCarrying(player)
	if carrying then
		speed = Config.CarrySpeed + (S.MonetizationService:HasPass(player, "Speed") and 2 or 0)
	else
		if s.SpeedCoil then
			speed += Config.SpeedCoilBonus
		end
		if s.GravityCoil then
			jump = 16
		end
		if now < s.InvisibleUntil then
			speed += 8
		end
	end
	if now < s.FrozenUntil then
		speed = 0
		jump = 0
	end
	humanoid.UseJumpPower = false
	humanoid.WalkSpeed = speed
	humanoid.JumpHeight = jump
end

function MovementService:SetCoil(player: Player, kind: string, active: boolean)
	local s = get(player)
	if kind == "SpeedCoil" then
		s.SpeedCoil = active
	elseif kind == "GravityCoil" then
		s.GravityCoil = active
	end
	self:Recompute(player)
end

function MovementService:IsFrozen(player: Player): boolean
	return workspace:GetServerTimeNow() < get(player).FrozenUntil
end

-- Congela/atordoa. visual = "Ice" | "Web" | nil
function MovementService:Freeze(player: Player, seconds: number, visual: string?)
	local s = get(player)
	local untilTime = workspace:GetServerTimeNow() + seconds
	s.FrozenUntil = math.max(s.FrozenUntil, untilTime)
	self:Recompute(player)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and visual then
		if s.IceBlock then
			s.IceBlock:Destroy()
		end
		local block = Instance.new("Part")
		block.Name = "FreezeVisual"
		block.Size = Vector3.new(5, 7, 5)
		block.CanCollide = false
		block.CanQuery = false
		block.CanTouch = false
		block.Massless = true
		block.CFrame = root.CFrame
		if visual == "Web" then
			block.Shape = Enum.PartType.Ball
			block.Size = Vector3.new(7, 7, 7)
			block.Material = Enum.Material.ForceField
			block.Color = Color3.fromRGB(255, 255, 255)
		else
			block.Material = Enum.Material.Ice
			block.Color = Color3.fromRGB(150, 220, 255)
			block.Transparency = 0.4
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = block
		weld.Parent = block
		block.Parent = character
		s.IceBlock = block
		task.delay(seconds, function()
			if s.IceBlock == block then
				block:Destroy()
				s.IceBlock = nil
			end
		end)
	end
	self.Services.ActionService:Effect(player, "Frozen", { Duration = seconds })
	task.delay(seconds + 0.05, function()
		if player.Parent then
			self:Recompute(player)
		end
	end)
end

function MovementService:SetInvisible(player: Player, seconds: number)
	local s = get(player)
	s.InvisibleUntil = workspace:GetServerTimeNow() + seconds
	local character = player.Character
	if not character then
		return
	end
	local saved = {}
	for _, d in ipairs(character:GetDescendants()) do
		if (d:IsA("BasePart") and d.Name ~= "HumanoidRootPart") or d:IsA("Decal") then
			saved[d] = d.Transparency
			d.Transparency = 1
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	s.InvisibleSaved = saved
	self:Recompute(player)
	task.delay(seconds, function()
		self:ClearInvisible(player)
	end)
end

function MovementService:ClearInvisible(player: Player)
	local s = get(player)
	s.InvisibleUntil = 0
	if s.InvisibleSaved then
		for inst, t in pairs(s.InvisibleSaved) do
			if inst.Parent then
				inst.Transparency = t
			end
		end
		s.InvisibleSaved = nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	end
	self:Recompute(player)
end

function MovementService:IsInvisible(player: Player): boolean
	return workspace:GetServerTimeNow() < get(player).InvisibleUntil
end

function MovementService:OnCharacter(player: Player)
	local s = get(player)
	s.FrozenUntil = 0
	s.InvisibleUntil = 0
	s.InvisibleSaved = nil
	s.SpeedCoil = false
	s.GravityCoil = false
	s.IceBlock = nil
	self:Recompute(player)
end

function MovementService:Start()
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
end

return MovementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[-- Entrada e saída de jogadores: carregar dados, dar base, nascer, salvar.

local Players = game:GetService("Players")

local PlayerService = {}
local ready = {}

function PlayerService:IsReady(player: Player): boolean
	return ready[player] == true
end

function PlayerService:SpawnCharacter(player: Player)
	if player.Parent then
		player:LoadCharacter()
	end
end

function PlayerService:OnCharacterAdded(player: Player, character: Model)
	local S = self.Services
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	S.MovementService:OnCharacter(player)
	task.defer(function()
		S.GearService:GiveTools(player)
	end)
	humanoid.Died:Connect(function()
		S.StealService:Interrupt(player, "Você morreu e o dragão voltou!")
		task.wait(3)
		if player.Parent and player.Character == character then
			self:SpawnCharacter(player)
		end
	end)
end

function PlayerService:OnPlayerAdded(player: Player)
	local S = self.Services
	S.StateService:SetupLeaderstats(player)

	local profile = S.DataService:Load(player)
	if not profile or not player.Parent then
		return
	end
	S.MonetizationService:LoadPasses(player)

	local base = S.BaseService:Assign(player)
	if not base then
		player:Kick("Servidor cheio, tente outro servidor.")
		return
	end

	player.CharacterAdded:Connect(function(character)
		self:OnCharacterAdded(player, character)
	end)

	S.DragonService:OnPlayerAdded(player)
	S.DragonService:LoadAll(player)
	S.RewardService:OnPlayerReady(player)
	ready[player] = true

	if S.MonetizationService:HasPass(player, "VIP") then
		player:SetAttribute("VIP", true)
	end
	self:SpawnCharacter(player)
	S.StateService:Push(player)

	if not profile.CanSave then
		S.ActionService:Notify(player, "⚠️ Seus dados não serão salvos nesta sessão (DataStore indisponível).", "warning")
	end
end

-- Chamado antes de salvar ao fechar o servidor
function PlayerService:BeforeSave(player: Player)
	local S = self.Services
	S.StealService:OnPlayerRemoving(player)
end

function PlayerService:OnPlayerRemoving(player: Player)
	local S = self.Services
	ready[player] = nil
	S.StealService:OnPlayerRemoving(player)
	S.LeaderboardService:SubmitPlayer(player)
	S.DragonService:ClearModels(player)
	S.BaseService:Free(player)
	S.DataService:Release(player)
end

function PlayerService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:OnPlayerAdded(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(self.OnPlayerAdded, self, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		self:OnPlayerRemoving(player)
	end)

	-- quem cair do mapa volta pra base
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and root.Position.Y < -30 then
				local base = self.Services.BaseService:GetBaseOf(player)
				if base then
					player.Character:PivotTo(base.Model.Spawn.CFrame + Vector3.new(0, 4, 0))
				end
			end
		end
	end
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[-- Rebirth: zera dinheiro, dragões e equipamentos comprados com dinheiro,
-- e dá multiplicador maior, mais espaços, trava mais longa e novos itens.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Rebirths = require(Shared.Rebirths)
local Rarities = require(Shared.Rarities)
local Dragons = require(Shared.Dragons)
local Format = require(Shared.Format)

local RebirthService = {}

function RebirthService:Check(player: Player)
	local data = self.Services.DataService:Get(player)
	if not data then
		return false, "Carregando..."
	end
	local nextEntry = Rebirths.List[data.Rebirths + 1]
	if not nextEntry then
		return false, "Você já está no Rebirth máximo!"
	end
	if data.Cash < nextEntry.Cash then
		return false, "Precisa de " .. Format.Cash(nextEntry.Cash)
	end
	if nextEntry.NeedRarity then
		local need = Rarities.Get(nextEntry.NeedRarity).Order
		local has = false
		for _, record in pairs(data.Dragons) do
			local def = Dragons.Get(record.Id)
			if def and Rarities.Get(def.Rarity).Order >= need then
				has = true
				break
			end
		end
		if not has then
			return false, "Precisa ter um dragão " .. Rarities.Get(nextEntry.NeedRarity).Name .. " ou melhor na base"
		end
	end
	return true, nil
end

function RebirthService:Rebirth(player: Player)
	local S = self.Services
	local ok, reason = self:Check(player)
	if not ok then
		S.ActionService:Notify(player, reason, "error")
		S.ActionService:Effect(player, "Sound", { Name = "Error" })
		return
	end
	if S.StealService:IsCarrying(player) then
		return
	end
	local data = S.DataService:Get(player)

	-- cancela roubos em andamento contra este jogador
	S.StealService:OnPlayerRemoving(player)
	S.DragonService:ClearModels(player)
	data.Dragons = {}
	data.Cash = Config.StartingCash
	data.Gear = {}
	data.Rebirths += 1

	S.BaseService:RefreshSlots(player)
	S.GearService:GiveTools(player)
	S.MovementService:Recompute(player)

	local entry = Rebirths.List[data.Rebirths]
	S.ActionService:Effect(player, "Sound", { Name = "Rebirth" })
	S.ActionService:Effect(player, "Confetti", {})
	S.ActionService:Alert(player, "🌟 REBIRTH " .. data.Rebirths .. "! Renda x" .. entry.Multiplier, Color3.fromRGB(255, 220, 80))
	S.ActionService:NotifyAll("🌟 " .. player.DisplayName .. " fez Rebirth " .. data.Rebirths .. "!", "rare")
	S.StateService:MarkDirty(player)
	task.spawn(S.DataService.Save, S.DataService, player)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- Recompensas para quem joga de graça: presentes por tempo, prêmio diário,
-- renda offline, códigos e tutorial.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Dragons = require(Shared.Dragons)
local Format = require(Shared.Format)

local RewardService = {}

-- Códigos: CODIGO = recompensa. Adicione novos códigos aqui a cada atualização!
RewardService.Codes = {
	RELEASE = { Cash = 10000 },
	LAUNCH = { Cash = 5000 },
	DRAGON = { Cash = 1500 },
	STEALADRAGON = { Dragon = "Raro" },
	THANKYOU = { Cash = 3000 },
}

local joinTime = {} -- [player] = server time
local claimed = {} -- [player] = { [index] = true }

local function now()
	return workspace:GetServerTimeNow()
end

local function scale(data, amount: number): number
	return math.floor(amount * (1 + data.Rebirths) ^ 2)
end

-- ============ Presentes por tempo ============

function RewardService:GetPlaytimeState(player: Player)
	-- chaves em texto para enviar ao cliente sem problemas
	local list = {}
	for index in pairs(claimed[player] or {}) do
		list[tostring(index)] = true
	end
	return {
		JoinTime = joinTime[player] or now(),
		Claimed = list,
	}
end

function RewardService:ClaimPlaytime(player: Player, index: number)
	local S = self.Services
	local reward = Config.PlaytimeRewards[index]
	local data = S.DataService:Get(player)
	if not reward or not data or not joinTime[player] then
		return
	end
	claimed[player] = claimed[player] or {}
	if claimed[player][index] then
		return
	end
	if now() - joinTime[player] < reward.Minutes * 60 - 1 then
		return S.ActionService:Notify(player, "Ainda não está pronto!", "error")
	end
	if reward.Kind == "Cash" then
		local amount = scale(data, reward.Amount)
		data.Cash += amount
		S.ActionService:Alert(player, "🎁 Presente: +" .. Format.Cash(amount), Color3.fromRGB(120, 255, 120))
	elseif reward.Kind == "Dragon" then
		local def = Dragons.RandomOfRarity(reward.Rarity)
		if not S.DragonService:Give(player, def.Id, "Normal") then
			return S.ActionService:Notify(player, "Base cheia! Libere um espaço para pegar o presente.", "error")
		end
		S.ActionService:Alert(player, "🎁 Presente: " .. def.Name .. "!", Color3.fromRGB(255, 200, 60))
	end
	claimed[player][index] = true
	S.ActionService:Effect(player, "Sound", { Name = "Reward" })
	S.StateService:MarkDirty(player)
end

-- ============ Prêmio diário ============

function RewardService:GetDailyState(player: Player)
	local data = self.Services.DataService:Get(player)
	if not data then
		return { CanClaim = false, Streak = 0, NextIn = 0 }
	end
	local elapsed = os.time() - data.LastDaily
	local canClaim = elapsed >= 20 * 3600
	return {
		CanClaim = canClaim,
		Streak = data.DailyStreak,
		NextIn = canClaim and 0 or (20 * 3600 - elapsed),
	}
end

function RewardService:ClaimDaily(player: Player)
	local S = self.Services
	local data = S.DataService:Get(player)
	local state = self:GetDailyState(player)
	if not data or not state.CanClaim then
		return
	end
	if os.time() - data.LastDaily > 48 * 3600 then
		data.DailyStreak = 0
	end
	local day = (data.DailyStreak % #Config.DailyRewards) + 1
	local amount = scale(data, Config.DailyRewards[day])
	data.DailyStreak += 1
	data.LastDaily = os.time()
	data.Cash += amount
	S.ActionService:Alert(player, "📅 Prêmio do dia " .. day .. ": +" .. Format.Cash(amount), Color3.fromRGB(120, 255, 120))
	S.ActionService:Effect(player, "Sound", { Name = "Reward" })
	S.StateService:MarkDirty(player)
	task.spawn(S.DataService.Save, S.DataService, player)
end

-- ============ Códigos ============

function RewardService:RedeemCode(player: Player, code: string)
	local S = self.Services
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	code = string.upper((code:gsub("%s+", "")))
	local reward = self.Codes[code]
	if not reward then
		S.ActionService:Effect(player, "Sound", { Name = "Error" })
		return S.ActionService:Notify(player, "Código inválido!", "error")
	end
	if data.Codes[code] then
		return S.ActionService:Notify(player, "Você já usou esse código.", "error")
	end
	if reward.Dragon then
		local def = Dragons.RandomOfRarity(reward.Dragon)
		if not S.DragonService:Give(player, def.Id, "Normal") then
			return S.ActionService:Notify(player, "Base cheia! Libere um espaço e tente de novo.", "error")
		end
		S.ActionService:Alert(player, "🎟️ Código resgatado: " .. def.Name .. "!", Color3.fromRGB(255, 200, 60))
	end
	if reward.Cash then
		local amount = scale(data, reward.Cash)
		data.Cash += amount
		S.ActionService:Alert(player, "🎟️ Código resgatado: +" .. Format.Cash(amount), Color3.fromRGB(120, 255, 120))
	end
	data.Codes[code] = true
	S.ActionService:Effect(player, "Sound", { Name = "Reward" })
	S.StateService:MarkDirty(player)
end

-- ============ Entrada / offline / tutorial ============

function RewardService:OnPlayerReady(player: Player)
	local S = self.Services
	joinTime[player] = now()
	claimed[player] = {}
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	-- renda offline
	if data.LastOnline > 0 then
		local cap = S.MonetizationService:HasPass(player, "VIP") and Config.OfflineCapSecondsVIP or Config.OfflineCapSeconds
		local seconds = math.clamp(os.time() - data.LastOnline, 0, cap)
		local income = S.DragonService:GetIncomePerSecond(player)
		local amount = math.floor(income * seconds * Config.OfflineRate)
		if amount > 0 and seconds > 60 then
			data.Cash += amount
			task.delay(4, function()
				if player.Parent then
					S.ActionService:Effect(player, "Offline", { Amount = amount, Seconds = seconds })
				end
			end)
		end
	end
	-- jogador novo: um dragãozinho de presente para começar
	if not data.TutorialDone and next(data.Dragons) == nil and data.Rebirths == 0 and data.TotalEarned == 0 then
		S.DragonService:Give(player, "Verdinho", "Normal")
	end
end

function RewardService:OnTutorialEvent(player: Player, event: string)
	self.Services.ActionService:Effect(player, "Tutorial", { Event = event })
end

function RewardService:Start()
	Players.PlayerRemoving:Connect(function(player)
		joinTime[player] = nil
		claimed[player] = nil
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">StateService</string>
            <string name="Source"><![CDATA[-- Envia ao cliente os dados que a interface precisa, e mantém o placar (leaderstats).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)
local Format = require(Shared.Format)
local Config = require(Shared.Config)

local StateService = {}
local dirty = {}

function StateService:MarkDirty(player: Player)
	dirty[player] = true
end

function StateService:MarkAllDirty()
	for _, player in ipairs(Players:GetPlayers()) do
		dirty[player] = true
	end
end

function StateService:SetupLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Dinheiro"
	cash.Value = "$0"
	cash.Parent = stats
	local steals = Instance.new("IntValue")
	steals.Name = "Roubos"
	steals.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player
end

function StateService:Build(player: Player)
	local S = self.Services
	local data = S.DataService:Get(player)
	if not data then
		return nil
	end
	local now = workspace:GetServerTimeNow()
	local base = S.BaseService:GetBaseOf(player)

	local passes = {}
	for key in pairs(S.MonetizationService:GetOwnedPasses(player)) do
		passes[key] = true
	end

	return {
		Cash = data.Cash,
		Rebirths = data.Rebirths,
		Steals = data.TotalSteals,
		Income = S.DragonService:GetIncomePerSecond(player),
		Multiplier = S.DragonService:GetMultiplier(player),
		Slots = S.BaseService:GetCapacity(player),
		UsedSlots = S.BaseService:CountDragons(player),
		Gear = data.Gear,
		Passes = passes,
		Index = data.Index,
		Settings = data.Settings,
		TutorialDone = data.TutorialDone,
		Playtime = S.RewardService:GetPlaytimeState(player),
		Daily = S.RewardService:GetDailyState(player),
		BaseIndex = base and base.Index or 0,
		LockedUntil = base and base.LockedUntil or 0,
		ShieldUntil = base and base.ShieldUntil or 0,
		IsAdmin = S.AdminService:IsAdmin(player),
		ServerTime = now,
		CanSave = S.DataService.Profiles[player] and S.DataService.Profiles[player].CanSave or false,
	}
end

function StateService:Push(player: Player)
	local state = self:Build(player)
	if state then
		Remotes.State:FireClient(player, state)
	end
	self:UpdateLeaderstats(player)
end

function StateService:UpdateLeaderstats(player: Player)
	local data = self.Services.DataService:Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	stats.Dinheiro.Value = Format.Cash(data.Cash)
	stats.Roubos.Value = data.TotalSteals
	stats.Rebirths.Value = data.Rebirths
	player:SetAttribute("Rebirths", data.Rebirths)
end

function StateService:Start()
	task.spawn(function()
		while true do
			task.wait(0.25)
			for player in pairs(dirty) do
				dirty[player] = nil
				if player.Parent then
					self:Push(player)
				end
			end
		end
	end)
	-- atualização periódica (renda, timers)
	task.spawn(function()
		while true do
			task.wait(Config.IncomeTick)
			self:MarkAllDirty()
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
end

return StateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[-- Roubo: segurar E no dragão de outra base, carregar na cabeça e levar até a sua base.
-- Se levar um tapa, ficar preso ou morrer, o dragão volta para o dono.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Dragons = require(Shared.Dragons)
local DragonBuilder = require(Shared.DragonBuilder)

local StealService = {}
local carrying = {} -- [thief] = { Owner, Base, SlotIndex, Uid, Carry, Started }

function StealService:IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

local function ownerOfPrompt(prompt: ProximityPrompt)
	local userId = prompt:GetAttribute("OwnerUserId")
	return userId and Players:GetPlayerByUserId(userId)
end

function StealService:TryStart(thief: Player, prompt: ProximityPrompt)
	local S = self.Services
	local owner = ownerOfPrompt(prompt)
	if not owner or owner == thief then
		return
	end
	local model = prompt:FindFirstAncestorOfClass("Model")
	local uid = model and model:GetAttribute("Uid")
	if not uid then
		return
	end
	local entry, slotIndex, base = S.DragonService:FindEntryByUid(owner, uid)
	if not entry or entry.Stealing then
		return
	end
	local function fail(msg)
		S.ActionService:Notify(thief, msg, "error")
		S.ActionService:Effect(thief, "Sound", { Name = "Error" })
	end
	if carrying[thief] then
		return fail("Você já está carregando um dragão!")
	end
	if S.BaseService:IsLocked(base) then
		return fail("Essa base está trancada! 🔒")
	end
	if S.MovementService:IsFrozen(thief) then
		return
	end
	local thiefBase = S.BaseService:GetBaseOf(thief)
	if not thiefBase then
		return
	end
	local slot = S.BaseService:FindFreeSlot(thief)
	if not slot then
		return fail("Sua base está cheia! Venda um dragão primeiro.")
	end
	local character = thief.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head then
		return
	end

	-- reserva o espaço do ladrão e marca o dragão como "sendo roubado"
	thiefBase.Reserved[slot] = true
	entry.Stealing = thief
	entry.Model.Parent = ServerStorage

	S.MovementService:ClearInvisible(thief)
	humanoid:UnequipTools()

	local carry = DragonBuilder.Build(entry.Record.Id, entry.Record.Mut, { Scale = 0.55, Anchored = false })
	carry.Name = "CarriedDragon"
	carry:PivotTo(head.CFrame * CFrame.new(0, 2.2, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = carry.Root
	weld.Parent = carry.Root
	carry.Parent = character

	carrying[thief] = {
		Owner = owner,
		Base = base,
		SlotIndex = slotIndex,
		ReservedSlot = slot,
		Uid = uid,
		Carry = carry,
		Started = os.clock(),
	}
	thief:SetAttribute("Carrying", true)
	S.MovementService:Recompute(thief)
	S.DragonService:UpdateInfo(base, slotIndex)

	local def = Dragons.Get(entry.Record.Id)
	S.ActionService:Alert(owner, "⚠️ " .. thief.DisplayName .. " ESTÁ ROUBANDO SEU " .. string.upper(def.Name) .. "!", Color3.fromRGB(255, 60, 60))
	S.ActionService:Effect(owner, "Sound", { Name = "Alarm" })
	S.ActionService:Effect(owner, "StealAlert", { Thief = thief.UserId })
	S.ActionService:Notify(thief, "Leve o dragão até a SUA base!", "info")
	S.ActionService:Effect(thief, "Sound", { Name = "Steal" })
	S.ActionService:Effect(thief, "CarryStart", { BaseIndex = thiefBase.Index })
end

function StealService:Finish(thief: Player)
	local S = self.Services
	local c = carrying[thief]
	if not c then
		return
	end
	carrying[thief] = nil
	thief:SetAttribute("Carrying", nil)
	local thiefBase = S.BaseService:GetBaseOf(thief)
	if thiefBase then
		thiefBase.Reserved[c.ReservedSlot] = nil
	end
	if c.Carry then
		c.Carry:Destroy()
	end

	local record = S.DragonService:Remove(c.Owner, c.Uid)
	if record then
		local uid = S.DragonService:Give(thief, record.Id, record.Mut)
		if uid then
			local data = S.DataService:Get(thief)
			data.TotalSteals += 1
			local def = Dragons.Get(record.Id)
			S.ActionService:Alert(thief, "🐉 VOCÊ ROUBOU " .. string.upper(def.Name) .. "!", Color3.fromRGB(90, 255, 120))
			S.ActionService:Effect(thief, "Sound", { Name = "Roar" })
			S.ActionService:Effect(thief, "Confetti", {})
			S.ActionService:Notify(c.Owner, "😭 " .. thief.DisplayName .. " roubou seu " .. def.Name .. "!", "error")
			S.RewardService:OnTutorialEvent(thief, "Stole")
		end
	end
	S.MovementService:Recompute(thief)
	S.StateService:MarkDirty(thief)
	S.StateService:MarkDirty(c.Owner)
	S.ActionService:Effect(thief, "CarryEnd", {})
end

-- Cancela o roubo e devolve o dragão ao dono
function StealService:Interrupt(thief: Player, reason: string?)
	local S = self.Services
	local c = carrying[thief]
	if not c then
		return
	end
	carrying[thief] = nil
	thief:SetAttribute("Carrying", nil)
	local thiefBase = S.BaseService:GetBaseOf(thief)
	if thiefBase then
		thiefBase.Reserved[c.ReservedSlot] = nil
	end
	if c.Carry then
		c.Carry:Destroy()
	end
	local entry = c.Base.Slots[c.SlotIndex]
	if entry and entry.Uid == c.Uid then
		entry.Stealing = nil
		if entry.Model then
			entry.Model.Parent = workspace.Dragons
		end
		S.DragonService:UpdateInfo(c.Base, c.SlotIndex)
	end
	if thief.Parent then
		S.ActionService:Notify(thief, reason or "Você perdeu o dragão!", "error")
		S.ActionService:Effect(thief, "CarryEnd", {})
		S.MovementService:Recompute(thief)
		S.StateService:MarkDirty(thief)
	end
	if c.Owner.Parent then
		S.ActionService:Notify(c.Owner, "✅ Seu dragão voltou para a base!", "success")
		S.StateService:MarkDirty(c.Owner)
	end
end

-- Quando um jogador sai, cancela roubos dele e contra ele
function StealService:OnPlayerRemoving(player: Player)
	if carrying[player] then
		self:Interrupt(player, nil)
	end
	for thief, c in pairs(carrying) do
		if c.Owner == player then
			self:Interrupt(thief, "O dono saiu do jogo, o dragão sumiu!")
		end
	end
end

function StealService:Start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local kind = prompt:GetAttribute("PromptType")
		if kind == "Steal" then
			self:TryStart(player, prompt)
		elseif kind == "Sell" then
			local owner = ownerOfPrompt(prompt)
			local model = prompt:FindFirstAncestorOfClass("Model")
			if owner == player and model then
				self.Services.DragonService:Sell(player, model:GetAttribute("Uid"))
			end
		end
	end)

	RunService.Heartbeat:Connect(function()
		for thief, c in pairs(carrying) do
			local character = thief.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not root or not humanoid or humanoid.Health <= 0 or not c.Carry.Parent then
				self:Interrupt(thief, "Você caiu e o dragão voltou!")
			elseif os.clock() - c.Started > Config.StealTimeout then
				self:Interrupt(thief, "Demorou demais! O dragão voltou.")
			else
				local base = self.Services.BaseService:GetBaseOf(thief)
				if base and Layout.IsInsideBase(base.CFrame, root.Position) then
					self:Finish(thief)
				end
			end
		end
	end)
end

return StealService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="41">
