      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[-- Posições do mapa usadas pelo servidor e pelo cliente.
-- Mapa: esteira no meio (eixo X), 4 bases ao norte e 4 ao sul, praça no leste.

local Layout = {}

Layout.GroundY = 0 -- topo do chão
Layout.ConveyorStart = Vector3.new(-185, 1, 0)
Layout.ConveyorEnd = Vector3.new(185, 1, 0)
Layout.ConveyorWidth = 18

Layout.BaseSize = 64
Layout.BaseWallHeight = 15
Layout.EntranceWidth = 58 -- frente aberta (laser cobre a frente toda)

Layout.PlazaCenter = Vector3.new(225, 0, 0)

-- Centro de cada base e para onde a entrada aponta (sempre para a esteira).
local BASE_X = { -120, -40, 40, 120 }
local BASE_Z = 72

Layout.Bases = {}
for _, x in ipairs(BASE_X) do
	-- Norte: entrada virada para +Z
	table.insert(Layout.Bases, CFrame.new(x, 0, -BASE_Z))
	-- Sul: girada 180 graus, entrada virada para -Z
	table.insert(Layout.Bases, CFrame.new(x, 0, BASE_Z) * CFrame.Angles(0, math.pi, 0))
end

-- Bases de 2 andares: térreo + andar de cima (escada no meio, ao fundo)
Layout.UpperFloorY = 15 -- altura do piso do 2º andar (acima do piso do térreo)
Layout.StairsWidth = 8

-- Slots dentro da base (coordenadas locais; +Z = lado da entrada)
-- 10 no térreo (2 colunas x 5) + 10 no andar de cima
local COLUMNS = { -22, 22 }
local ROWS = { -22, -11, 0, 11, 22 }
Layout.Slots = {}
for _, floorY in ipairs({ 0, Layout.UpperFloorY }) do
	for _, z in ipairs(ROWS) do
		for _, x in ipairs(COLUMNS) do
			table.insert(Layout.Slots, Vector3.new(x, floorY, z))
		end
	end
end

Layout.LockButton = Vector3.new(0, 0, 24)
Layout.SpawnPoint = Vector3.new(0, 0, 12)

-- Verifica se uma posição do mundo está dentro de uma base.
function Layout.IsInsideBase(baseCFrame: CFrame, position: Vector3): boolean
	local localPos = baseCFrame:PointToObjectSpace(position)
	local half = Layout.BaseSize / 2
	return math.abs(localPos.X) <= half and math.abs(localPos.Z) <= half and localPos.Y < 40 and localPos.Y > -5
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[-- ===================================================================
--  ITENS DE ROBUX
--  Depois de publicar, crie cada Gamepass e Produto no Creator Hub
--  (create.roblox.com) e COLE O ID no campo "Id" abaixo.
--  Enquanto o Id for 0, no Studio a compra é simulada (de graça) para teste,
--  e no jogo publicado o item aparece como "Em breve".
--  O preço NÃO fica aqui: a loja busca o preço real no Roblox
--  (funciona com os Preços Gerenciados / preço regional).
-- ===================================================================

local Monetization = {}

-- Gamepasses: compra única, vale para sempre
Monetization.Passes = {
	{ Key = "VIP", Id = 2025206893, Name = "VIP",
		Description = "+50% de dinheiro, tag VIP no chat e renda offline de 3h." },
	{ Key = "DoubleCash", Id = 2026226924, Name = "Dinheiro x2",
		Description = "Todos os seus dragões rendem o dobro. Para sempre!" },
	{ Key = "AutoCollect", Id = 2027144899, Name = "Coleta Automática",
		Description = "O dinheiro vai direto pro seu bolso, sem precisar coletar." },
	{ Key = "ExtraSlots", Id = 2025638864, Name = "+4 Espaços",
		Description = "Mais 4 espaços para dragões na sua base." },
	{ Key = "Speed", Id = 2026532938, Name = "Velocidade Extra",
		Description = "Corra mais rápido para roubar e fugir." },
	{ Key = "Luck", Id = 2026766910, Name = "Sorte de Mutação",
		Description = "30% de chance do dragão comprado subir de mutação (Ouro, Diamante, Arco-Íris)." },
	{ Key = "TapaBuracoNegro", Id = 2025986953, Name = "Tapa Buraco Negro",
		Description = "Equipamento exclusivo que arremessa os ladrões longe." },
	{ Key = "Martelo", Id = 2026718897, Name = "Martelo do Banimento",
		Description = "Bata em alguém e mande ele de volta pra base dele!" },
}

-- Produtos: podem ser comprados várias vezes
Monetization.Products = {
	-- Dinheiro (valor cresce com o seu rebirth)
	{ Key = "Cash1", Id = 3717961484, Name = "Saco de Dinheiro", Category = "Dinheiro",
		Kind = "Cash", Amount = 25000, Description = "Dinheiro instantâneo." },
	{ Key = "Cash2", Id = 3717961738, Name = "Baú de Dinheiro", Category = "Dinheiro",
		Kind = "Cash", Amount = 150000, Description = "Muito dinheiro instantâneo." },
	{ Key = "Cash3", Id = 3717961919, Name = "Cofre de Dinheiro", Category = "Dinheiro",
		Kind = "Cash", Amount = 750000, Description = "Uma montanha de dinheiro." },

	-- Dragões
	{ Key = "DragonLendario", Id = 3717962074, Name = "Dragão Lendário", Category = "Dragões",
		Kind = "Dragon", Rarity = "Lendario", Description = "Ganhe um dragão Lendário aleatório na sua base." },
	{ Key = "DragonMitico", Id = 3717962264, Name = "Dragão Mítico", Category = "Dragões",
		Kind = "Dragon", Rarity = "Mitico", Description = "Ganhe um dragão Mítico aleatório na sua base." },

	-- Proteção
	{ Key = "Shield", Id = 3717962404, Name = "Escudo 10 min", Category = "Proteção",
		Kind = "Shield", Seconds = 600, Description = "Sua base fica trancada por 10 minutos." },

	-- Servidor (afeta todo mundo!)
	{ Key = "ServerLuck", Id = 3717962542, Name = "Sorte do Servidor", Category = "Servidor",
		Kind = "ServerLuck", Seconds = 900, Description = "Sorte x3 na esteira por 15 min para TODOS." },
	{ Key = "Meteor", Id = 3717962594, Name = "Chuva de Meteoros", Category = "Trollar",
		Kind = "Meteor", Description = "Meteoros caem no mapa derrubando todo mundo (menos você)!" },
	{ Key = "FreezeAll", Id = 3717962839, Name = "Congelar Todos", Category = "Trollar",
		Kind = "FreezeAll", Description = "Congela todos os outros jogadores por 8 segundos." },
	{ Key = "UnlockAll", Id = 3717962947, Name = "Abrir Todas as Bases", Category = "Trollar",
		Kind = "UnlockAll", Description = "Destranca TODAS as bases (menos a sua) por 30 segundos!" },
}

Monetization.PassByKey = {}
Monetization.PassById = {}
for _, p in ipairs(Monetization.Passes) do
	Monetization.PassByKey[p.Key] = p
	if p.Id ~= 0 then
		Monetization.PassById[p.Id] = p
	end
end

Monetization.ProductByKey = {}
Monetization.ProductById = {}
for _, p in ipairs(Monetization.Products) do
	Monetization.ProductByKey[p.Key] = p
	if p.Id ~= 0 then
		Monetization.ProductById[p.Id] = p
	end
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[-- Mutações: versões especiais dos dragões que rendem mais dinheiro.
-- Chance = probabilidade (0 a 1) ao nascer na esteira. EventOnly = só aparece em evento.

local Mutations = {}

Mutations.List = {
	{ Id = "Normal", Name = "", Multiplier = 1, Chance = 0 },
	{ Id = "Ouro", Name = "Ouro", Multiplier = 1.5, Chance = 0.07, Color = Color3.fromRGB(255, 200, 40) },
	{ Id = "Diamante", Name = "Diamante", Multiplier = 2, Chance = 0.025, Color = Color3.fromRGB(120, 230, 255) },
	{ Id = "Lava", Name = "Lava", Multiplier = 3, Chance = 0, EventOnly = true, Color = Color3.fromRGB(255, 90, 20) },
	{ Id = "ArcoIris", Name = "Arco-Íris", Multiplier = 5, Chance = 0.005, Color = Color3.fromRGB(255, 120, 220) },
}

Mutations.ById = {}
for index, mutation in ipairs(Mutations.List) do
	mutation.Order = index
	Mutations.ById[mutation.Id] = mutation
end

function Mutations.Get(id: string?)
	return Mutations.ById[id or "Normal"] or Mutations.ById.Normal
end

-- Ordem de "subida" usada pelo passe de Sorte (Normal -> Ouro -> Diamante -> Arco-Íris)
Mutations.UpgradeChain = { Normal = "Ouro", Ouro = "Diamante", Diamante = "ArcoIris", Lava = "ArcoIris" }

-- Sorteia uma mutação. boosts = { Ouro = 5, Lava = 1 ... } multiplica/ativa chances.
function Mutations.Roll(boostsArg: { [string]: number }?, rngArg: Random?): string
	local rng = rngArg or Random.new()
	local boosts = boostsArg or {}
	local roll = rng:NextNumber()
	local acc = 0
	-- das mais raras para as mais comuns
	for i = #Mutations.List, 2, -1 do
		local m = Mutations.List[i]
		local chance = m.Chance
		local boost = boosts[m.Id]
		if m.EventOnly then
			chance = boost and 0.15 or 0
		elseif boost then
			chance *= boost
		end
		acc += chance
		if roll < acc then
			return m.Id
		end
	end
	return "Normal"
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[-- Raridades dos dragões, em ordem da mais comum para a mais rara.
-- Weight = chance relativa de aparecer na esteira.

local Rarities = {}

Rarities.List = {
	{ Id = "Comum", Name = "Comum", Color = Color3.fromRGB(200, 200, 200), Weight = 55, Scale = 1.0 },
	{ Id = "Incomum", Name = "Incomum", Color = Color3.fromRGB(90, 220, 90), Weight = 25, Scale = 1.08 },
	{ Id = "Raro", Name = "Raro", Color = Color3.fromRGB(70, 150, 255), Weight = 12, Scale = 1.16 },
	{ Id = "Epico", Name = "Épico", Color = Color3.fromRGB(180, 80, 255), Weight = 5.5, Scale = 1.25 },
	{ Id = "Lendario", Name = "Lendário", Color = Color3.fromRGB(255, 190, 40), Weight = 2, Scale = 1.35 },
	{ Id = "Mitico", Name = "Mítico", Color = Color3.fromRGB(255, 70, 90), Weight = 0.4, Scale = 1.45 },
	{ Id = "Divino", Name = "Divino", Color = Color3.fromRGB(255, 255, 140), Weight = 0.08, Scale = 1.55 },
	{ Id = "Secreto", Name = "Secreto", Color = Color3.fromRGB(20, 20, 20), Weight = 0.02, Scale = 1.65 },
}

Rarities.ById = {}
for index, rarity in ipairs(Rarities.List) do
	rarity.Order = index
	Rarities.ById[rarity.Id] = rarity
end

function Rarities.Get(id: string)
